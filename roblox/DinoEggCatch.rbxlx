      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">AntiCheat</string>
          <string name="Source"><![CDATA[-- Защита от читов. Сервер не верит игроку на слово:
--  * check: игрок не может двигаться быстрее, чем ему разрешено (телепорт, ускорение, побег из клетки);
--  * allow: не больше N запросов в секунду (спам кнопками из чит-скрипта).
local AntiCheat = {}

AntiCheat.WINDOW = 0.5 -- секунд: точку отсчёта обновляем не чаще, чтобы мелкие шаги не складывались в телепорт
AntiCheat.SLACK = 4 -- запас в шагах (studs) на рывки сети

-- anchor = { pos, t } — последняя честная точка. Вернёт false, если игрок ушёл слишком далеко.
function AntiCheat.check(anchor, pos: Vector3, now: number, maxSpeed: number, slack: number?): boolean
	if not anchor.pos or (anchor.graceUntil and now < anchor.graceUntil) then
		anchor.pos, anchor.t = pos, now
		return true
	end
	local d = Vector3.new(pos.X - anchor.pos.X, 0, pos.Z - anchor.pos.Z).Magnitude
	if d > maxSpeed * (now - anchor.t) + (slack or AntiCheat.SLACK) then
		anchor.t = now -- вернём игрока в anchor.pos и начнём отсчёт заново
		return false
	end
	if now - anchor.t >= AntiCheat.WINDOW then
		anchor.pos, anchor.t = pos, now
	end
	return true
end

-- сервер сам переносит игрока: секунду верим любой точке (пока новая позиция доходит до игрока и обратно)
function AntiCheat.trust(anchor, now: number)
	anchor.pos = nil
	anchor.graceUntil = now + 1
end

-- ведро с жетонами: perSecond жетонов в секунду, не больше burst сразу
function AntiCheat.allow(bucket, now: number, perSecond: number, burst: number): boolean
	local tokens = bucket.tokens or burst
	tokens = math.min(burst, tokens + (now - (bucket.t or now)) * perSecond)
	bucket.t = now
	if tokens < 1 then
		bucket.tokens = tokens
		return false
	end
	bucket.tokens = tokens - 1
	return true
end

return AntiCheat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">Arena</string>
          <string name="Source"><![CDATA[-- Строит поле на каждый тайм: 4 карты, круги из камней, гнёзда, флажки, динозавры, яйца, кусты и украшения.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("DinoShared"):WaitForChild("Config"))
local Models = require(script.Parent.Models)
local Graphics = require(script.Parent.Graphics)

local Arena = {}

local R, ZONE, G = Config.CIRCLE_RADIUS, Config.ZONE_RADIUS, Config.GROUND_Y
local FX, FZ = Config.FIELD_X, Config.FIELD_Z

local THEMES = {
	field = {
		floor = Color3.fromRGB(106, 190, 70), material = Enum.Material.Grass,
		straw = Color3.fromRGB(225, 200, 130), stone = Color3.fromRGB(235, 232, 220), bush = Color3.fromRGB(55, 140, 45),
		fence = Color3.fromRGB(250, 248, 240), flags = { Color3.fromRGB(255, 95, 95), Color3.fromRGB(80, 170, 255), Color3.fromRGB(255, 210, 60) },
	},
	jungle = {
		floor = Color3.fromRGB(70, 140, 50), material = Enum.Material.LeafyGrass,
		straw = Color3.fromRGB(150, 120, 70), stone = Color3.fromRGB(150, 160, 130), bush = Color3.fromRGB(40, 115, 40),
		fence = Color3.fromRGB(120, 85, 50), flags = { Color3.fromRGB(255, 170, 40), Color3.fromRGB(240, 70, 120), Color3.fromRGB(80, 220, 160) },
	},
	volcano = {
		floor = Color3.fromRGB(70, 60, 58), material = Enum.Material.Basalt,
		straw = Color3.fromRGB(110, 80, 60), stone = Color3.fromRGB(60, 55, 55), bush = Color3.fromRGB(95, 110, 50),
		fence = Color3.fromRGB(60, 50, 45), flags = { Color3.fromRGB(255, 120, 40), Color3.fromRGB(255, 200, 60), Color3.fromRGB(230, 60, 40) },
	},
	ice = {
		floor = Color3.fromRGB(170, 215, 245), material = Enum.Material.Ice,
		straw = Color3.fromRGB(235, 245, 255), stone = Color3.fromRGB(80, 140, 210), bush = Color3.fromRGB(220, 238, 250),
		fence = Color3.fromRGB(170, 210, 240), flags = { Color3.fromRGB(80, 170, 255), Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 120, 255) },
	},
}

function Arena.circleCenters(): { Vector3 }
	local list = {}
	for i = 1, 10 do
		local col = (i - 1) % 5
		local row = (i - 1) // 5
		table.insert(list, Vector3.new(-128 + col * 64 + (row == 0 and -8 or 8), G, row == 0 and -40 or 40))
	end
	return list
end
local CENTERS = Arena.circleCenters()

-- случайное место на поле, где нет кругов и спавна
function Arena.freePos(margin: number?): Vector3
	margin = margin or 3
	for _ = 1, 60 do
		local p = Vector3.new(math.random(-FX / 2 + 8, FX / 2 - 8), G, math.random(-FZ / 2 + 8, FZ / 2 - 8))
		local ok = p.Magnitude > 22
		for _, c in ipairs(CENTERS) do
			if (p - c).Magnitude < ZONE + (margin :: number) then
				ok = false
				break
			end
		end
		if ok then
			return p
		end
	end
	return Vector3.new(math.random(-120, 120), G, 75)
end

-- деревянный забор вокруг поля и невидимая высокая стена, чтобы никто не убежал
local function buildFence(folder: Instance, color: Color3)
	local function side(from: Vector3, to: Vector3)
		local len = (to - from).Magnitude
		local dir = (to - from).Unit
		local cf = CFrame.lookAt((from + to) / 2, to)
		for _, y in ipairs({ 1.2, 2.6 }) do
			local rail = Models.part(folder, Vector3.new(0.4, 0.5, len), cf * CFrame.new(0, y, 0), color, Enum.Material.WoodPlanks)
			rail.CanCollide = true
		end
		local n = math.floor(len / 2.5)
		for i = 0, n do
			local p = from + dir * (i * len / n)
			local tall = i % 4 == 0
			local h = tall and 4 or 3.4
			local mid = p + Vector3.new(0, h / 2, 0)
			Models.part(folder, Vector3.new(tall and 0.8 or 0.6, h, tall and 0.8 or 0.35), CFrame.lookAt(mid, mid + dir), color, Enum.Material.WoodPlanks)
			if tall then
				Models.ball(folder, Vector3.new(0.8, 0.8, 0.8), CFrame.new(p + Vector3.new(0, 4.2, 0)), color)
			end
		end
		local wall = Models.part(folder, Vector3.new(1, 60, len), cf * CFrame.new(0, 30, 0), color)
		wall.Transparency = 1
		wall.CanCollide = true
	end
	local x, z = FX / 2, FZ / 2
	side(Vector3.new(-x, G, -z), Vector3.new(x, G, -z))
	side(Vector3.new(x, G, -z), Vector3.new(x, G, z))
	side(Vector3.new(x, G, z), Vector3.new(-x, G, z))
	side(Vector3.new(-x, G, z), Vector3.new(-x, G, -z))
end

-- ---------- поле на один тайм ----------

local current: Folder? = nil

function Arena.buildRound(themeId: string, event: string)
	local theme = THEMES[themeId] or THEMES.field
	local folder = Instance.new("Folder")
	folder.Name = "DinoArena"

	if not Graphics.hasTerrain then
		local floor = Models.part(folder, Vector3.new(FX, 1, FZ), CFrame.new(0, G - 0.5, 0), theme.floor, theme.material)
		floor.CanCollide = true
	end
	buildFence(folder, theme.fence)

	local circles = {}
	local rainbowCircle = math.random(1, 10)
	for i, center in ipairs(CENTERS) do
		local kind = Config.DINO_ORDER[(i - 1) % 4 + 1]
		local def = Config.DINOS[kind]

		-- соломенное гнездо внутри круга
		local straw = Models.cylinder(folder, 0.12, R * 2 - 1, CFrame.new(center + Vector3.new(0, 0.06, 0)), theme.straw, Enum.Material.Sand)
		straw.Name = "Circle"
		for t = 1, 28 do
			local a = t / 28 * math.pi * 2
			local r = R * 0.6 + (t % 3 - 1) * 0.9
			Models.part(folder, Vector3.new(0.25, 0.25, 2.6), CFrame.new(center + Vector3.new(math.cos(a) * r, 0.3 + (t % 2) * 0.15, math.sin(a) * r)) * CFrame.Angles(0, -a + math.rad(math.random(60, 120)), math.rad(math.random(-15, 15))), theme.straw:Lerp(Color3.fromRGB(120, 80, 40), 0.35 + (t % 3) * 0.1), Enum.Material.Wood)
		end

		-- круг из камушков (может «сломаться»)
		local ring = {}
		local N = 24
		for s = 0, N - 1 do
			local a = s / N * math.pi * 2
			local pos = center + Vector3.new(math.cos(a) * R, 0.45, math.sin(a) * R)
			local tangent = Vector3.new(-math.sin(a), 0, math.cos(a))
			table.insert(ring, Models.ball(folder, Vector3.new(2.4, 1.1, 3.3), CFrame.lookAt(pos, pos + tangent), theme.stone, Enum.Material.Slate))
		end
		-- флажки на границе, за которую надо убежать
		for s = 0, 11 do
			local a = s / 12 * math.pi * 2
			Models.flag(folder, center + Vector3.new(math.cos(a) * ZONE, 0, math.sin(a) * ZONE), theme.flags[s % 3 + 1])
		end

		local circle = {
			index = i,
			center = center,
			kind = kind,
			def = def,
			ring = ring,
			ringColor = theme.stone,
			eggs = {},
			occupant = nil,
			crackUntil = 0,
			cracked = false,
			dinoPos = center,
			dinoFace = Vector3.new(0, 0, -1),
			dashUntil = 0,
			nextDash = 0,
			chasing = false,
			camo = false,
		}

		for e = 0, 4 do
			local a = -math.pi / 2 + e * (math.pi * 2 / 5)
			local home = CFrame.new(center + Vector3.new(math.cos(a) * R * 0.6, 1.1, math.sin(a) * R * 0.6))
			local eggKind = kind == "gold" and "gold" or "normal"
			if i == rainbowCircle and e == 0 then
				eggKind = "rainbow"
			end
			table.insert(circle.eggs, {
				part = Models.egg(eggKind, home, folder, event),
				home = home,
				kind = eggKind,
				baseKind = kind == "gold" and "gold" or "normal",
				taken = false,
				respawnAt = 0,
				circle = circle,
			})
		end

		local hat = (event == "halloween" and "hat_pumpkin") or (event == "newyear" and "hat_santa") or nil
		local model, colorParts, height = Models.dino(def.color, def.dark, 1, {
			name = def.name .. " динозавр",
			label = def.name,
			hat = hat,
			trail = kind == "rainbow",
		})
		model:PivotTo(CFrame.new(center + Vector3.new(0, height, 0)))
		model.Parent = folder
		circle.dino = model
		circle.root = model.PrimaryPart
		circle.colorParts = colorParts
		circle.bubble = Models.bubble(colorParts[2], 5)
		circle.nextChat = os.clock() + math.random(2, 12)
		circle.chatUntil = 0
		circle.height = height
		circle.allParts = {}
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d.Name ~= "Eyelid" then
				table.insert(circle.allParts, d)
			end
		end

		-- куст, где можно спрятаться, между кругом и границей
		local a = math.random() * math.pi * 2
		circle.bushPos = center + Vector3.new(math.cos(a) * (R + ZONE) / 2, 0, math.sin(a) * (R + ZONE) / 2)
		table.insert(circles, circle)
	end

	local bushes = {}
	for _, c in ipairs(circles) do
		Models.bush(folder, c.bushPos, theme.bush)
		table.insert(bushes, c.bushPos)
	end

	-- украшения своей карты
	local lava = {}
	if themeId == "field" then
		for _ = 1, 45 do
			Models.flower(folder, Arena.freePos(1))
		end
		for _ = 1, 7 do
			Models.tree(folder, Arena.freePos(6), false)
		end
		for _ = 1, 6 do
			Models.rock(folder, Arena.freePos(3), math.random(2, 4))
		end
		for _ = 1, 3 do
			Models.log(folder, Arena.freePos(4))
		end
		for _ = 1, 10 do
			Models.mushroom(folder, Arena.freePos(1))
		end
	elseif themeId == "jungle" then
		for _ = 1, 14 do
			Models.tree(folder, Arena.freePos(6), true)
		end
		for _ = 1, 6 do
			Models.tree(folder, Arena.freePos(6), false)
		end
		for _ = 1, 20 do
			Models.fern(folder, Arena.freePos(2))
		end
		for _ = 1, 6 do
			local p = Arena.freePos(4)
			Models.bush(folder, p, theme.bush)
			table.insert(bushes, p)
		end
		for _ = 1, 4 do
			Models.log(folder, Arena.freePos(4))
		end
	elseif themeId == "volcano" then
		for _ = 1, 6 do
			local p = Arena.freePos(6)
			Models.lava(folder, p, 4)
			Graphics.lavaPatch(p, 7)
			table.insert(lava, { pos = p, radius = 4 })
		end
		for _ = 1, 12 do
			Models.rock(folder, Arena.freePos(3), math.random(2, 5))
		end
		for _ = 1, 5 do
			local vent = Models.part(folder, Vector3.new(1, 1, 1), CFrame.new(Arena.freePos(3)), Color3.new(0, 0, 0))
			vent.Transparency = 1
			local smoke = Instance.new("Smoke")
			smoke.Size = 3
			smoke.RiseVelocity = 6
			smoke.Opacity = 0.15
			smoke.Parent = vent
		end
	elseif themeId == "ice" then
		for _ = 1, 8 do
			Models.snowman(folder, Arena.freePos(4))
		end
		for _ = 1, 10 do
			Models.pine(folder, Arena.freePos(6), true)
		end
		for _ = 1, 8 do
			Models.crystal(folder, Arena.freePos(3))
		end
	end

	if event == "halloween" then
		for _ = 1, 12 do
			Models.pumpkin(folder, Arena.freePos(3))
		end
	elseif event == "newyear" then
		for _ = 1, 4 do
			Models.snowman(folder, Arena.freePos(4))
		end
		for _ = 1, 4 do
			Models.pine(folder, Arena.freePos(6), true)
		end
	end

	-- новое поле ставим раньше, чем убираем старое, чтобы никто не провалился
	folder.Parent = Workspace
	if current then
		current:Destroy()
	end
	current = folder

	return { folder = folder, circles = circles, bushes = bushes, lava = lava, theme = themeId, event = event }
end

-- заменить яйцо на яйцо другого вида (например, иногда появляется радужное)
function Arena.remakeEgg(egg, kind: string, event: string, folder: Instance)
	egg.part:Destroy()
	egg.kind = kind
	egg.part = Models.egg(kind, egg.home, folder, event)
end

return Arena
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[-- Сохранение монеток, питомцев, костюмов и значков через ProfileStore.
-- ProfileStore «запирает» данные игрока на одном сервере: если игрок быстро
-- перейдёт на другой сервер, старый сервер не затрёт новый прогресс.
-- В Studio сохранение работает, только если включено
-- Game Settings → Security → Enable Studio Access to API Services.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")

local ProfileStore = require(ServerScriptService:WaitForChild("ServerPackages"):WaitForChild("ProfileStore"))

local Data = {}

local function defaults()
	return {
		coins = 0,
		eggs = { normal = 0, gold = 0, rainbow = 0 },
		pets = {}, -- { {id = 1, kind = "green"}, ... }
		nextPetId = 1,
		equippedPet = 0,
		owned = {},
		equipped = { hat = "", back = "", trail = "" },
		badges = {},
		dailyLast = 0,
		dailyStreak = 0,
		wheelLast = 0,
		codes = {},
		escapes = 0,
		cups = 0,
		migrated = false, -- старое сохранение (до ProfileStore) уже перенесено
	}
end

local Store = ProfileStore.New("DinoEggCatch_v2", defaults())

-- старое хранилище: только читаем, чтобы перенести прогресс
local legacy: DataStore? = nil
pcall(function()
	legacy = DataStoreService:GetDataStore("DinoEggCatch_v1")
end)

-- переносим старое сохранение поверх нового профиля (только поля, которые знает игра)
local function migrate(profileData, player: Player)
	if not legacy then
		return
	end
	local ok, saved = pcall(function()
		return (legacy :: DataStore):GetAsync("u" .. player.UserId)
	end)
	if not ok or type(saved) ~= "table" then
		return
	end
	for k, v in pairs(saved) do
		local d = profileData[k]
		if type(d) == "table" and type(v) == "table" and next(d) ~= nil then
			for k2, v2 in pairs(v) do
				d[k2] = v2
			end
		elseif d ~= nil and type(d) == type(v) then
			profileData[k] = v
		end
	end
end

local profiles: { [Player]: any } = {}
local releasing: { [any]: boolean } = {} -- профили, которые мы закрываем сами

local function key(player: Player): string
	return "u" .. player.UserId
end

-- Загружает профиль (ждёт). Вернёт nil, если игрок ушёл или данные не открылись.
function Data.load(player: Player)
	local profile = Store:StartSessionAsync(key(player), {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})
	if profile == nil then
		if player.Parent == Players then
			player:Kick("Не получилось загрузить прогресс. Зайди в игру ещё раз 🙏")
		end
		return nil
	end
	profile:AddUserId(player.UserId)
	profile:Reconcile()
	profile.OnSessionEnd:Connect(function()
		profiles[player] = nil
		if releasing[profile] then
			releasing[profile] = nil
			return
		end
		-- профиль забрал другой сервер: этот игрок здесь больше не может играть
		if player.Parent == Players then
			player:Kick("Ты зашёл в игру в другом месте")
		end
	end)
	if player.Parent ~= Players then
		profile:EndSession()
		return nil
	end
	if not profile.Data.migrated then
		migrate(profile.Data, player)
		profile.Data.migrated = true
	end
	profiles[player] = profile
	return profile.Data
end

function Data.get(player: Player)
	local profile = profiles[player]
	return profile and profile.Data
end

function Data.isSaving(_player: Player): boolean
	return ProfileStore.DataStoreState == "Access"
end

-- игрок вышел: сохраняем и отпускаем профиль для других серверов
function Data.release(player: Player)
	local profile = profiles[player]
	profiles[player] = nil
	if profile then
		releasing[profile] = true
		profile:EndSession()
	end
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">Graphics</string>
          <string name="Source"><![CDATA[-- Красота: свет, атмосфера, облака, ландшафт (холмы, горы, озёра, вулкан) и погода на каждой карте.
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("DinoShared"):WaitForChild("Config"))
local Net = require(script.Parent.Net)

local Graphics = {}

local terrain = Workspace:FindFirstChildOfClass("Terrain")
Graphics.hasTerrain = terrain ~= nil

local FX, FZ = Config.FIELD_X, Config.FIELD_Z

-- ---------- свет и эффекты ----------

local function effect(className: string, name: string): any
	local old = Lighting:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local e = Instance.new(className)
	e.Name = name
	e.Parent = Lighting
	return e
end

local atmosphere, bloom, color, rays, dof

function Graphics.setup()
	Lighting.GlobalShadows = true
	Lighting.Brightness = 2.6
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ShadowSoftness = 0.25
	Lighting.GeographicLatitude = 35

	atmosphere = effect("Atmosphere", "DinoAtmosphere")
	bloom = effect("BloomEffect", "DinoBloom")
	bloom.Intensity = 0.6
	bloom.Size = 26
	bloom.Threshold = 0.95
	color = effect("ColorCorrectionEffect", "DinoColor")
	rays = effect("SunRaysEffect", "DinoSunRays")
	rays.Intensity = 0.07
	rays.Spread = 0.8
	dof = effect("DepthOfFieldEffect", "DinoDepth")
	dof.FarIntensity = 0.12
	dof.FocusDistance = 80
	dof.InFocusRadius = 120
	dof.NearIntensity = 0

	if terrain then
		local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.7
		clouds.Parent = terrain
		terrain.WaterColor = Color3.fromRGB(40, 150, 200)
		terrain.WaterReflectance = 0.6
		terrain.WaterTransparency = 0.6
		terrain.WaterWaveSize = 0.2
		terrain.WaterWaveSpeed = 8
		terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(106, 190, 70))
		terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(70, 140, 50))
		terrain:SetMaterialColor(Enum.Material.Snow, Color3.fromRGB(240, 248, 255))
		terrain:SetMaterialColor(Enum.Material.Glacier, Color3.fromRGB(235, 245, 255))
		terrain:SetMaterialColor(Enum.Material.Ice, Color3.fromRGB(170, 215, 245))
		terrain:SetMaterialColor(Enum.Material.Basalt, Color3.fromRGB(70, 60, 58))
		terrain:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(235, 215, 160))
	end
end

-- ---------- мир вокруг: холмы, горы, озёра, вулкан ----------

local volcanoTop: BasePart? = nil

local function hill(center: Vector3, radius: number, material: Enum.Material)
	if terrain then
		terrain:FillBall(center, radius, material)
	end
end

function Graphics.buildWorld(folder: Instance)
	if not terrain then
		-- без ландшафта просто большая трава под всем миром
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = Vector3.new(1400, 2, 1400)
		p.CFrame = CFrame.new(0, -1, 0)
		p.Material = Enum.Material.Grass
		p.Color = Color3.fromRGB(106, 190, 70)
		p.Parent = folder
		return
	end
	local t = terrain :: Terrain
	t:Clear()
	-- земля
	t:FillBlock(CFrame.new(0, -6, 0), Vector3.new(1400, 12, 1400), Enum.Material.Grass)
	-- озеро у обби (туда падают с островков)
	local ox = -FX / 2 - 50
	t:FillBlock(CFrame.new(ox, -12, -10), Vector3.new(88, 24, FZ + 60), Enum.Material.Air)
	t:FillBlock(CFrame.new(ox, -17, -10), Vector3.new(88, 14, FZ + 60), Enum.Material.Water)
	t:FillBlock(CFrame.new(ox, -26, -10), Vector3.new(92, 4, FZ + 64), Enum.Material.Sand)
	-- красивое озеро на востоке
	t:FillBlock(CFrame.new(FX / 2 + 70, -6, 0), Vector3.new(90, 12, 130), Enum.Material.Air)
	t:FillBlock(CFrame.new(FX / 2 + 70, -9, 0), Vector3.new(90, 10, 130), Enum.Material.Water)
	t:FillBlock(CFrame.new(FX / 2 + 70, -15, 0), Vector3.new(94, 4, 134), Enum.Material.Sand)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		t:FillBall(Vector3.new(FX / 2 + 70 + math.cos(a) * 52, -3, math.sin(a) * 72), 9, Enum.Material.Sand)
	end

	-- холмы по кругу
	for i = 1, 26 do
		local a = i / 26 * math.pi * 2 + math.random() * 0.15
		local d = math.random(360, 430)
		local r = math.random(45, 80)
		hill(Vector3.new(math.cos(a) * d, -r * 0.55, math.sin(a) * d + 40), r, Enum.Material.Grass)
	end
	-- горы со снежными вершинами
	for i = 1, 16 do
		local a = i / 16 * math.pi * 2 + math.random() * 0.2
		local d = math.random(560, 640)
		local r = math.random(90, 140)
		local c = Vector3.new(math.cos(a) * d, -r * 0.3, math.sin(a) * d)
		hill(c, r, Enum.Material.Rock)
		hill(c + Vector3.new(0, r * 0.62, 0), r * 0.42, Enum.Material.Glacier) -- не Snow: снег на «Льду» заменяется
	end
	-- дымящийся вулкан вдали (на севере)
	local vz = -330
	for i = 0, 11 do
		t:FillCylinder(CFrame.new(0, i * 7 + 3.5, vz), 7, 95 - i * 7.2, i < 9 and Enum.Material.Rock or Enum.Material.Slate) -- не Basalt: это земля «Вулкана»
	end
	t:FillCylinder(CFrame.new(0, 84, vz), 4, 14, Enum.Material.CrackedLava)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		t:FillBlock(CFrame.new(math.cos(a) * 30, 50 - i, vz + math.sin(a) * 30) * CFrame.Angles(0, -a, 0), Vector3.new(6, 2, 50), Enum.Material.CrackedLava)
	end
	local top = Instance.new("Part")
	top.Anchored = true
	top.CanCollide = false
	top.Transparency = 1
	top.Size = Vector3.new(20, 1, 20)
	top.CFrame = CFrame.new(0, 88, vz)
	top.Parent = folder
	local smoke = Instance.new("Smoke")
	smoke.Size = 25
	smoke.RiseVelocity = 15
	smoke.Opacity = 0.15
	smoke.Color = Color3.fromRGB(90, 90, 90)
	smoke.Parent = top
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 40)
	light.Range = 60
	light.Brightness = 3
	light.Parent = top
	volcanoTop = top
end

-- ---------- вид каждой карты ----------

local LOOKS = {
	field = {
		ground = Enum.Material.Grass, floor = Enum.Material.Grass, weather = "pollen",
		clock = 14.5, ambient = Color3.fromRGB(130, 130, 140),
		atmo = { Density = 0.3, Offset = 0.25, Color = Color3.fromRGB(199, 226, 255), Decay = Color3.fromRGB(106, 112, 125), Glare = 0.3, Haze = 1.2 },
		tint = Color3.fromRGB(255, 252, 245), saturation = 0.2,
	},
	jungle = {
		ground = Enum.Material.LeafyGrass, floor = Enum.Material.LeafyGrass, weather = "leaves",
		clock = 13, ambient = Color3.fromRGB(110, 140, 110),
		atmo = { Density = 0.42, Offset = 0.2, Color = Color3.fromRGB(190, 225, 175), Decay = Color3.fromRGB(80, 110, 80), Glare = 0.2, Haze = 2.4 },
		tint = Color3.fromRGB(240, 255, 235), saturation = 0.25,
	},
	volcano = {
		ground = Enum.Material.Basalt, floor = Enum.Material.Basalt, weather = "ash",
		clock = 17.6, ambient = Color3.fromRGB(160, 100, 80),
		atmo = { Density = 0.45, Offset = 0.1, Color = Color3.fromRGB(255, 160, 120), Decay = Color3.fromRGB(110, 50, 35), Glare = 0.5, Haze = 2 },
		tint = Color3.fromRGB(255, 228, 212), saturation = 0.15,
	},
	ice = {
		ground = Enum.Material.Snow, floor = Enum.Material.Ice, weather = "snow",
		clock = 11, ambient = Color3.fromRGB(170, 190, 220),
		atmo = { Density = 0.35, Offset = 0.2, Color = Color3.fromRGB(225, 238, 255), Decay = Color3.fromRGB(150, 170, 200), Glare = 0.4, Haze = 1.6 },
		tint = Color3.fromRGB(240, 248, 255), saturation = 0.1,
	},
}

local currentGround = Enum.Material.Grass

function Graphics.applyTheme(themeId: string, event: string)
	local look = LOOKS[themeId] or LOOKS.field
	if terrain then
		local t = terrain :: Terrain
		if look.ground ~= currentGround then
			-- меняем траву на снег/пепел кусочками, чтобы не упереться в лимит Roblox
			for x = -720, 360, 360 do
				for z = -720, 360, 360 do
					local region = Region3.new(Vector3.new(x, -40, z), Vector3.new(x + 360, 140, z + 360)):ExpandToGrid(4)
					pcall(function()
						t:ReplaceMaterial(region, 4, currentGround, look.ground)
					end)
				end
			end
			currentGround = look.ground
		end
		-- пол поля: на льду — настоящий скользкий лёд
		t:FillBlock(CFrame.new(0, -2, 0), Vector3.new(FX, 4, FZ), look.floor)
	end

	Lighting.ClockTime = look.clock
	Lighting.OutdoorAmbient = look.ambient
	Lighting.Ambient = Color3.fromRGB(70, 70, 80)
	Lighting.FogEnd = 100000
	for k, v in pairs(look.atmo) do
		atmosphere[k] = v
	end
	color.TintColor = look.tint
	color.Saturation = look.saturation
	color.Contrast = 0.08
	color.Brightness = 0.02

	local weather = look.weather
	if event == "halloween" then
		Lighting.ClockTime = 18.3
		Lighting.OutdoorAmbient = Color3.fromRGB(150, 120, 170)
		atmosphere.Color = Color3.fromRGB(200, 170, 230)
		color.TintColor = Color3.fromRGB(235, 220, 255)
		weather = "fireflies"
	elseif event == "newyear" then
		weather = "snow"
	end
	if terrain then
		local clouds = (terrain :: Terrain):FindFirstChildOfClass("Clouds")
		if clouds then
			clouds.Color = event == "halloween" and Color3.fromRGB(200, 180, 220) or Color3.new(1, 1, 1)
			clouds.Cover = themeId == "volcano" and 0.7 or 0.55
		end
	end
	if volcanoTop then
		local smoke = volcanoTop:FindFirstChildOfClass("Smoke")
		if smoke then
			smoke.Opacity = themeId == "volcano" and 0.35 or 0.15
			smoke.Size = themeId == "volcano" and 40 or 25
		end
	end
	Net.set("Weather", weather)
end

-- светящиеся трещины лавы на поле (только на карте «Вулкан»)
function Graphics.lavaPatch(pos: Vector3, radius: number)
	if terrain then
		(terrain :: Terrain):FillCylinder(CFrame.new(pos.X, -1, pos.Z), 2, radius, Enum.Material.CrackedLava)
	end
end

return Graphics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[-- Комната ожидания «Динопарк»: батуты, горка, бассейн с шариками, грибы-великаны,
-- банановые шкурки, подушки-пукалки, дискотека, говорящая статуя динозавра, гнездо и вход в обби.
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("DinoShared"):WaitForChild("Config"))
local Models = require(script.Parent.Models)
local Graphics = require(script.Parent.Graphics)

local Lobby = {}

local G = Config.GROUND_Y
local L = Vector3.new(0, G, 210) -- центр Динопарка (к югу от поля)
local LX, LZ = 130, 100

local BRIGHT = {
	Color3.fromRGB(255, 95, 95),
	Color3.fromRGB(255, 190, 60),
	Color3.fromRGB(255, 240, 90),
	Color3.fromRGB(110, 210, 90),
	Color3.fromRGB(80, 170, 255),
	Color3.fromRGB(190, 120, 255),
	Color3.fromRGB(255, 130, 200),
}
local function bright(i: number): Color3
	return BRIGHT[(i - 1) % #BRIGHT + 1]
end

local function at(x: number, y: number, z: number): Vector3
	return L + Vector3.new(x, y, z)
end

local function tag(inst: Instance, name: string)
	CollectionService:AddTag(inst, name)
end

local function solid(p: BasePart): BasePart
	p.CanCollide = true
	return p
end

function Lobby.build()
	local folder = Instance.new("Folder")
	folder.Name = "DinoPark"

	-- пол и забор
	if not Graphics.hasTerrain then
		solid(Models.part(folder, Vector3.new(LX, 1, LZ), CFrame.new(at(0, -0.5, 0)), Color3.fromRGB(125, 205, 95), Enum.Material.Grass))
	end
	-- дорожки из плитки
	for i = -6, 6 do
		Models.part(folder, Vector3.new(4.4, 0.15, 3.6), CFrame.new(at(0, 0.07, i * 4 + 6)), i % 2 == 0 and Color3.fromRGB(240, 225, 200) or Color3.fromRGB(225, 205, 175), Enum.Material.Pavement)
	end
	for i = -14, 14 do
		Models.part(folder, Vector3.new(3.6, 0.15, 4.4), CFrame.new(at(i * 4, 0.07, 6)), i % 2 == 0 and Color3.fromRGB(240, 225, 200) or Color3.fromRGB(225, 205, 175), Enum.Material.Pavement)
	end
	-- фонари, скамейки, сладкая вата, деревья, клумбы
	for _, p in ipairs({ { -8, -10 }, { 8, -10 }, { -8, 22 }, { 8, 22 }, { -30, 10 }, { 30, 10 }, { -55, 10 }, { 55, 10 } }) do
		Models.lamp(folder, at(p[1], 0, p[2]))
	end
	for _, b in ipairs({ { -20, 10, 0 }, { 20, 10, 180 }, { -4, -40, 0 }, { 30, 40, 90 } }) do
		Models.bench(folder, CFrame.new(at(b[1], 0, b[2] - 3)) * CFrame.Angles(0, math.rad(b[3]), 0))
	end
	Models.candyCart(folder, CFrame.new(at(-6, 0, 40)) * CFrame.Angles(0, math.rad(200), 0))
	for _, p in ipairs({ { -58, -42 }, { 58, -42 }, { -58, 40 }, { 58, 40 }, { -30, -44 }, { 22, 44 }, { 60, -10 } }) do
		Models.tree(folder, at(p[1], 0, p[2]), false)
	end
	for _ = 1, 40 do
		local x, z = math.random(-60, 60), math.random(-45, 45)
		if math.abs(x) > 8 and math.abs(z - 6) > 4 then
			Models.flower(folder, at(x, 0, z))
		end
	end
	for i = 1, 14 do
		local spot = Models.cylinder(folder, 0.1, math.random(6, 12), CFrame.new(at(math.random(-55, 55), 0.06, math.random(-40, 40))), bright(i))
		spot.Transparency = 0.55
	end
	local sides = {
		{ Vector3.new(LX, 80, 2), at(0, 40, LZ / 2) },
		{ Vector3.new(LX, 80, 2), at(0, 40, -LZ / 2) },
		{ Vector3.new(2, 80, LZ), at(LX / 2, 40, 0) },
		{ Vector3.new(2, 80, LZ), at(-LX / 2, 40, 0) },
	}
	for _, w in ipairs(sides) do
		local wall = solid(Models.part(folder, w[1], CFrame.new(w[2]), Color3.new(1, 1, 1)))
		wall.Transparency = 1
	end
	local n = 0
	for x = -LX / 2, LX / 2 - 5, 5 do
		for _, z in ipairs({ -LZ / 2, LZ / 2 }) do
			n += 1
			Models.part(folder, Vector3.new(4.6, 3, 0.6), CFrame.new(at(x + 2.5, 1.5, z)), bright(n))
		end
	end
	for z = -LZ / 2, LZ / 2 - 5, 5 do
		for _, x in ipairs({ -LX / 2, LX / 2 }) do
			n += 1
			Models.part(folder, Vector3.new(0.6, 3, 4.6), CFrame.new(at(x, 1.5, z + 2.5)), bright(n))
		end
	end
	-- воздушные шарики по углам
	for i, c in ipairs({ { -60, -45 }, { 60, -45 }, { -60, 45 }, { 60, 45 } }) do
		for k = 0, 2 do
			local top = at(c[1] + k * 1.5 - 1.5, 14 + k, c[2])
			Models.part(folder, Vector3.new(0.1, 11 + k, 0.1), CFrame.new(top - Vector3.new(0, (11 + k) / 2, 0)), Color3.new(1, 1, 1))
			Models.ball(folder, Vector3.new(3, 3.6, 3), CFrame.new(top + Vector3.new(0, 1.8, 0)), bright(i * 3 + k), Enum.Material.SmoothPlastic)
		end
	end

	-- спавн
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(at(0, 0, 30))
	spawn.Color = Color3.fromRGB(47, 111, 216)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Duration = 0
	spawn.Parent = folder

	-- табло
	local board = solid(Models.part(folder, Vector3.new(44, 14, 1), CFrame.new(at(0, 9, -48)), Color3.fromRGB(31, 42, 23)))
	for _, x in ipairs({ -20, 20 }) do
		solid(Models.part(folder, Vector3.new(1.5, 9, 1.5), CFrame.new(at(x, 1, -48)), Color3.fromRGB(110, 75, 45), Enum.Material.Wood))
	end
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.CanvasSize = Vector2.new(880, 280)
	sg.Parent = board
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.55)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 220, 90)
	title.Text = "🦖 ДИНОПАРК 🦖"
	title.Parent = sg
	local boardStatus = Instance.new("TextLabel")
	boardStatus.Position = UDim2.fromScale(0.05, 0.55)
	boardStatus.Size = UDim2.fromScale(0.9, 0.38)
	boardStatus.BackgroundTransparency = 1
	boardStatus.Font = Enum.Font.FredokaOne
	boardStatus.TextScaled = true
	boardStatus.TextColor3 = Color3.new(1, 1, 1)
	boardStatus.Text = "Ждём игроков"
	boardStatus.Parent = sg

	-- портал в игру
	local gamePortalPos = at(0, 0, 44)
	local portal = Models.cylinder(folder, 0.4, 8, CFrame.new(gamePortalPos + Vector3.new(0, 0.2, 0)), Color3.fromRGB(80, 220, 90), Enum.Material.Neon)
	Models.label(portal, "▶ В ИГРУ", 4, Color3.fromRGB(170, 255, 170), 80)

	-- вход в обби
	local padPos = at(-22, 0, -30)
	local pad = Models.cylinder(folder, 0.4, 6, CFrame.new(padPos + Vector3.new(0, 0.2, 0)), Color3.fromRGB(150, 90, 230), Enum.Material.Neon)
	Models.label(pad, "🏃 ОББИ", 4, Color3.fromRGB(220, 190, 255), 80)

	-- гнездо
	local nestPos = at(24, 0, -12)
	local _, nestPrompt = Models.nest(folder, nestPos)

	-- дискотека
	local disco = {}
	for i = 0, 5 do
		for j = 0, 5 do
			local tile = Models.part(folder, Vector3.new(3.8, 0.2, 3.8), CFrame.new(at(-10 + i * 4, 0.1, -32 + j * 4)), bright(i + j + 1), Enum.Material.Neon)
			table.insert(disco, tile)
		end
	end
	local discoSign = Models.part(folder, Vector3.new(1, 1, 1), CFrame.new(at(0, 0.5, -21)), Color3.new(1, 1, 1))
	discoSign.Transparency = 1
	Models.label(discoSign, "💃 Дискотека", 5, Color3.fromRGB(255, 200, 255), 60)

	-- батуты
	for i, z in ipairs({ -10, 6, 22 }) do
		local pos = at(-48, 0, z)
		Models.cylinder(folder, 0.8, 9, CFrame.new(pos + Vector3.new(0, 0.4, 0)), bright(i + 3))
		local mat = Models.cylinder(folder, 0.9, 7, CFrame.new(pos + Vector3.new(0, 0.45, 0)), Color3.fromRGB(40, 40, 50))
		tag(mat, "Trampoline")
		if i == 2 then
			Models.label(mat, "🤸 Батуты", 6, Color3.fromRGB(180, 230, 255), 60)
		end
	end

	-- банановые шкурки
	for _, p in ipairs({ { -12, -2 }, { 14, -4 }, { 28, 32 }, { -26, 14 } }) do
		local pos = at(p[1], 0.15, p[2])
		local peel = Models.ball(folder, Vector3.new(2, 0.3, 1.2), CFrame.new(pos), Color3.fromRGB(250, 220, 60))
		for k = -1, 1 do
			Models.ball(folder, Vector3.new(1.6, 0.25, 0.6), CFrame.new(pos + Vector3.new(1.1, 0, k * 0.6)) * CFrame.Angles(0, math.rad(k * 35), 0), Color3.fromRGB(240, 200, 50))
		end
		tag(peel, "Banana")
	end

	-- подушки-пукалки
	for _, p in ipairs({ { 6, 8 }, { -30, 32 } }) do
		local cushion = Models.ball(folder, Vector3.new(3.4, 0.9, 3.4), CFrame.new(at(p[1], 0.4, p[2])), Color3.fromRGB(255, 120, 190))
		Models.ball(folder, Vector3.new(0.8, 0.5, 0.8), CFrame.new(at(p[1] + 1.8, 0.4, p[2])), Color3.fromRGB(255, 120, 190))
		Models.label(cushion, "Не наступай! 😏", 3, Color3.fromRGB(255, 180, 220), 40)
		tag(cushion, "Fart")
	end

	-- грибы: красный делает великаном, синий — малышом
	for _, m in ipairs({ { -15, "big", Color3.fromRGB(230, 50, 50), "🍄 Великан" }, { 15, "small", Color3.fromRGB(70, 130, 240), "🍄 Малыш" } }) do
		local pos = at(m[1], 0, 22)
		local stem = solid(Models.cylinder(folder, 3.5, 2.4, CFrame.new(pos + Vector3.new(0, 1.75, 0)), Color3.fromRGB(250, 240, 220)))
		local cap = Models.ball(folder, Vector3.new(8, 4, 8), CFrame.new(pos + Vector3.new(0, 4.5, 0)), m[3])
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2
			Models.ball(folder, Vector3.new(1.2, 0.6, 1.2), CFrame.new(pos + Vector3.new(math.cos(a) * 2.6, 5.8, math.sin(a) * 2.6)), Color3.new(1, 1, 1))
		end
		stem:SetAttribute("Kind", m[2])
		tag(stem, "Mushroom")
		Models.label(cap, m[4], 4, m[3]:Lerp(Color3.new(1, 1, 1), 0.4), 60)
	end

	-- горка: башня с лестницей, длинный скат прямо в бассейн с шариками
	local towerPos = at(46, 0, -34)
	for _, o in ipairs({ { -3.5, -3.5 }, { 3.5, -3.5 }, { -3.5, 3.5 }, { 3.5, 3.5 } }) do
		solid(Models.part(folder, Vector3.new(1, 16, 1), CFrame.new(towerPos + Vector3.new(o[1], 8, o[2])), Color3.fromRGB(255, 190, 60)))
	end
	solid(Models.part(folder, Vector3.new(8, 1, 8), CFrame.new(towerPos + Vector3.new(0, 16, 0)), Color3.fromRGB(255, 95, 95)))
	local ladder = Instance.new("TrussPart")
	ladder.Anchored = true
	ladder.Size = Vector3.new(2, 16, 2)
	ladder.CFrame = CFrame.new(towerPos + Vector3.new(0, 8, -5))
	ladder.Color = Color3.fromRGB(80, 170, 255)
	ladder.Parent = folder
	local top = towerPos + Vector3.new(0, 16.5, 4)
	local bottom = at(46, 0.5, 6)
	local along = bottom - top
	local mid = (top + bottom) / 2
	local slideCF = CFrame.lookAt(mid, bottom)
	local slide = solid(Models.part(folder, Vector3.new(6, 1, along.Magnitude), slideCF, Color3.fromRGB(110, 210, 90)))
	slide.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 100, 1)
	slide:SetAttribute("Dir", along.Unit)
	tag(slide, "Slide")
	for _, x in ipairs({ -3.2, 3.2 }) do
		solid(Models.part(folder, Vector3.new(0.5, 1.6, along.Magnitude), slideCF * CFrame.new(x, 1, 0), Color3.fromRGB(255, 240, 90)))
	end
	Models.label(slide, "🛝 Горка", 8, Color3.fromRGB(200, 255, 180), 60)

	-- бассейн с шариками
	local pit = at(46, 0, 13)
	for _, w in ipairs({
		{ Vector3.new(18, 2.5, 1), Vector3.new(0, 1.25, -9) },
		{ Vector3.new(18, 2.5, 1), Vector3.new(0, 1.25, 9) },
		{ Vector3.new(1, 2.5, 18), Vector3.new(-9, 1.25, 0) },
		{ Vector3.new(1, 2.5, 18), Vector3.new(9, 1.25, 0) },
	}) do
		solid(Models.part(folder, w[1], CFrame.new(pit + w[2]), Color3.fromRGB(80, 170, 255)))
	end
	for i = 1, 90 do
		local b = Instance.new("Part")
		b.Shape = Enum.PartType.Ball
		b.Size = Vector3.new(1.8, 1.8, 1.8)
		b.Color = bright(i)
		b.Material = Enum.Material.SmoothPlastic
		b.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0.3, 0.5)
		b.CFrame = CFrame.new(pit + Vector3.new(math.random(-7, 7), 1 + (i % 5) * 1.8, math.random(-7, 7)))
		b.Parent = folder
	end

	-- статуя динозавра: если погладить, говорит смешное
	local statuePos = at(-40, 0, -36)
	local statue, colorParts, height = Models.dino(Color3.fromRGB(190, 150, 255), Color3.fromRGB(120, 80, 200), 1.6, {
		name = "Дино Добряк",
		label = "Дино Добряк",
	})
	local body = statuePos + Vector3.new(0, height, 0)
	statue:PivotTo(CFrame.lookAt(body, body + Vector3.new(0.4, 0, 1)))
	statue.Parent = folder
	local head = colorParts[2]
	local statueBubble = Models.bubble(head, 6)
	local statuePrompt = Instance.new("ProximityPrompt")
	statuePrompt.ActionText = "Погладить"
	statuePrompt.ObjectText = "Дино Добряк"
	statuePrompt.HoldDuration = 0
	statuePrompt.MaxActivationDistance = 16
	statuePrompt.RequiresLineOfSight = false
	statuePrompt.Parent = colorParts[1]

	-- обби (за западной стеной поля, над голубой «водой»)
	local FX, FZ = Config.FIELD_X, Config.FIELD_Z
	local ox = -FX / 2 - 45
	if not Graphics.hasTerrain then
		local water = Models.part(folder, Vector3.new(70, 1, FZ + 40), CFrame.new(ox, -12, 0), Color3.fromRGB(70, 180, 230), Enum.Material.Neon)
		water.Transparency = 0.3
	end
	local start = solid(Models.part(folder, Vector3.new(12, 1, 12), CFrame.new(ox, 2, -75), Color3.fromRGB(150, 90, 230)))
	Models.label(start, "Прыгай по островкам!", 6, Color3.fromRGB(220, 190, 255), 80)
	local last = Vector3.new(ox, 2, -75)
	for i = 1, 14 do
		local pos = Vector3.new(ox + ((i % 3) - 1) * 4, 2 + i * 1.2, -75 + i * 8)
		local size = i % 4 == 0 and Vector3.new(3.5, 1, 3.5) or Vector3.new(5, 1, 5)
		solid(Models.part(folder, size, CFrame.new(pos), Color3.fromHSV(i / 14, 0.6, 1)))
		last = pos
	end
	local finishPos = last + Vector3.new(0, 1, 10)
	local finish = solid(Models.part(folder, Vector3.new(12, 1, 12), CFrame.new(finishPos), Color3.fromRGB(242, 194, 48), Enum.Material.Foil))
	Models.label(finish, "🏁 ФИНИШ", 6, Color3.fromRGB(255, 230, 120), 120)

	folder.Parent = Workspace

	return {
		folder = folder,
		center = L,
		spawnCFrame = CFrame.new(at(0, 4, 30)),
		fieldCFrame = CFrame.new(0, G + 4, 0),
		gamePortalPos = gamePortalPos,
		padPos = padPos,
		nestPrompt = nestPrompt,
		boardStatus = boardStatus,
		disco = disco,
		statue = { model = statue, pos = statuePos, height = height, bubble = statueBubble },
		statuePrompt = statuePrompt,
		obbyStart = CFrame.new(ox, 6, -75),
		finishPos = finishPos,
	}
end

-- игрок в Динопарке?
function Lobby.contains(pos: Vector3): boolean
	return math.abs(pos.X - L.X) < LX / 2 and math.abs(pos.Z - L.Z) < LZ / 2
end

return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">Looks</string>
          <string name="Source"><![CDATA[-- Шапки, рюкзак, следы, питомцы и превращение игрока в динозавра.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("DinoShared"):WaitForChild("Config"))
local Models = require(script.Parent.Models)

local Looks = {}

local PET_COLORS = {
	green = { Config.DINOS.green.color, Config.DINOS.green.dark },
	red = { Config.DINOS.red.color, Config.DINOS.red.dark },
	gold = { Config.DINOS.gold.color, Config.DINOS.gold.dark },
	rainbow = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(90, 60, 160) },
}
local PET_SCALE = 0.32

local petFolder = Instance.new("Folder")
petFolder.Name = "DinoPets"
petFolder.Parent = Workspace

local pets: { [Player]: any } = {}

-- ---------- костюмы ----------

local function trailColors(id: string): (ColorSequence?, boolean)
	if id == "trail_fire" then
		return ColorSequence.new(Color3.fromRGB(255, 220, 60), Color3.fromRGB(230, 50, 20)), false
	elseif id == "trail_hearts" then
		return ColorSequence.new(Color3.fromRGB(255, 120, 190), Color3.fromRGB(255, 200, 230)), true
	elseif id == "trail_rainbow" then
		return Models.rainbowSequence(), false
	end
	return nil, false
end

function Looks.applyCosmetics(character: Model, equipped: any, petKind: string?)
	local old = character:FindFirstChild("DinoLooks")
	if old then
		old:Destroy()
	end
	local head = character:FindFirstChild("Head") :: BasePart?
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not (head and root) then
		return
	end
	-- точки следа живут на root, а не в DinoLooks — убираем старые, иначе они копятся
	for _, name in ipairs({ "TrailTop", "TrailBottom" }) do
		local a = root:FindFirstChild(name)
		while a do
			a:Destroy()
			a = root:FindFirstChild(name)
		end
	end
	local looks = Instance.new("Folder")
	looks.Name = "DinoLooks"

	if equipped.hat ~= "" then
		local hat = Instance.new("Model")
		hat.Name = "Hat"
		local top = head.CFrame * CFrame.new(0, head.Size.Y / 2 - 0.1, 0)
		local parts = Models.hat(equipped.hat, hat, top, 1)
		if #parts > 0 then
			for _, p in ipairs(parts) do
				p.Anchored = false
			end
			Models.weldTo(hat, head)
			hat.Parent = looks
		end
	end

	if equipped.back ~= "" then
		local torso = (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")) :: any
		if torso then
			local egg = Models.ball(nil, Vector3.new(1.8, 2.4, 1.2), torso.CFrame * CFrame.new(0, 0, torso.Size.Z / 2 + 0.6), Color3.fromRGB(251, 246, 230))
			for _, off in ipairs({ Vector3.new(-0.4, 0.4, 0.55), Vector3.new(0.35, -0.3, 0.55) }) do
				local spot = Models.ball(egg, Vector3.new(0.5, 0.5, 0.2), egg.CFrame * CFrame.new(off), Color3.fromRGB(150, 200, 120))
				spot.Anchored = false
			end
			local m = Instance.new("Model")
			egg.Parent = m
			Models.weldTo(m, torso)
			m.Parent = looks
		end
	end

	local trailId = equipped.trail
	if trailId == "" and petKind == "rainbow" then
		trailId = "trail_rainbow"
	end
	local colors, hearts = trailColors(trailId)
	if colors then
		local a0 = Instance.new("Attachment")
		a0.Name = "TrailTop"
		a0.Position = Vector3.new(0, 0.8, 0.4)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name = "TrailBottom"
		a1.Position = Vector3.new(0, -1.2, 0.4)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = colors
		trail.Lifetime = 0.7
		trail.LightEmission = 0.5
		trail.Transparency = NumberSequence.new(0.1, 1)
		trail.Parent = looks
		if hearts then
			local p = Instance.new("ParticleEmitter")
			p.Color = ColorSequence.new(Color3.fromRGB(255, 110, 180))
			p.Rate = 12
			p.Lifetime = NumberRange.new(0.8)
			p.Speed = NumberRange.new(1, 2)
			p.Size = NumberSequence.new(0.5, 0)
			p.Parent = a1
		end
	end
	looks.Parent = character
end

-- ---------- питомцы ----------

function Looks.setPet(player: Player, kind: string?)
	local old = pets[player]
	if old then
		old.model:Destroy()
		pets[player] = nil
	end
	if not kind or not Config.PETS[kind] then
		return
	end
	local c = PET_COLORS[kind]
	local def = Config.PETS[kind]
	local model, colorParts, height = Models.dino(c[1], c[2], PET_SCALE, {
		name = player.Name .. "_pet",
		label = def.name,
		labelColor = Config.RARITY_COLORS[def.rarity],
		trail = kind == "rainbow",
	})
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	if kind == "gold" then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromRGB(255, 230, 120)
		sp.Parent = model.PrimaryPart
	end
	model.Parent = petFolder
	pets[player] = { model = model, colorParts = colorParts, height = height, kind = kind, pos = nil, face = Vector3.new(0, 0, -1) }
end

function Looks.removePlayer(player: Player)
	Looks.setPet(player, nil)
end

function Looks.updatePets(dt: number, now: number)
	for player, pet in pairs(pets) do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local hip = hum and (hum.HipHeight + root.Size.Y / 2) or 3
			local feet = root.Position.Y - hip
			local target = (root.CFrame * CFrame.new(3, 0, 3)).Position
			target = Vector3.new(target.X, feet, target.Z)
			if not pet.pos or (pet.pos - target).Magnitude > 40 then
				pet.pos = target
			end
			local delta = target - pet.pos
			pet.pos += delta * math.min(1, dt * 6)
			local flatDelta = Vector3.new(delta.X, 0, delta.Z)
			local moving = flatDelta.Magnitude > 0.5
			if moving then
				pet.face = flatDelta.Unit
			end
			local hop = moving and math.abs(math.sin(now * 12)) * 0.8 or 0
			local body = pet.pos + Vector3.new(0, pet.height + hop, 0)
			Models.moveRig(pet.model, CFrame.lookAt(body, body + pet.face))
			if pet.kind == "rainbow" then
				local col = Color3.fromHSV((now * 0.3) % 1, 0.8, 1)
				for _, p in ipairs(pet.colorParts) do
					p.Color = col
				end
			end
		end
	end
end

-- ---------- игрок-динозавр ----------

function Looks.morphDino(character: Model, kind: string)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not (root and hum) then
		return
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			d.Transparency = 1
		elseif d:IsA("Decal") then
			d.Transparency = 1
		end
	end
	local old = character:FindFirstChild("DinoLooks")
	if old then
		old:Destroy()
	end
	local def = Config.DINOS[kind]
	local model, _, height = Models.dino(def.color, def.dark, 0.75, { name = "DinoMorph", trail = kind == "rainbow" })
	local feet = root.Position.Y - (hum.HipHeight + root.Size.Y / 2)
	local look = root.CFrame.LookVector
	local body = Vector3.new(root.Position.X, feet + height, root.Position.Z)
	model:PivotTo(CFrame.lookAt(body, body + Vector3.new(look.X, 0, look.Z)))
	Models.attachRig(model, root)
	model.Parent = character
end

-- ---------- показать язык ----------

function Looks.tongue(character: Model)
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head or head:FindFirstChild("Tongue") then
		return
	end
	local t = Models.part(nil, Vector3.new(0.5, 0.15, 0.8), head.CFrame * CFrame.new(0, -0.35, -head.Size.Z / 2 - 0.3), Color3.fromRGB(240, 90, 110))
	t.Name = "Tongue"
	t.Anchored = false
	t.Massless = true
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1, w.Parent = head, t, t
	t.Parent = head
	local label = Models.label(head, "😛", 3, Color3.new(1, 1, 1), 80)
	task.delay(2.5, function()
		t:Destroy()
		if label.Parent then
			(label.Parent :: Instance):Destroy()
		end
	end)
end

return Looks
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="64">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Dino Egg Catch — главный скрипт.

	Люди забегают в круг, хватают яйцо и убегают. Динозавры ловят.
	В круге может быть только один человек. Кто набрал больше — получает кубок.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("DinoShared"):WaitForChild("Config"))
local Net = require(script.Parent.Net)
local Data = require(script.Parent.Data)
local Models = require(script.Parent.Models)
local Arena = require(script.Parent.Arena)
local Looks = require(script.Parent.Looks)
local Progress = require(script.Parent.Progress)
local Lobby = require(script.Parent.Lobby)
local Graphics = require(script.Parent.Graphics)
local AntiCheat = require(script.Parent.AntiCheat)

local R, ZONE, G = Config.CIRCLE_RADIUS, Config.ZONE_RADIUS, Config.GROUND_Y
local FX, FZ = Config.FIELD_X, Config.FIELD_Z

local event = Config.currentEvent()
Progress.event = event
Net.set("Event", event)

local worldFolder = Instance.new("Folder")
worldFolder.Name = "DinoWorld"
worldFolder.Parent = workspace
Graphics.setup()
Graphics.buildWorld(worldFolder)
Graphics.applyTheme(Config.THEMES[1].id, event)

local setScale: (Player, number) -> ()
local lobby = Lobby.build()
local fxFolder = Instance.new("Folder")
fxFolder.Name = "DinoFX"
fxFolder.Parent = workspace
local arena = Arena.buildRound(Config.THEMES[1].id, event)
Net.set("Map", Config.THEMES[1].icon .. " " .. Config.THEMES[1].name)
Net.set("Theme", Config.THEMES[1].id)

local roundNo = 0
local roundActive = false
local roundEnd = 0
local humansScore, dinoScore = 0, 0
local status = "Ждём игроков"
local dinoPlayer: Player? = nil
local lastCaught: { [Player]: number } = {}
local boss: any = nil
local bossDone = false
local powerups = {}
local nextPowerup = 0

-- ---------- состояние каждого игрока ----------

local function newState()
	return {
		carry = nil,
		cagedUntil = 0,
		cage = nil,
		starUntil = 0,
		bananaUntil = 0,
		springUntil = 0,
		slowUntil = 0,
		dashUntil = 0,
		roarAt = 0,
		dashAt = 0,
		shieldUsed = false,
		hidden = false,
		caught = 0,
		isDino = false,
		dinoKind = "red",
		obbyAt = -1000,
		lavaAt = 0,
		bushToastAt = 0,
		portalToastAt = 0,
		fartAt = 0,
		mushroomAt = 0,
		scaleUntil = 0,
		track = {}, -- последняя честная точка (защита от телепорта)
		peakSpeed = Config.WALK_SPEED,
		peakUntil = 0,
		bucket = {}, -- сколько запросов можно прямо сейчас
		cheatToastAt = 0,
	}
end

local states: { [Player]: any } = {}
local function st(player: Player)
	local s = states[player]
	if not s then
		s = newState()
		states[player] = s
	end
	return s
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end
local function flatDist(a: Vector3, b: Vector3): number
	return (flat(a) - flat(b)).Magnitude
end

local function getRoot(player: Player): (BasePart?, Humanoid?)
	local char = player.Character
	if not char then
		return nil, nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or hum.Health <= 0 or not root then
		return nil, nil
	end
	return root :: BasePart, hum
end

local function onField(pos: Vector3): boolean
	return math.abs(pos.X) < FX / 2 and math.abs(pos.Z) < FZ / 2 and pos.Y < G + 15
end

local function teleport(player: Player, cf: CFrame)
	local char = player.Character
	if char then
		local s = states[player]
		if s then
			AntiCheat.trust(s.track, os.clock())
		end
		char:PivotTo(cf)
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end
end

local function moveOut(root: BasePart, from: Vector3, radius: number)
	local dir = flat(root.Position - from)
	if dir.Magnitude < 0.1 then
		dir = Vector3.new(1, 0, 0)
	end
	dir = dir.Unit
	local x = math.clamp(from.X + dir.X * radius, -FX / 2 + 4, FX / 2 - 4)
	local z = math.clamp(from.Z + dir.Z * radius, -FZ / 2 + 4, FZ / 2 - 4)
	local player = Players:GetPlayerFromCharacter(root.Parent)
	if player and states[player] then
		AntiCheat.trust(states[player].track, os.clock())
	end
	root.CFrame = CFrame.new(x, root.Position.Y, z) * root.CFrame.Rotation
	root.AssemblyLinearVelocity = Vector3.zero
end

-- игрок сейчас на поле (а не в Динопарке или на обби)?
local function playing(player: Player): boolean
	local root = getRoot(player)
	return root ~= nil and onField(root.Position)
end

local function updateScore()
	Net.set("Humans", humansScore)
	Net.set("Dinos", dinoScore)
end

-- ---------- внешний вид ----------

local function applyLooks(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end
	local pet = Progress.petKind(player)
	local char = player.Character
	if char and not st(player).isDino then
		Looks.applyCosmetics(char, profile.equipped, pet)
	end
	Looks.setPet(player, pet)
end
Progress.onLooksChanged = applyLooks

-- ---------- яйца ----------

local function dropEgg(player: Player)
	local s = states[player]
	if not s or not s.carry then
		return
	end
	local carry = s.carry
	carry.egg.taken = false
	Models.setVisible(carry.egg.part, true)
	carry.visual:Destroy()
	s.carry = nil
end

local function grabEgg(player: Player, root: BasePart, circle, egg)
	egg.taken = "carried"
	local m = Instance.new("Model")
	m.Name = "CarriedEgg"
	local visual = egg.part:Clone()
	visual.Parent = m
	m.PrimaryPart = visual
	Models.setVisible(egg.part, false)
	m:PivotTo(root.CFrame * CFrame.new(1.6, 0.4, -1))
	Models.weldTo(m, root)
	m.Parent = player.Character
	st(player).carry = { circle = circle, egg = egg, visual = m, closest = math.huge }
	Net.sound(player, "pickup")
	Net.toast(player, "🥚 Есть яйцо! Беги за белые точки!")
end

local EGG_COINS = { normal = 5, gold = 10, rainbow = 25 }

local function bankEgg(player: Player)
	local s = st(player)
	local carry = s.carry
	local egg = carry.egg
	egg.taken = "gone"
	egg.respawnAt = os.clock() + Config.EGG_RESPAWN
	carry.visual:Destroy()
	s.carry = nil

	humansScore += 1
	updateScore()
	local stats = player:FindFirstChild("leaderstats")
	local eggsStat = stats and stats:FindFirstChild("Яйца") :: IntValue?
	if eggsStat then
		eggsStat.Value += 1
	end

	local profile = Data.get(player)
	Progress.addEgg(player, egg.kind)
	local coins = Progress.addCoins(player, EGG_COINS[egg.kind] or 5, true)
	Net.sound(player, "coin")
	Net.toast(player, string.format("%s Яйцо твоё! +%d 🪙  (вылупи его в гнезде 🐣)", Config.EGGS[egg.kind].icon, coins))
	Progress.badge(player, "first_egg")
	if profile then
		profile.escapes += 1
		if profile.escapes >= 10 then
			Progress.badge(player, "escape10")
		end
	end
	if egg.kind == "rainbow" then
		Progress.badge(player, "rainbow_egg")
		Net.all("toast", "🌈 " .. player.DisplayName .. " унёс радужное яйцо!")
	end
	if carry.closest < 8 then
		local bonus = Progress.addCoins(player, 5, true)
		Net.toast(player, "😅 Еле убежал! +" .. bonus .. " 🪙")
		Progress.badge(player, "close_call")
	end
end

-- ---------- поймали / клетка / спасение ----------

local function releaseCage(player: Player)
	local s = states[player]
	if not s then
		return
	end
	s.cagedUntil = 0
	if s.cage then
		s.cage:Destroy()
		s.cage = nil
	end
end

-- from: откуда пришёл динозавр; outRadius — если задан, человека выкидывает из круга
local function catchPlayer(prey: Player, root: BasePart, from: Vector3, outRadius: number?, catcherName: string, catcher: Player?): boolean
	local s = st(prey)
	local now = os.clock()
	if s.starUntil > now or s.cagedUntil > now then
		return false
	end
	if Progress.petKind(prey) == "red" and not s.shieldUsed then
		s.shieldUsed = true
		moveOut(root, from, (outRadius or 10) + 4)
		Net.toast(prey, "🛡 Красный динозаврик тебя спас! (один раз за тайм)")
		Net.sound(prey, "swoosh")
		return false
	end

	dropEgg(prey)
	dinoScore += 1
	updateScore()
	s.caught += 1
	if outRadius then
		moveOut(root, from, outRadius)
	end
	s.cagedUntil = now + Config.CAGE_TIME
	s.cage = Models.cage(Vector3.new(root.Position.X, G, root.Position.Z), arena.folder)
	local head = prey.Character and prey.Character:FindFirstChild("Head") :: BasePart?
	if head then
		local stars = Models.label(head, "😵‍💫 ⭐ ⭐", 3, Color3.new(1, 1, 1), 80)
		local bb = stars.Parent :: BillboardGui
		bb.Parent = s.cage
		task.spawn(function()
			local t = 0
			while bb.Parent do
				t += 0.1
				bb.StudsOffset = Vector3.new(math.sin(t * 6) * 0.8, 3, math.cos(t * 6) * 0.8)
				task.wait(0.1)
			end
		end)
	end
	for _, c in ipairs(arena.circles) do
		if c.occupant == prey then
			c.occupant = nil
		end
	end

	Net.sound(prey, "caught")
	Net.send(prey, "voice", "Ой! Поймали!")
	Net.toast(prey, "😵‍💫 Ой! Голова кружится! Друг может спасти, или подожди " .. Config.CAGE_TIME .. " секунд")
	Net.all("toast", catcherName .. " поймал " .. prey.DisplayName .. "! +1 динозаврам")
	if catcher then
		local coins = Progress.addCoins(catcher, 5, true)
		Net.toast(catcher, "🦖 Поймал! +" .. coins .. " 🪙")
	end
	return true
end

-- может ли динозавр ловить этого игрока прямо сейчас
local function isPrey(player: Player, now: number, roots): boolean
	local s = states[player]
	local root = roots[player]
	return s ~= nil
		and root ~= nil
		and not s.isDino
		and s.cagedUntil <= now
		and s.starUntil <= now
		and not s.hidden
		and onField(root.Position)
end

-- ---------- скорость и прыжок ----------

local function applyMovement(player: Player, s, hum: Humanoid, now: number)
	local speed
	if s.cagedUntil > now then
		speed = 0
	elseif s.slowUntil > now then
		speed = 6
	else
		speed = s.isDino and 17 or Config.WALK_SPEED
		if not s.isDino then
			local pet = Progress.petKind(player)
			if pet == "green" then
				speed += 2
			elseif pet == "rainbow" then
				speed += 3
			end
		end
		if s.bananaUntil > now then
			speed += 10
		end
		if s.dashUntil > now then
			speed += 26
		end
		if s.carry then
			speed -= 1
		end
	end
	-- самая большая скорость за последнюю секунду: по ней сервер проверяет, не читер ли
	if speed >= s.peakSpeed then
		s.peakSpeed, s.peakUntil = speed, now + 1
	elseif now > s.peakUntil then
		s.peakSpeed = speed
	end
	if hum.WalkSpeed ~= speed then
		hum.WalkSpeed = speed
	end
	local jump = 7.2
	if s.cagedUntil > now then
		jump = 0
	elseif s.springUntil > now then
		jump = 22
	end
	if hum.JumpHeight ~= jump then
		hum.JumpHeight = jump
		hum.JumpPower = jump == 0 and 0 or (jump > 10 and 95 or 50)
	end
end

-- ---------- круг ломается ----------

local function crackCircle(c, player: Player)
	if not c.cracked then
		Net.toast(player, "💥 Круг сломан! Там уже есть человек")
		Net.sound(player, "crack")
	end
	c.crackUntil = os.clock() + 1
	c.cracked = true
	for i, seg in ipairs(c.ring) do
		seg.Color = Color3.fromRGB(216, 69, 47)
		seg.Transparency = (i % 2 == 0) and 1 or 0
	end
end

-- ---------- бонусы ----------

local POWER_KINDS = { "banana", "star", "spring" }

local function clearPowerups()
	for _, p in ipairs(powerups) do
		p.model:Destroy()
	end
	table.clear(powerups)
end

local function takePowerup(player: Player, s, p, now: number)
	local def = Config.POWERUPS[p.kind]
	if p.kind == "banana" then
		s.bananaUntil = now + def.time
	elseif p.kind == "star" then
		s.starUntil = now + def.time
		local char = player.Character
		if char then
			local ff = Instance.new("ForceField")
			ff.Parent = char
			task.delay(def.time, function()
				ff:Destroy()
			end)
		end
	elseif p.kind == "spring" then
		s.springUntil = now + def.time
	end
	Progress.addCoins(player, 1, true)
	Net.sound(player, p.kind == "spring" and "jump" or "pickup")
	Net.toast(player, def.icon .. " " .. def.text)
end

-- ---------- Ти-Рекс ----------

local function spawnBoss(now: number)
	local model, bossParts, height = Models.dino(Color3.fromRGB(120, 95, 70), Color3.fromRGB(70, 50, 35), 2.4, {
		name = "Ти-Рекс",
		label = "ТИ-РЕКС",
		labelColor = Color3.fromRGB(255, 90, 60),
		hat = (event == "halloween" and "hat_pumpkin") or (event == "newyear" and "hat_santa") or nil,
	})
	local pos = Vector3.new(0, G, -FZ / 2 + 12)
	model:PivotTo(CFrame.new(pos + Vector3.new(0, height, 0)))
	model:SetAttribute("Chasing", true)
	model.Parent = arena.folder
	boss = {
		model = model,
		height = height,
		pos = pos,
		face = Vector3.new(0, 0, 1),
		untilT = now + Config.BOSS_TIME,
		caughtAny = false,
		bubble = Models.bubble(bossParts[2], 9),
		nextChat = now + 1,
	}
	Net.big("🦖 ТИ-РЕКС! БЕГИ!", 3, "Ти-Рекс! Беги!")
	Net.all("shake", 1)
	Net.sound(nil, "roar")
	Net.set("Boss", true)
end

local function removeBoss(rewarded: boolean)
	if not boss then
		return
	end
	boss.model:Destroy()
	if rewarded and not boss.caughtAny then
		for _, player in ipairs(Players:GetPlayers()) do
			local s = states[player]
			if s and not s.isDino and playing(player) then
				Progress.addCoins(player, 10, true)
				Progress.badge(player, "boss")
			end
		end
		Net.big("Все убежали от Ти-Рекса! +10 🪙", 3)
	end
	boss = nil
	Net.set("Boss", false)
end

-- ---------- каждый кадр ----------

RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()

	-- анимации: радужные динозавры и яйца, сломанные круги, яйца возвращаются
	local hue = Color3.fromHSV((now * 0.25) % 1, 0.8, 1)
	for _, c in ipairs(arena.circles) do
		if c.kind == "rainbow" then
			for _, p in ipairs(c.colorParts) do
				p.Color = hue
			end
		end
		if c.cracked and now > c.crackUntil then
			c.cracked = false
			for _, seg in ipairs(c.ring) do
				seg.Color = c.ringColor
				seg.Transparency = 0
			end
		end
		for _, egg in ipairs(c.eggs) do
			if egg.taken == "gone" and now >= egg.respawnAt then
				if math.random() < 0.04 then
					Arena.remakeEgg(egg, "rainbow", event, arena.folder)
				elseif egg.kind ~= egg.baseKind then
					Arena.remakeEgg(egg, egg.baseKind, event, arena.folder)
				else
					Models.setVisible(egg.part, true)
				end
				egg.taken = false
			end
			if egg.kind == "rainbow" and not egg.taken then
				egg.part.Color = hue
			end
		end
	end
	for _, p in ipairs(powerups) do
		p.model:PivotTo(CFrame.new(p.pos + Vector3.new(0, math.sin(now * 3) * 0.4, 0)) * CFrame.Angles(0, now * 2, 0))
	end
	Looks.updatePets(dt, now)

	-- игроки: лобби, обби, лава, кусты, скорость
	local roots: { [Player]: BasePart } = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local s = states[player]
		local root, hum = getRoot(player)
		if s and root and hum then
			roots[player] = root
			local pos = root.Position

			-- телепорт, ускорение или побег из клетки: возвращаем на последнюю честную точку
			local caged = s.cagedUntil > now
			local park = Lobby.contains(pos) or pos.X < -FX / 2 - 10 -- горка и батуты разгоняют сильнее
			local limit = caged and 0 or (park and 70 or s.peakSpeed * 1.25)
			if not AntiCheat.check(s.track, pos, now, limit, caged and 1.5 or nil) then
				dropEgg(player)
				root.CFrame = CFrame.new(s.track.pos) * root.CFrame.Rotation
				root.AssemblyLinearVelocity = Vector3.zero
				pos = s.track.pos
				if now - s.cheatToastAt > 5 then
					s.cheatToastAt = now
					Net.toast(player, "🚫 Так быстро нельзя! Возвращаем назад")
				end
			end

			if pos.Y < -40 then
				dropEgg(player) -- иначе телепорт в центр поля засчитал бы яйцо как унесённое
				teleport(player, (roundActive and not Lobby.contains(pos)) and lobby.fieldCFrame or lobby.spawnCFrame)
			elseif pos.X < -FX / 2 - 10 and pos.Y < -3 then
				teleport(player, lobby.obbyStart) -- упал в воду на обби
			end
			if flatDist(pos, lobby.padPos) < 3 and pos.Y < G + 6 and s.cagedUntil <= now then
				dropEgg(player)
				teleport(player, lobby.obbyStart)
				Net.toast(player, "🏃 Прыгай по островкам до финиша!")
			end
			if flatDist(pos, lobby.finishPos) < 6 and math.abs(pos.Y - lobby.finishPos.Y) < 6 then
				if now - s.obbyAt > 120 then
					s.obbyAt = now
					local coins = Progress.addCoins(player, 15, true)
					Net.toast(player, "🏁 Обби пройдено! +" .. coins .. " 🪙")
					Net.sound(player, "win")
					Progress.badge(player, "obby")
				else
					Net.toast(player, "🏁 Молодец! Монетки за обби — раз в 2 минуты")
				end
				teleport(player, lobby.spawnCFrame)
			end
			if flatDist(pos, lobby.gamePortalPos) < 4 and pos.Y < G + 6 then
				if roundActive then
					teleport(player, lobby.fieldCFrame * CFrame.new(math.random(-20, 20), 0, 0))
					Net.toast(player, "▶ Беги за яйцами!")
				elseif now - s.portalToastAt > 4 then
					s.portalToastAt = now
					Net.toast(player, "▶ Портал откроется, когда начнётся игра")
				end
			end
			for _, l in ipairs(arena.lava) do
				if flatDist(pos, l.pos) < l.radius and pos.Y < G + 5 and now - s.lavaAt > 1 then
					s.lavaAt = now
					dropEgg(player)
					teleport(player, lobby.fieldCFrame)
					Net.toast(player, "🔥 Ой, горячо! Обходи лаву")
					Net.sound(player, "caught")
				end
			end

			local hidden = false
			if pos.Y < G + 8 then
				for _, b in ipairs(arena.bushes) do
					if flatDist(pos, b) < 4.5 then
						hidden = true
						break
					end
				end
			end
			if hidden and not s.hidden and now - s.bushToastAt > 4 then
				s.bushToastAt = now
				Net.toast(player, "🌿 Ты спрятался в кусте! Динозавры тебя не видят")
			end
			s.hidden = hidden

			applyMovement(player, s, hum, now)
		end
	end

	if not roundActive then
		return
	end

	-- кто в каком круге (динозавр-игрок и пойманные не считаются)
	local inside = {}
	for player, root in pairs(roots) do
		local s = states[player]
		if not s.isDino and s.cagedUntil <= now then
			for _, c in ipairs(arena.circles) do
				if flatDist(root.Position, c.center) < R and root.Position.Y < G + 10 then
					inside[player] = c
					break
				end
			end
		end
	end
	for _, c in ipairs(arena.circles) do
		if c.occupant and inside[c.occupant] ~= c then
			c.occupant = nil
		end
	end
	for player, c in pairs(inside) do
		if c.occupant == nil then
			c.occupant = player
		elseif c.occupant ~= player then
			moveOut(roots[player], c.center, R + 4)
			crackCircle(c, player)
			inside[player] = nil
		end
	end

	-- взять яйцо, убежать с ним
	for player, root in pairs(roots) do
		local s = states[player]
		local c = inside[player]
		if c and not s.carry then
			for _, egg in ipairs(c.eggs) do
				if not egg.taken and flatDist(root.Position, egg.part.Position) < 3.5 then
					grabEgg(player, root, c, egg)
					break
				end
			end
		end
		if s.carry then
			local d = flatDist(root.Position, s.carry.circle.dinoPos)
			if d < s.carry.closest then
				s.carry.closest = d
			end
			if flatDist(root.Position, s.carry.circle.center) > ZONE + 2 then
				bankEgg(player)
			end
		end
	end

	-- спасение из клетки
	for player, s in pairs(states) do
		if s.cage then
			if now >= s.cagedUntil then
				releaseCage(player)
				Net.toast(player, "🔓 Ты свободен! Беги!")
			else
				local root = roots[player]
				for other, os2 in pairs(states) do
					local r2 = roots[other]
					if other ~= player and root and r2 and not os2.isDino and os2.cagedUntil <= now and flatDist(root.Position, r2.Position) < 5 then
						releaseCage(player)
						Net.toast(player, "🦸 " .. other.DisplayName .. " тебя спас!")
						local coins = Progress.addCoins(other, 5, true)
						Net.toast(other, "🦸 Ты спас " .. player.DisplayName .. "! +" .. coins .. " 🪙")
						Net.sound(other, "win")
						Progress.badge(other, "rescuer")
						break
					end
				end
			end
		end
	end

	-- динозавры в кругах
	for _, c in ipairs(arena.circles) do
		local prey: Player? = nil
		for player, s in pairs(states) do
			if s.carry and s.carry.circle == c and isPrey(player, now, roots) then
				prey = player
				break
			end
		end
		if not prey and c.occupant and isPrey(c.occupant, now, roots) then
			prey = c.occupant
		end

		local chasing = prey ~= nil
		if chasing and not c.chasing then
			Net.sound(prey, "roar")
			c.noticeUntil = now + Config.DINO_REACTION
			c.bubble.Text = "❗"
			c.chatUntil = now + Config.DINO_REACTION
		end
		c.chasing = chasing

		-- зелёный прячется в траве, пока никого не ловит
		if c.kind == "green" and c.camo ~= not chasing then
			c.camo = not chasing
			for _, p in ipairs(c.allParts) do
				p.Transparency = c.camo and 0.6 or 0
			end
		end

		local target = prey and Vector3.new(roots[prey].Position.X, G, roots[prey].Position.Z) or c.center
		local delta = flat(target - c.dinoPos)
		local speed = c.def.speed * (chasing and 1 or 0.6)
		-- красный делает рывок
		if c.kind == "red" and chasing and now >= c.nextDash and delta.Magnitude < 18 then
			c.dashUntil = now + 0.5
			c.nextDash = now + 4
		end
		if c.dashUntil > now then
			speed *= 2.2
		end
		if (c.noticeUntil or 0) > now then
			speed = 0 -- ещё удивляется
		end
		local moving = delta.Magnitude > 0.2
		if moving then
			c.dinoPos += delta.Unit * math.min(delta.Magnitude, speed * dt)
			c.dinoFace = delta.Unit
		end
		local fromHome = flat(c.dinoPos - c.center)
		if fromHome.Magnitude > ZONE then
			c.dinoPos = c.center + fromHome.Unit * ZONE
		end
		local bob = moving and math.abs(math.sin(now * 12)) * 0.5 or 0
		local body = c.dinoPos + Vector3.new(0, c.height + bob, 0)
		Models.moveRig(c.dino, CFrame.lookAt(body, body + c.dinoFace))
		if c.dino:GetAttribute("Chasing") ~= chasing then
			c.dino:SetAttribute("Chasing", chasing)
		end

		-- динозавры болтают
		if now >= c.nextChat then
			c.nextChat = now + math.random(6, 14)
			local list = chasing and Config.DINO_PHRASES.chase or Config.DINO_PHRASES.idle
			c.bubble.Text = list[math.random(#list)]
			c.chatUntil = now + 2.5
		elseif c.chatUntil > 0 and now > c.chatUntil then
			c.bubble.Text = ""
			c.chatUntil = 0
		end

		if prey and flatDist(roots[prey].Position, c.dinoPos) < Config.CATCH_DISTANCE then
			if catchPlayer(prey, roots[prey], c.center, ZONE + 6, c.def.name .. " динозавр", nil) then
				local list = Config.DINO_PHRASES.catch
				c.bubble.Text = list[math.random(#list)]
				c.chatUntil = now + 2.5
			end
		end
	end

	-- игрок-динозавр
	if dinoPlayer and roots[dinoPlayer] then
		local dpos = roots[dinoPlayer].Position
		for player, root in pairs(roots) do
			if player ~= dinoPlayer and isPrey(player, now, roots) and flatDist(root.Position, dpos) < Config.CATCH_DISTANCE + 1 then
				catchPlayer(player, root, dpos, nil, "🦖 " .. dinoPlayer.DisplayName, dinoPlayer)
			end
			if states[player].carry and player ~= dinoPlayer then
				local d = flatDist(root.Position, dpos)
				if d < states[player].carry.closest then
					states[player].carry.closest = d
				end
			end
		end
	end

	-- Ти-Рекс
	if not bossDone and roundEnd - now <= Config.BOSS_AT then
		bossDone = true
		spawnBoss(now)
	end
	if boss then
		if now >= boss.untilT then
			removeBoss(true)
		else
			local best, bestD = nil, math.huge
			for player, root in pairs(roots) do
				if isPrey(player, now, roots) then
					local d = flatDist(root.Position, boss.pos)
					if d < bestD then
						best, bestD = player, d
					end
				end
			end
			local target = best and Vector3.new(roots[best].Position.X, G, roots[best].Position.Z) or Vector3.new(0, G, -FZ / 2 + 12)
			local delta = flat(target - boss.pos)
			local moving = delta.Magnitude > 0.5
			if moving then
				boss.pos += delta.Unit * math.min(delta.Magnitude, 12.5 * dt)
				boss.face = delta.Unit
			end
			local body = boss.pos + Vector3.new(0, boss.height + (moving and math.abs(math.sin(now * 6)) or 0), 0)
			Models.moveRig(boss.model, CFrame.lookAt(body, body + boss.face))
			if now >= boss.nextChat then
				boss.nextChat = now + 4
				local list = Config.DINO_PHRASES.boss
				boss.bubble.Text = list[math.random(#list)]
			end
			if best and bestD < 8 then
				if catchPlayer(best, roots[best], boss.pos, nil, "🦖 Ти-Рекс", nil) then
					boss.caughtAny = true
				end
			end
		end
	end

	-- бонусы: появляются и подбираются
	if now >= nextPowerup and #powerups < 4 then
		nextPowerup = now + 6
		local kind = POWER_KINDS[math.random(#POWER_KINDS)]
		local pos = Arena.freePos(2) + Vector3.new(0, 2, 0)
		table.insert(powerups, { kind = kind, pos = pos, model = Models.powerup(kind, pos, arena.folder) })
	end
	for i = #powerups, 1, -1 do
		local p = powerups[i]
		for player, root in pairs(roots) do
			local s = states[player]
			if not s.isDino and s.cagedUntil <= now and flatDist(root.Position, p.pos) < 4 and math.abs(root.Position.Y - p.pos.Y) < 6 then
				takePowerup(player, s, p, now)
				p.model:Destroy()
				table.remove(powerups, i)
				break
			end
		end
	end
end)

-- ---------- игроки заходят и выходят ----------

local function onCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid") :: Humanoid
	char:WaitForChild("HumanoidRootPart")
	char:WaitForChild("Head")
	hum.Died:Connect(function()
		dropEgg(player)
		releaseCage(player)
	end)
	local s = st(player)
	AntiCheat.trust(s.track, os.clock())
	if s.isDino then
		Looks.morphDino(char, s.dinoKind)
	else
		applyLooks(player)
	end
end

local function onPlayerAdded(player: Player)
	if #Players:GetPlayers() > Config.MAX_PLAYERS then
		player:Kick("Игра полная: играть можно только 5 человек")
		return
	end
	states[player] = newState()
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ "Яйца", "Монетки", "Кубки" }) do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = stats
	end
	stats.Parent = player

	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	Data.load(player)
	if not player.Parent then
		return
	end
	Progress.sync(player)
	applyLooks(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	dropEgg(player)
	releaseCage(player)
	Looks.removePlayer(player)
	for _, c in ipairs(arena.circles) do
		if c.occupant == player then
			c.occupant = nil
		end
	end
	if dinoPlayer == player then
		dinoPlayer = nil
	end
	states[player] = nil
	lastCaught[player] = nil
end)

lobby.nestPrompt.Triggered:Connect(function(player)
	Net.send(player, "panel", "pets")
end)

-- ---------- смешное в Динопарке ----------

local SCALES = { "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale" }
setScale = function(player: Player, factor: number)
	local _, hum = getRoot(player)
	if not hum then
		return
	end
	for _, name in ipairs(SCALES) do
		local v = hum:FindFirstChild(name) :: NumberValue?
		if v then
			v.Value = factor
		end
	end
	task.delay(0.2, applyLooks, player)
end

local statueToken = 0
lobby.statuePrompt.Triggered:Connect(function(player)
	statueToken += 1
	local my = statueToken
	local list = Config.DINO_PHRASES.statue
	local phrase = list[math.random(#list)]
	local st0 = lobby.statue
	st0.bubble.Text = phrase
	local snd = Instance.new("Sound")
	local which = phrase:find("Пук") and Config.SOUNDS.fart or Config.SOUNDS.boing
	snd.SoundId = which.id
	snd.PlaybackSpeed = which.speed
	snd.Volume = 1
	snd.Parent = st0.model.PrimaryPart
	snd:Play()
	task.delay(3, function()
		snd:Destroy()
	end)
	task.spawn(function()
		local base = st0.pos + Vector3.new(0, st0.height, 0)
		local look = CFrame.lookAt(base, base + Vector3.new(0.4, 0, 1)).Rotation
		for i = 1, 10 do
			local y = math.sin(i / 10 * math.pi) * 3
			Models.moveRig(st0.model, CFrame.new(base + Vector3.new(0, y, 0)) * look)
			task.wait(0.04)
		end
		Models.moveRig(st0.model, CFrame.new(base) * look)
	end)
	task.delay(3, function()
		if my == statueToken then
			st0.bubble.Text = ""
		end
	end)
end)

-- ---------- кнопки с экрана ----------

Net.Request.OnServerInvoke = function(player: Player, action: any, arg: any)
	local s = states[player]
	if not s then
		-- игрок ещё не добавлен или уже ушёл: не создаём ему состояние заново
		return { ok = false }
	end
	local now = os.clock()
	if not AntiCheat.allow(s.bucket, now, 8, 15) then
		return { ok = false, busy = true } -- чит-скрипт жмёт кнопки сотни раз в секунду
	end
	if action == "roar" then
		if not (s.isDino and roundActive) then
			return { ok = false }
		end
		if now < s.roarAt then
			return { ok = false, wait = s.roarAt - now }
		end
		s.roarAt = now + 8
		local root = getRoot(player)
		if root then
			for other, os2 in pairs(states) do
				local r2 = getRoot(other)
				if other ~= player and r2 and flatDist(r2.Position, root.Position) < 25 then
					os2.slowUntil = now + 2
					Net.toast(other, "🦖 РРРР! Динозавр рычит, ты замедлился!")
					Net.send(other, "shake", 0.5)
				end
			end
		end
		Net.sound(nil, "roar")
		return { ok = true, cooldown = 8 }
	elseif action == "dash" then
		if not (s.isDino and roundActive) then
			return { ok = false }
		end
		if now < s.dashAt then
			return { ok = false, wait = s.dashAt - now }
		end
		s.dashAt = now + 5
		s.dashUntil = now + 0.6
		Net.sound(player, "swoosh")
		return { ok = true, cooldown = 5 }
	elseif action == "fart" then
		local root = getRoot(player)
		if root and now - s.fartAt > 2 then
			s.fartAt = now
			local cloud = Models.part(fxFolder, Vector3.new(1, 1, 1), CFrame.new(root.Position - Vector3.new(0, 1.5, 0)), Color3.new(1, 1, 1))
			cloud.Transparency = 1
			local puff = Instance.new("ParticleEmitter")
			puff.Color = ColorSequence.new(Color3.fromRGB(170, 210, 60), Color3.fromRGB(120, 160, 40))
			puff.Size = NumberSequence.new(1.5, 5)
			puff.Transparency = NumberSequence.new(0.2, 1)
			puff.Lifetime = NumberRange.new(1.2, 1.8)
			puff.Speed = NumberRange.new(2, 5)
			puff.SpreadAngle = Vector2.new(180, 180)
			puff.Rate = 80
			puff.Parent = cloud
			Models.label(cloud, "ПУК! 💨", 4, Color3.fromRGB(190, 240, 90), 80)
			local snd = Instance.new("Sound")
			snd.SoundId = Config.SOUNDS.fart.id
			snd.PlaybackSpeed = Config.SOUNDS.fart.speed
			snd.Volume = 1
			snd.RollOffMaxDistance = 80
			snd.Parent = cloud
			snd:Play()
			task.delay(0.4, function()
				puff.Enabled = false
			end)
			task.delay(2.5, function()
				cloud:Destroy()
			end)
			Net.toast(player, "💨 Хи-хи!")
			for _, other in ipairs(Players:GetPlayers()) do
				local r2 = getRoot(other)
				if other ~= player and r2 and flatDist(r2.Position, root.Position) < 25 then
					Net.toast(other, "Фу-у-у! " .. player.DisplayName .. " пукнул 😂")
				end
			end
		end
		return { ok = true }
	elseif action == "mushroom" then
		local root = getRoot(player)
		if not root or not Lobby.contains(root.Position) or now - s.mushroomAt < 4 or s.isDino then
			return { ok = false }
		end
		s.mushroomAt = now
		local factor = arg == "big" and 2.2 or 0.45
		setScale(player, factor)
		s.scaleUntil = now + 12
		Net.sound(player, "boing")
		Net.toast(player, arg == "big" and "🍄 Ты ВЕЛИКАН! Топ-топ!" or "🍄 Ты малыш-малышок! Пи-пи-пи!")
		task.delay(12, function()
			if states[player] == s and os.clock() >= s.scaleUntil - 0.05 then
				setScale(player, 1)
			end
		end)
		return { ok = true }
	elseif action == "tongue" then
		if player.Character and not s.isDino then
			Looks.tongue(player.Character)
		end
		return { ok = true }
	end
	return Progress.handle(player, action, arg)
end

-- ---------- табло ----------

task.spawn(function()
	while true do
		Net.set("Status", status)
		lobby.boardStatus.Text = roundActive and "Идёт игра! Прыгай в зелёный портал ▶" or (status ~= "" and status or "Скоро игра!")
		for _, tile in ipairs(lobby.disco) do
			tile.Color = Color3.fromHSV(math.random(), 0.65, 1)
		end
		Net.set("TimeLeft", roundActive and math.max(0, math.ceil(roundEnd - os.clock())) or -1)
		task.wait(0.2)
	end
end)

-- ---------- таймы ----------

local function pickDinoPlayer(list: { Player }): Player?
	if #list < 2 then
		return nil
	end
	local best, bestN = nil, 0
	for _, p in ipairs(list) do
		local n = lastCaught[p] or 0
		if n > bestN then
			best, bestN = p, n
		end
	end
	return best or list[math.random(#list)]
end

local function cleanupRound()
	roundActive = false
	for player in pairs(states) do
		dropEgg(player)
		releaseCage(player)
	end
	clearPowerups()
	removeBoss(false)
end

local function showTrophy(text: string, seconds: number)
	local cup = Models.trophy(lobby.folder, text)
	local start = os.clock()
	while os.clock() - start < seconds do
		cup:PivotTo(CFrame.new(0, 10, 0) * CFrame.Angles(0, (os.clock() - start) * 2, 0))
		task.wait()
	end
	cup:Destroy()
end

local function giveCup(player: Player)
	local profile = Data.get(player)
	if profile then
		profile.cups += 1
	end
	Progress.addCoins(player, 20, true)
	Progress.badge(player, "winner")
end

task.spawn(function()
	while true do
		status = "Ждём игроков"
		while #Players:GetPlayers() == 0 do
			task.wait(1)
		end

		roundNo += 1
		local theme = Config.THEMES[(roundNo - 1) % #Config.THEMES + 1]
		for i = Config.INTERMISSION, 1, -1 do
			status = "Скоро " .. theme.icon .. " " .. theme.name .. ": " .. i
			task.wait(1)
		end

		cleanupRound()
		Graphics.applyTheme(theme.id, event)
		arena = Arena.buildRound(theme.id, event)
		Net.set("Map", theme.icon .. " " .. theme.name)
		Net.set("Theme", theme.id)
		humansScore, dinoScore = 0, 0
		updateScore()
		bossDone = false
		nextPowerup = 0

		local list = Players:GetPlayers()
		dinoPlayer = pickDinoPlayer(list)
		table.clear(lastCaught)
		-- новый персонаж появляется не мгновенно: переносим на поле только после LoadCharacter
		local function spawnOnField(player: Player, slot: number)
			player:LoadCharacter()
			if player.Parent then
				teleport(player, lobby.fieldCFrame * CFrame.new(-24 + (slot - 1) * 12, 0, 0))
			end
		end
		for i, player in ipairs(list) do
			local old = states[player]
			local s = newState()
			if old then
				s.obbyAt = old.obbyAt
			end
			states[player] = s
			local stats = player:FindFirstChild("leaderstats")
			local eggs = stats and stats:FindFirstChild("Яйца") :: IntValue?
			if eggs then
				eggs.Value = 0
			end
			if player ~= dinoPlayer then
				task.spawn(spawnOnField, player, i)
			end
		end
		if dinoPlayer then
			local s = st(dinoPlayer)
			s.isDino = true
			s.dinoKind = Config.DINO_ORDER[math.random(#Config.DINO_ORDER)]
			task.spawn(spawnOnField, dinoPlayer, table.find(list, dinoPlayer) or 1) -- при появлении сразу станет динозавром
			Net.send(dinoPlayer, "role", { dino = true })
			Net.send(dinoPlayer, "big", { text = "🦖 Ты динозавр! Лови людей!", seconds = 4 })
			Net.send(dinoPlayer, "voice", "Ты динозавр! Лови людей!")
			Progress.badge(dinoPlayer, "was_dino")
			Net.all("toast", "🦖 " .. dinoPlayer.DisplayName .. " в этот раз динозавр!")
		end
		Net.set("DinoPlayer", dinoPlayer and dinoPlayer.DisplayName or "")
		task.wait(1)

		Net.big("Хватай яйца и убегай!", 3, "Хватай яйцо! Беги!")
		roundEnd = os.clock() + Config.ROUND_TIME
		roundActive = true
		status = ""
		while os.clock() < roundEnd and #Players:GetPlayers() > 0 do
			task.wait(0.25)
		end

		for player, s in pairs(states) do
			lastCaught[player] = s.caught
		end
		cleanupRound()

		local text
		if humansScore > dinoScore then
			text = "🏆 Кубок у людей!"
			for player, s in pairs(states) do
				if not s.isDino and playing(player) then
					giveCup(player)
				end
			end
		elseif dinoScore > humansScore then
			text = "🏆 Кубок у динозавров!"
			if dinoPlayer and dinoPlayer.Parent then
				giveCup(dinoPlayer)
			end
		else
			text = "🤝 Ничья!"
		end
		status = "Конец тайма"
		Net.big(string.format("%s  Люди %d : %d Динозавры", text, humansScore, dinoScore), 7, text:find("Ничья") and "Ничья!" or "Кубок!")
		Net.sound(nil, "win")
		for _, player in ipairs(Players:GetPlayers()) do
			Progress.sync(player)
		end

		showTrophy(text, 7)
		if dinoPlayer and dinoPlayer.Parent then
			local dp = dinoPlayer
			st(dp).isDino = false
			Net.send(dp, "role", { dino = false })
			task.spawn(dp.LoadCharacter, dp) -- появится в Динопарке
		end
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= dinoPlayer then
				teleport(player, lobby.spawnCFrame * CFrame.new(math.random(-6, 6), 0, math.random(-4, 4)))
			end
		end
		dinoPlayer = nil
		Net.set("DinoPlayer", "")
		Net.big("🦖 Добро пожаловать в Динопарк!", 3)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[-- Все модели собираются из простых деталей, поэтому игре не нужны чужие ассеты.
local CollectionService = game:GetService("CollectionService")

local Models = {}

local WHITE = Color3.fromRGB(247, 243, 227)
local BLACK = Color3.fromRGB(25, 25, 25)

function Models.part(parent: Instance?, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
local part = Models.part

local function ball(parent: Instance?, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = part(parent, size, cframe, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end
Models.ball = ball

-- вертикальный цилиндр (в Roblox цилиндр лежит вдоль X, поэтому поворачиваем)
local function cylinder(parent: Instance?, height: number, diameter: number, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = part(parent, Vector3.new(height, diameter, diameter), cframe * CFrame.Angles(0, 0, math.rad(90)), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end
Models.cylinder = cylinder

function Models.label(adornee: BasePart, text: string, offsetY: number, color: Color3, maxDistance: number?): TextLabel
	local bb = Instance.new("BillboardGui")
	-- размер в шагах мира, а не в пикселях: вдалеке надпись маленькая, на телефоне не закрывает экран
	bb.Size = UDim2.fromScale(7, 1.4)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = maxDistance or 60
	bb.Adornee = adornee
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = color
	t.TextStrokeTransparency = 0
	t.Parent = bb
	bb.Parent = adornee
	return t
end

-- Облачко со словами над головой. Пустой текст — облачко спрятано.
function Models.bubble(adornee: BasePart, offsetY: number): TextLabel
	local bb = Instance.new("BillboardGui")
	bb.Name = "Bubble"
	bb.Size = UDim2.fromScale(9, 2)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 60
	bb.Enabled = false
	bb.Adornee = adornee
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = Color3.new(1, 1, 1)
	t.TextColor3 = Color3.fromRGB(31, 42, 23)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = ""
	t.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 14)
	c.Parent = t
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = t
	bb.Parent = adornee
	t:GetPropertyChangedSignal("Text"):Connect(function()
		bb.Enabled = t.Text ~= ""
	end)
	return t
end

-- Приклеивает все детали модели к root: модель становится одним целым и не мешает ходить.
function Models.weldTo(model: Instance, root: BasePart)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			if d ~= root then
				local w = Instance.new("WeldConstraint")
				w.Part0 = root
				w.Part1 = d
				w.Parent = d
			end
			d.Anchored = false
		end
	end
end

function Models.setVisible(root: Instance, visible: boolean)
	local list = root:GetDescendants()
	table.insert(list, root)
	for _, d in ipairs(list) do
		if d:IsA("BasePart") then
			d.Transparency = visible and 0 or 1
		elseif d:IsA("ParticleEmitter") or d:IsA("Sparkles") then
			d.Enabled = visible
		end
	end
end

-- ---------- шапки ----------
-- top — CFrame макушки, k — размер (1 для человека)
function Models.hat(id: string, parent: Instance, top: CFrame, k: number): { BasePart }
	local parts = {}
	local function add(p)
		table.insert(parts, p)
		return p
	end
	if id == "hat_dino" then
		local green = Color3.fromRGB(108, 207, 69)
		add(ball(parent, Vector3.new(2.3, 1.3, 2.3) * k, top * CFrame.new(0, 0.15 * k, 0), green))
		for i = -1, 1 do
			add(part(parent, Vector3.new(0.3, 0.8, 0.8) * k, top * CFrame.new(0, 0.8 * k, i * 0.6 * k) * CFrame.Angles(math.rad(45), 0, 0), Color3.fromRGB(44, 107, 30)))
		end
	elseif id == "hat_crown" then
		local gold = Color3.fromRGB(242, 194, 48)
		add(cylinder(parent, 0.6 * k, 2.1 * k, top * CFrame.new(0, 0.3 * k, 0), gold, Enum.Material.Foil))
		for i = 0, 4 do
			local a = i / 5 * math.pi * 2
			add(part(parent, Vector3.new(0.35, 0.7, 0.35) * k, top * CFrame.new(math.cos(a) * 0.85 * k, 0.85 * k, math.sin(a) * 0.85 * k), gold, Enum.Material.Foil))
		end
		add(ball(parent, Vector3.new(0.4, 0.4, 0.4) * k, top * CFrame.new(0, 0.35 * k, -1 * k), Color3.fromRGB(230, 60, 90), Enum.Material.Neon))
	elseif id == "hat_bunny" then
		for _, x in ipairs({ -0.45, 0.45 }) do
			local cf = top * CFrame.new(x * k, 1.1 * k, 0) * CFrame.Angles(0, 0, math.rad(x > 0 and -10 or 10))
			add(ball(parent, Vector3.new(0.6, 2.2, 0.35) * k, cf, Color3.new(1, 1, 1)))
			add(ball(parent, Vector3.new(0.35, 1.7, 0.2) * k, cf * CFrame.new(0, 0, -0.1 * k), Color3.fromRGB(255, 170, 200)))
		end
	elseif id == "hat_pumpkin" then
		add(ball(parent, Vector3.new(2.5, 2, 2.5) * k, top * CFrame.new(0, 0.5 * k, 0), Color3.fromRGB(240, 130, 30)))
		add(part(parent, Vector3.new(0.3, 0.6, 0.3) * k, top * CFrame.new(0, 1.6 * k, 0), Color3.fromRGB(60, 120, 40)))
	elseif id == "hat_santa" then
		local red = Color3.fromRGB(210, 40, 40)
		add(cylinder(parent, 0.45 * k, 2.3 * k, top * CFrame.new(0, 0.15 * k, 0), Color3.new(1, 1, 1)))
		add(cylinder(parent, 0.6 * k, 1.9 * k, top * CFrame.new(0, 0.6 * k, 0.05 * k), red))
		add(cylinder(parent, 0.6 * k, 1.35 * k, top * CFrame.new(0, 1.15 * k, 0.2 * k), red))
		add(cylinder(parent, 0.6 * k, 0.8 * k, top * CFrame.new(0, 1.65 * k, 0.4 * k), red))
		add(ball(parent, Vector3.new(0.6, 0.6, 0.6) * k, top * CFrame.new(0, 2.05 * k, 0.6 * k), Color3.new(1, 1, 1)))
	end
	return parts
end

-- ---------- динозавр ----------
-- Круглый милый динозавр со «скелетом»: шея, челюсть, хвост из 3 частей, 4 лапы и ручки
-- двигаются (их анимирует экран игрока). Главная деталь Body закреплена, остальное приклеено к ней.
-- Собирается стоящим на земле в точке (0,0,0), смотрит вперёд (-Z).
-- Возвращает модель, детали основного цвета (первая — туловище, вторая — голова) и высоту центра туловища.
function Models.dino(color: Color3, dark: Color3, scale: number, opts: any?)
	opts = opts or {}
	local s = scale
	local model = Instance.new("Model")
	model.Name = opts.name or "Dino"
	local belly = color:Lerp(Color3.new(1, 1, 1), 0.45)
	local white = Color3.new(1, 1, 1)
	local pink = Color3.fromRGB(255, 150, 170)
	local colorParts = {}

	local current: BasePart? = nil -- к какой детали приклеивать новые
	local attachTo: { [BasePart]: BasePart } = {}
	local joints = {}
	local function add(p: BasePart): BasePart
		if current then
			attachTo[p] = current
		end
		return p
	end
	local function E(size: Vector3, pos: Vector3, c: Color3, rot: CFrame?, mat: Enum.Material?): BasePart
		return add(ball(model, size * s, CFrame.new(pos * s) * (rot or CFrame.identity), c, mat))
	end
	local function B(size: Vector3, pos: Vector3, c: Color3, rot: CFrame?): BasePart
		return add(part(model, size * s, CFrame.new(pos * s) * (rot or CFrame.identity), c))
	end
	local function motor(name: string, p0: BasePart, p1: BasePart, pivot: Vector3)
		attachTo[p1] = nil
		table.insert(joints, { name = name, p0 = p0, p1 = p1, pivot = CFrame.new(pivot * s) })
	end
	local V = Vector3.new
	local plateRot = CFrame.Angles(math.rad(45), 0, 0)

	-- туловище
	local body = E(V(6, 5, 8), V(0, 5, 0), color)
	body.Name = "Body"
	current = body
	E(V(4.6, 3.8, 6.4), V(0, 4.3, -0.6), belly)
	for _, x in ipairs({ -1, 1 }) do
		E(V(0.3, 1.3, 1.6), V(x * 2.85, 5.6, 0.6), dark)
		E(V(0.3, 0.9, 1.1), V(x * 2.65, 6.4, -1.6), dark)
		E(V(0.3, 0.8, 1.0), V(x * 2.8, 4.6, 2.3), dark)
	end
	local neck = E(V(3, 3.6, 3), V(0, 7, -3.4), color, CFrame.Angles(math.rad(-30), 0, 0))
	for i = 0, 4 do
		local h = 1.7 - math.abs(i - 2) * 0.3
		B(V(0.4, h, h), V(0, 7.3, -2.6 + i * 1.4), dark, plateRot)
	end

	-- голова
	local head = E(V(4, 3.4, 4.6), V(0, 8.6, -5.2), color)
	head.Name = "Head"
	motor("Neck", body, head, V(0, 7.4, -3.8))
	current = head
	local snout = E(V(3.2, 2.2, 3.2), V(0, 8.0, -7.1), color)
	for _, x in ipairs({ -1, 1 }) do
		E(V(0.35, 0.35, 0.35), V(x * 0.6, 8.6, -8.6), BLACK)
		E(V(1.3, 1.3, 1.3), V(x * 1.3, 9.4, -6.4), white)
		E(V(0.7, 0.75, 0.4), V(x * 1.35, 9.45, -7.0), BLACK)
		E(V(0.25, 0.25, 0.15), V(x * 1.2, 9.7, -7.2), white, nil, Enum.Material.Neon)
		local lid = E(V(1.42, 1.42, 1.42), V(x * 1.3, 9.4, -6.4), color)
		lid.Name = "Eyelid"
		lid.Transparency = 1
		B(V(1.0, 0.22, 0.3), V(x * 1.3, 10.25, -6.6), dark, CFrame.Angles(0, 0, math.rad(-12 * x)))
		E(V(0.25, 0.7, 0.9), V(x * 1.85, 8.5, -6.2), pink)
	end
	for i = 0, 2 do
		B(V(0.35, 0.9, 0.9), V(0, 10.3, -4.2 - i * 0.8), dark, plateRot)
	end
	for _, x in ipairs({ -0.9, -0.3, 0.3, 0.9 }) do
		B(V(0.3, 0.45, 0.3), V(x, 7.05, -8.2), white)
	end
	local jaw = E(V(2.8, 1.2, 3.2), V(0, 7.0, -6.8), color:Lerp(dark, 0.3))
	jaw.Name = "Jaw"
	motor("Jaw", head, jaw, V(0, 7.5, -5.4))
	current = jaw
	E(V(1.4, 0.35, 1.8), V(0, 7.45, -6.8), pink)

	-- хвост из трёх частей
	current = body
	local tailA = E(V(3.6, 3.2, 5), V(0, 5.0, 4.8), color)
	motor("TailA", body, tailA, V(0, 5.2, 3.0))
	current = tailA
	B(V(0.35, 1.2, 1.2), V(0, 6.6, 4.6), dark, plateRot)
	local tailB = E(V(2.6, 2.3, 4.4), V(0, 4.6, 8.2), color)
	motor("TailB", tailA, tailB, V(0, 4.8, 6.6))
	current = tailB
	B(V(0.3, 0.9, 0.9), V(0, 5.8, 8.0), dark, plateRot)
	local tailC = E(V(1.5, 1.4, 3.6), V(0, 4.2, 11.2), color)
	motor("TailC", tailB, tailC, V(0, 4.4, 9.8))

	-- лапы
	local limbs = {}
	for _, leg in ipairs({ { "HipFL", -1, -2.2 }, { "HipFR", 1, -2.2 }, { "HipBL", -1, 2.4 }, { "HipBR", 1, 2.4 } }) do
		local x, z = leg[2], leg[3]
		current = body
		local thigh = E(V(2.2, 3.2, 2.6), V(x * 2.1, 3.4, z), color)
		motor(leg[1], body, thigh, V(x * 2.1, 4.4, z))
		current = thigh
		local shin = E(V(1.7, 2.4, 1.7), V(x * 2.1, 1.6, z + 0.2), color)
		E(V(2, 0.9, 2.6), V(x * 2.1, 0.45, z - 0.4), dark)
		for _, cx in ipairs({ -0.6, 0, 0.6 }) do
			E(V(0.35, 0.35, 0.45), V(x * 2.1 + cx, 0.35, z - 1.7), white)
		end
		table.insert(limbs, thigh)
		table.insert(limbs, shin)
	end
	-- маленькие ручки
	for _, x in ipairs({ -1, 1 }) do
		current = body
		local arm = E(V(0.8, 1.8, 0.8), V(x * 2.3, 5.4, -3.6), color, CFrame.Angles(math.rad(-35), 0, 0))
		motor(x < 0 and "ArmL" or "ArmR", body, arm, V(x * 2.2, 6.2, -3.2))
		current = arm
		E(V(0.6, 0.6, 0.6), V(x * 2.3, 4.7, -4.3), color)
		table.insert(limbs, arm)
	end

	for _, p in ipairs({ body, head, neck, snout, jaw, tailA, tailB, tailC }) do
		table.insert(colorParts, p)
	end
	for _, p in ipairs(limbs) do
		table.insert(colorParts, p)
	end

	if opts.hat then
		local top = head.CFrame * CFrame.new(0, head.Size.Y / 2 - 0.2 * s, 0.3 * s)
		for _, p in ipairs(Models.hat(opts.hat, model, top, 1.4 * s)) do
			attachTo[p] = head
		end
	end
	if opts.trail then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.7, 0) * s
		a0.Parent = tailC
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.7, 0) * s
		a1.Parent = tailC
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.8
		trail.LightEmission = 0.6
		trail.Color = Models.rainbowSequence()
		trail.Parent = tailC
	end
	if opts.label then
		Models.label(head, opts.label, 3 * s + 1.5, opts.labelColor or color)
	end

	-- соединяем всё в одно целое
	for _, j in ipairs(joints) do
		local m = Instance.new("Motor6D")
		m.Name = j.name
		m.Part0 = j.p0
		m.Part1 = j.p1
		m.C0 = j.p0.CFrame:Inverse() * j.pivot
		m.C1 = j.p1.CFrame:Inverse() * j.pivot
		m.Parent = j.p0
	end
	local jointed = {}
	for _, j in ipairs(joints) do
		jointed[j.p1] = true
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= body then
			if not jointed[d] then
				local w = Instance.new("WeldConstraint")
				w.Part0 = attachTo[d] or body
				w.Part1 = d
				w.Parent = d
			end
			d.Anchored = false
			d.Massless = true
		end
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	model.PrimaryPart = body
	CollectionService:AddTag(model, "DinoRig")
	model:SetAttribute("Scale", s)
	return model, colorParts, 5 * s
end

-- Приклеить динозавра к игроку (превращение): туловище больше не закреплено, а приварено к root.
function Models.attachRig(model: Model, root: BasePart)
	local body = model.PrimaryPart :: BasePart
	body.Anchored = false
	body.Massless = true
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = body
	w.Parent = body
end

-- передвинуть динозавра: двигаем только туловище, остальное едет следом
function Models.moveRig(model: Model, cf: CFrame)
	local body = model.PrimaryPart
	if body then
		body.CFrame = cf
	end
end

function Models.rainbowSequence(): ColorSequence
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 7, 0.8, 1)))
	end
	return ColorSequence.new(keys)
end

-- ---------- яйца ----------
-- kind: normal / gold / rainbow; event меняет вид (тыквы на Хэллоуин, подарки на Новый год)
local SPOTS = { Vector3.new(0.6, 0.35, 0.5), Vector3.new(-0.6, -0.1, 0.45), Vector3.new(0.1, -0.55, -0.7), Vector3.new(-0.2, 0.6, -0.5) }
local function weldSmall(egg: BasePart, p: BasePart)
	p.Anchored = false
	p.Massless = true
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1, w.Parent = egg, p, p
end

function Models.egg(kind: string, cframe: CFrame, parent: Instance, event: string): Part
	local egg: Part
	if event == "newyear" and kind ~= "rainbow" then
		local color = kind == "gold" and Color3.fromRGB(242, 194, 48) or Color3.fromRGB(210, 40, 40)
		egg = part(parent, Vector3.new(1.6, 1.6, 1.6), cframe * CFrame.new(0, -0.15, 0), color)
		local ribbonColor = kind == "gold" and Color3.fromRGB(210, 40, 40) or Color3.fromRGB(250, 220, 90)
		weldSmall(egg, part(egg, Vector3.new(1.7, 1.7, 0.3), egg.CFrame, ribbonColor))
		weldSmall(egg, part(egg, Vector3.new(0.3, 1.7, 1.7), egg.CFrame, ribbonColor))
		weldSmall(egg, ball(egg, Vector3.new(0.8, 0.5, 0.8), egg.CFrame * CFrame.new(0, 0.9, 0), ribbonColor))
	else
		local color = Color3.fromRGB(251, 246, 230)
		local spot = Color3.fromRGB(150, 200, 120)
		local isGold = kind == "gold"
		if isGold then
			color = Color3.fromRGB(255, 216, 74)
			spot = Color3.fromRGB(255, 245, 190)
		elseif event == "halloween" then
			color = Color3.fromRGB(245, 150, 50)
			spot = Color3.fromRGB(60, 40, 40)
		end
		local size = Vector3.new(1.4, 1.9, 1.4) * (kind == "rainbow" and 1.3 or 1)
		egg = ball(parent, size, cframe, color, (kind == "rainbow" or isGold) and Enum.Material.Neon or nil)
		if isGold then
			egg.Material = Enum.Material.Foil
		end
		if kind ~= "rainbow" then
			-- пятнышки на скорлупе
			for _, d in ipairs(SPOTS) do
				local r = size / 2
				local n = d / math.sqrt((d.X / r.X) ^ 2 + (d.Y / r.Y) ^ 2 + (d.Z / r.Z) ^ 2)
				weldSmall(egg, ball(egg, Vector3.new(0.38, 0.38, 0.38), cframe * CFrame.new(n * 0.95), spot))
			end
		end
	end
	if kind == "rainbow" then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromRGB(255, 255, 255)
		sp.Parent = egg
	end
	egg.Name = "Egg"
	CollectionService:AddTag(egg, "Egg")
	return egg
end

-- ---------- клетка для пойманного ----------
function Models.cage(position: Vector3, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = "Cage"
	local base = CFrame.new(position)
	local color = Color3.fromRGB(120, 90, 60)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		part(m, Vector3.new(0.4, 7, 0.4), base * CFrame.new(math.cos(a) * 3, 3.5, math.sin(a) * 3), color, Enum.Material.Wood)
	end
	cylinder(m, 0.6, 7, base * CFrame.new(0, 7.2, 0), color, Enum.Material.Wood)
	m.Parent = parent
	return m
end

-- ---------- природа ----------
function Models.bush(parent: Instance, pos: Vector3, color: Color3)
	local m = Instance.new("Model")
	m.Name = "Bush"
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2
		local r = i == 7 and 0 or 2.4
		local size = i == 7 and 6 or math.random(40, 55) / 10
		local shade = color:Lerp(i % 2 == 0 and Color3.new(1, 1, 1) or Color3.new(0, 0, 0), 0.08 + math.random() * 0.06)
		ball(m, Vector3.new(size, size * 0.8, size), CFrame.new(pos + Vector3.new(math.cos(a) * r, 2 + (i == 7 and 1 or 0.3), math.sin(a) * r)), shade, Enum.Material.LeafyGrass)
	end
	-- ягодки или цветочки
	local berry = ({ Color3.fromRGB(230, 50, 70), Color3.fromRGB(255, 240, 120), Color3.fromRGB(150, 110, 255) })[math.random(3)]
	for i = 1, 8 do
		local a = math.random() * math.pi * 2
		local h = 1.5 + math.random() * 2.5
		ball(m, Vector3.new(0.5, 0.5, 0.5), CFrame.new(pos + Vector3.new(math.cos(a) * 3.2, h, math.sin(a) * 3.2)), berry)
	end
	m.Parent = parent
	return m
end

local LEAVES = { Color3.fromRGB(60, 150, 50), Color3.fromRGB(80, 170, 60), Color3.fromRGB(45, 125, 45), Color3.fromRGB(100, 180, 70) }

function Models.tree(parent: Instance, pos: Vector3, palm: boolean)
	local m = Instance.new("Model")
	m.Name = palm and "Palm" or "Tree"
	local bark = Color3.fromRGB(115, 78, 48)
	if palm then
		-- изогнутый ствол из колец
		local top = pos
		local lean = Vector3.new(math.random(-10, 10) / 10, 0, math.random(-10, 10) / 10)
		for i = 0, 7 do
			local p = pos + Vector3.new(0, i * 1.7 + 0.85, 0) + lean * (i * i) * 0.06
			local c = cylinder(m, 1.8, 1.9 - i * 0.08, CFrame.new(p), i % 2 == 0 and bark or bark:Lerp(Color3.new(1, 1, 1), 0.15), Enum.Material.Wood)
			c.CanCollide = i < 3
			top = p
		end
		for i = 0, 2 do
			ball(m, Vector3.new(0.9, 0.9, 0.9), CFrame.new(top + Vector3.new(math.cos(i * 2.1) * 0.6, -0.4, math.sin(i * 2.1) * 0.6)), Color3.fromRGB(110, 75, 40))
		end
		for i = 0, 6 do
			local a = i / 7 * math.pi * 2
			local base = CFrame.new(top + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, a, 0)
			for k = 0, 2 do
				local seg = base * CFrame.Angles(math.rad(-15 - k * 18), 0, 0) * CFrame.new(0, 0, -1.6 - k * 2.7)
				part(m, Vector3.new(2.2 - k * 0.5, 0.25, 3), seg, LEAVES[(i + k) % 4 + 1], Enum.Material.LeafyGrass)
				base = base * CFrame.new(0, -k * 0.8, -2.6)
			end
		end
	else
		local h = math.random(9, 13)
		local trunk = cylinder(m, h * 0.6, 2.2, CFrame.new(pos + Vector3.new(0, h * 0.3, 0)), bark, Enum.Material.Wood)
		trunk.CanCollide = true
		cylinder(m, h * 0.5, 1.6, CFrame.new(pos + Vector3.new(0, h * 0.8, 0)), bark, Enum.Material.Wood)
		for i = 0, 3 do
			local a = i / 4 * math.pi * 2 + 0.4
			part(m, Vector3.new(0.6, 0.6, 3), CFrame.new(pos + Vector3.new(math.cos(a) * 1.3, 0.3, math.sin(a) * 1.3)) * CFrame.Angles(0, -a + math.pi / 2, math.rad(15)), bark, Enum.Material.Wood)
		end
		local crown = pos + Vector3.new(0, h + 1.5, 0)
		ball(m, Vector3.new(9, 7.5, 9), CFrame.new(crown), LEAVES[math.random(4)], Enum.Material.LeafyGrass)
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			local sz = math.random(50, 70) / 10
			ball(m, Vector3.new(sz, sz * 0.85, sz), CFrame.new(crown + Vector3.new(math.cos(a) * 3.6, math.random(-15, 15) / 10, math.sin(a) * 3.6)), LEAVES[(i % 4) + 1], Enum.Material.LeafyGrass)
		end
		ball(m, Vector3.new(6, 5, 6), CFrame.new(crown + Vector3.new(0, 3.5, 0)), LEAVES[math.random(4)], Enum.Material.LeafyGrass)
		if math.random() < 0.5 then
			for i = 1, 6 do
				local a = math.random() * math.pi * 2
				ball(m, Vector3.new(0.7, 0.7, 0.7), CFrame.new(crown + Vector3.new(math.cos(a) * 4.6, math.random(-20, 10) / 10, math.sin(a) * 4.6)), Color3.fromRGB(230, 50, 50))
			end
		end
	end
	m.Parent = parent
	return m
end

-- ёлка со снегом
function Models.pine(parent: Instance, pos: Vector3, snowy: boolean)
	local m = Instance.new("Model")
	m.Name = "Pine"
	local trunk = cylinder(m, 4, 1.4, CFrame.new(pos + Vector3.new(0, 2, 0)), Color3.fromRGB(100, 70, 45), Enum.Material.Wood)
	trunk.CanCollide = true
	for i = 0, 4 do
		local d = 9 - i * 1.7
		local y = 4 + i * 2.2
		ball(m, Vector3.new(d, 2.6, d), CFrame.new(pos + Vector3.new(0, y, 0)), Color3.fromRGB(35, 105, 60), Enum.Material.LeafyGrass)
		if snowy then
			ball(m, Vector3.new(d * 0.8, 1, d * 0.8), CFrame.new(pos + Vector3.new(0, y + 1.1, 0)), Color3.new(1, 1, 1), Enum.Material.Snow)
		end
	end
	ball(m, Vector3.new(1, 1.6, 1), CFrame.new(pos + Vector3.new(0, 15.6, 0)), snowy and Color3.new(1, 1, 1) or Color3.fromRGB(35, 105, 60))
	m.Parent = parent
	return m
end

function Models.flower(parent: Instance, pos: Vector3)
	local colors = { Color3.fromRGB(255, 120, 160), Color3.fromRGB(255, 220, 80), Color3.fromRGB(150, 130, 255), Color3.new(1, 1, 1), Color3.fromRGB(255, 140, 60) }
	local petal = colors[math.random(#colors)]
	local h = 1 + math.random() * 0.8
	part(parent, Vector3.new(0.18, h, 0.18), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(60, 140, 50))
	ball(parent, Vector3.new(0.9, 0.2, 0.45), CFrame.new(pos + Vector3.new(0.35, h * 0.4, 0)) * CFrame.Angles(0, 0, math.rad(20)), Color3.fromRGB(70, 160, 60))
	local head = pos + Vector3.new(0, h, 0)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		ball(parent, Vector3.new(0.55, 0.2, 0.55), CFrame.new(head + Vector3.new(math.cos(a) * 0.38, 0, math.sin(a) * 0.38)), petal)
	end
	ball(parent, Vector3.new(0.4, 0.3, 0.4), CFrame.new(head + Vector3.new(0, 0.08, 0)), Color3.fromRGB(255, 200, 40))
end

function Models.rock(parent: Instance, pos: Vector3, size: number)
	local m = Instance.new("Model")
	m.Name = "Rock"
	local grey = Color3.fromRGB(125, 125, 130)
	for i = 1, 3 do
		local sz = size * (1 - (i - 1) * 0.28)
		local p = part(m, Vector3.new(sz, sz * 0.7, sz * 0.9), CFrame.new(pos + Vector3.new((i - 2) * size * 0.4, sz * 0.25, (i % 2) * size * 0.3)) * CFrame.Angles(math.random() * 0.6, math.random() * 6, math.random() * 0.6), grey:Lerp(Color3.new(0, 0, 0), math.random() * 0.2), Enum.Material.Rock)
		p.CanCollide = true
	end
	if math.random() < 0.6 then
		ball(m, Vector3.new(size * 0.7, 0.3, size * 0.5), CFrame.new(pos + Vector3.new(0, size * 0.55, 0)), Color3.fromRGB(90, 150, 60), Enum.Material.Grass)
	end
	m.Parent = parent
	return m
end

function Models.log(parent: Instance, pos: Vector3)
	local a = math.random() * math.pi
	local cf = CFrame.new(pos + Vector3.new(0, 0.9, 0)) * CFrame.Angles(0, a, 0)
	local logPart = part(parent, Vector3.new(7, 1.8, 1.8), cf, Color3.fromRGB(115, 78, 48), Enum.Material.Wood)
	logPart.Shape = Enum.PartType.Cylinder
	logPart.CanCollide = true
	for _, x in ipairs({ -3.52, 3.52 }) do
		local cap = part(parent, Vector3.new(0.05, 1.6, 1.6), cf * CFrame.new(x, 0, 0), Color3.fromRGB(215, 180, 130), Enum.Material.Wood)
		cap.Shape = Enum.PartType.Cylinder
	end
	ball(parent, Vector3.new(1.2, 0.5, 1.2), cf * CFrame.new(1, 1, 0), Color3.fromRGB(230, 60, 50))
	ball(parent, Vector3.new(0.25, 0.25, 0.25), cf * CFrame.new(1.2, 1.25, 0.2), Color3.new(1, 1, 1))
end

function Models.mushroom(parent: Instance, pos: Vector3)
	local h = 0.6 + math.random() * 0.6
	cylinder(parent, h, 0.4, CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(250, 240, 220))
	ball(parent, Vector3.new(1.3, 0.7, 1.3), CFrame.new(pos + Vector3.new(0, h + 0.1, 0)), Color3.fromRGB(230, 60, 50))
	ball(parent, Vector3.new(0.25, 0.15, 0.25), CFrame.new(pos + Vector3.new(0.3, h + 0.42, 0.1)), Color3.new(1, 1, 1))
	ball(parent, Vector3.new(0.2, 0.12, 0.2), CFrame.new(pos + Vector3.new(-0.25, h + 0.4, -0.2)), Color3.new(1, 1, 1))
end

function Models.fern(parent: Instance, pos: Vector3)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		part(parent, Vector3.new(0.9, 0.15, 3.2), CFrame.new(pos + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, a, 0) * CFrame.Angles(math.rad(-30), 0, 0) * CFrame.new(0, 0, -1.4), LEAVES[i % 4 + 1], Enum.Material.LeafyGrass)
	end
end

function Models.crystal(parent: Instance, pos: Vector3)
	for i = 1, 3 do
		local h = 4 - i
		part(parent, Vector3.new(0.9, h, 0.9), CFrame.new(pos + Vector3.new((i - 2) * 0.8, h / 2, (i % 2) * 0.5)) * CFrame.Angles(math.rad((i - 2) * 12), math.rad(45), math.rad((i - 2) * 10)), Color3.fromRGB(150, 220, 255), Enum.Material.Glass).Transparency = 0.2
	end
	local glow = part(parent, Vector3.new(0.5, 0.5, 0.5), CFrame.new(pos + Vector3.new(0, 1, 0)), Color3.fromRGB(150, 220, 255), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(150, 220, 255)
	light.Range = 10
	light.Parent = glow
end

-- флажок на границе круга
function Models.flag(parent: Instance, pos: Vector3, color: Color3)
	part(parent, Vector3.new(0.2, 3, 0.2), CFrame.new(pos + Vector3.new(0, 1.5, 0)), Color3.fromRGB(240, 240, 240))
	part(parent, Vector3.new(0.08, 0.8, 1.2), CFrame.new(pos + Vector3.new(0, 2.6, 0.6)), color)
	ball(parent, Vector3.new(0.35, 0.35, 0.35), CFrame.new(pos + Vector3.new(0, 3.1, 0)), Color3.fromRGB(255, 220, 90))
end

function Models.lamp(parent: Instance, pos: Vector3)
	local dark = Color3.fromRGB(45, 50, 60)
	cylinder(parent, 0.6, 1.6, CFrame.new(pos + Vector3.new(0, 0.3, 0)), dark, Enum.Material.Metal)
	local pole = cylinder(parent, 9, 0.5, CFrame.new(pos + Vector3.new(0, 4.8, 0)), dark, Enum.Material.Metal)
	pole.CanCollide = true
	local bulb = ball(parent, Vector3.new(1.6, 1.6, 1.6), CFrame.new(pos + Vector3.new(0, 9.8, 0)), Color3.fromRGB(255, 230, 160), Enum.Material.Neon)
	part(parent, Vector3.new(1.9, 0.3, 1.9), CFrame.new(pos + Vector3.new(0, 10.7, 0)), dark, Enum.Material.Metal)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 150)
	light.Range = 22
	light.Brightness = 1.5
	light.Shadows = false
	light.Parent = bulb
end

function Models.bench(parent: Instance, cf: CFrame)
	local wood = Color3.fromRGB(160, 110, 65)
	for i = 0, 2 do
		part(parent, Vector3.new(6, 0.25, 0.55), cf * CFrame.new(0, 1.6, -0.6 + i * 0.62), wood, Enum.Material.Wood).CanCollide = true
	end
	for i = 0, 1 do
		part(parent, Vector3.new(6, 0.5, 0.25), cf * CFrame.new(0, 2.4 + i * 0.7, 0.85), wood, Enum.Material.Wood).CanCollide = true
	end
	for _, x in ipairs({ -2.6, 2.6 }) do
		part(parent, Vector3.new(0.3, 3.4, 2), cf * CFrame.new(x, 1.5, 0.1), Color3.fromRGB(45, 50, 60), Enum.Material.Metal)
	end
end

-- тележка со сладкой ватой
function Models.candyCart(parent: Instance, cf: CFrame)
	local m = Instance.new("Model")
	m.Name = "CandyCart"
	local cart = part(m, Vector3.new(6, 3, 3.4), cf * CFrame.new(0, 2.2, 0), Color3.fromRGB(255, 160, 200))
	cart.CanCollide = true
	part(m, Vector3.new(6.2, 0.3, 3.6), cf * CFrame.new(0, 3.85, 0), Color3.new(1, 1, 1))
	for _, x in ipairs({ -2.2, 2.2 }) do
		local w = part(m, Vector3.new(0.4, 1.6, 1.6), cf * CFrame.new(x, 0.8, 1.8) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(60, 60, 70))
		w.Shape = Enum.PartType.Cylinder
	end
	cylinder(m, 7, 0.3, cf * CFrame.new(0, 7.5, 0), Color3.new(1, 1, 1))
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		part(m, Vector3.new(2.6, 0.2, 4.6), cf * CFrame.new(0, 10.6, 0) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -2) * CFrame.Angles(math.rad(-20), 0, 0), i % 2 == 0 and Color3.fromRGB(255, 120, 170) or Color3.new(1, 1, 1))
	end
	for i, c in ipairs({ Color3.fromRGB(255, 170, 210), Color3.fromRGB(170, 210, 255), Color3.fromRGB(255, 240, 160) }) do
		local x = (i - 2) * 1.8
		part(m, Vector3.new(0.15, 1.4, 0.15), cf * CFrame.new(x, 4.6, 0), Color3.new(1, 1, 1))
		ball(m, Vector3.new(1.4, 1.6, 1.4), cf * CFrame.new(x, 5.8, 0), c)
	end
	Models.label(cart, "🍭 Сладкая вата", 7, Color3.fromRGB(255, 190, 230), 60)
	m.Parent = parent
end

function Models.snowman(parent: Instance, pos: Vector3)
	local m = Instance.new("Model")
	m.Name = "Snowman"
	ball(m, Vector3.new(4, 4, 4), CFrame.new(pos + Vector3.new(0, 2, 0)), Color3.new(1, 1, 1))
	ball(m, Vector3.new(3, 3, 3), CFrame.new(pos + Vector3.new(0, 5, 0)), Color3.new(1, 1, 1))
	ball(m, Vector3.new(2.2, 2.2, 2.2), CFrame.new(pos + Vector3.new(0, 7.3, 0)), Color3.new(1, 1, 1))
	part(m, Vector3.new(0.3, 0.3, 1.2), CFrame.new(pos + Vector3.new(0, 7.3, -1.3)), Color3.fromRGB(245, 140, 40))
	m.Parent = parent
end

function Models.pumpkin(parent: Instance, pos: Vector3)
	local p = ball(parent, Vector3.new(3, 2.4, 3), CFrame.new(pos + Vector3.new(0, 1.2, 0)), Color3.fromRGB(240, 130, 30))
	part(parent, Vector3.new(0.4, 0.8, 0.4), CFrame.new(pos + Vector3.new(0, 2.6, 0)), Color3.fromRGB(60, 120, 40))
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 160, 60)
	light.Range = 10
	light.Parent = p
end

function Models.lava(parent: Instance, pos: Vector3, radius: number): Part
	local p = cylinder(parent, 0.3, radius * 2, CFrame.new(pos + Vector3.new(0, 0.12, 0)), Color3.fromRGB(255, 100, 20), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 40)
	light.Range = radius * 2
	light.Parent = p
	return p
end

-- ---------- бонусы на поле ----------
function Models.powerup(kind: string, pos: Vector3, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = "PowerUp_" .. kind
	local main: Part
	if kind == "banana" then
		local yellow = Color3.fromRGB(250, 220, 60)
		main = ball(m, Vector3.new(0.9, 0.9, 3), CFrame.new(pos), yellow)
		ball(m, Vector3.new(0.8, 0.8, 1.6), CFrame.new(pos + Vector3.new(0, 0.5, -1.4)) * CFrame.Angles(math.rad(-30), 0, 0), yellow)
		ball(m, Vector3.new(0.8, 0.8, 1.6), CFrame.new(pos + Vector3.new(0, 0.5, 1.4)) * CFrame.Angles(math.rad(30), 0, 0), yellow)
	elseif kind == "star" then
		main = part(m, Vector3.new(2, 2, 2), CFrame.new(pos) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color3.fromRGB(255, 215, 40), Enum.Material.Neon)
		local sp = Instance.new("Sparkles")
		sp.Parent = main
	else
		main = cylinder(m, 0.5, 2.6, CFrame.new(pos + Vector3.new(0, 0.9, 0)), Color3.fromRGB(230, 60, 60))
		for i = 0, 3 do
			cylinder(m, 0.2, 1.8, CFrame.new(pos + Vector3.new(0, -0.6 + i * 0.4, 0)), Color3.fromRGB(180, 180, 190), Enum.Material.Metal)
		end
	end
	local light = Instance.new("PointLight")
	light.Range = 8
	light.Parent = main
	m.PrimaryPart = main
	m.Parent = parent
	return m
end

-- ---------- гнездо, кубок ----------
function Models.nest(parent: Instance, pos: Vector3): (Model, ProximityPrompt)
	local m = Instance.new("Model")
	m.Name = "Nest"
	local brown = Color3.fromRGB(140, 100, 55)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local p = part(m, Vector3.new(1, 1, 2.6), CFrame.new(pos + Vector3.new(math.cos(a) * 3, 0.6, math.sin(a) * 3)) * CFrame.Angles(0, -a, math.rad(20)), brown, Enum.Material.Wood)
		p.CanCollide = true
	end
	local center = cylinder(m, 0.4, 5, CFrame.new(pos + Vector3.new(0, 0.3, 0)), brown:Lerp(Color3.new(0, 0, 0), 0.2), Enum.Material.Wood)
	ball(m, Vector3.new(1.4, 1.9, 1.4), CFrame.new(pos + Vector3.new(0, 1.3, 0)), WHITE)
	Models.label(center, "🐣 Гнездо", 4, Color3.fromRGB(255, 230, 120), 80)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Вылупить яйцо"
	prompt.ObjectText = "Гнездо"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = center
	m.Parent = parent
	return m, prompt
end

function Models.trophy(parent: Instance, text: string): Model
	local gold = Color3.fromRGB(242, 184, 34)
	local cup = Instance.new("Model")
	cup.Name = "Trophy"
	local base = part(cup, Vector3.new(6, 1, 6), CFrame.new(0, 10, 0), Color3.fromRGB(31, 42, 23))
	cylinder(cup, 4, 1.2, CFrame.new(0, 12.5, 0), gold, Enum.Material.Foil)
	local bowl = cylinder(cup, 5, 6, CFrame.new(0, 17, 0), gold, Enum.Material.Foil)
	for _, x in ipairs({ -3.6, 3.6 }) do
		part(cup, Vector3.new(1, 3, 1), CFrame.new(x, 17, 0), gold, Enum.Material.Foil)
	end
	local light = Instance.new("PointLight")
	light.Color = gold
	light.Range = 30
	light.Brightness = 3
	light.Parent = bowl
	Models.label(bowl, text, 6, gold, 300)
	cup.PrimaryPart = base
	cup.Parent = parent
	return cup
end

return Models
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Связь сервера с экраном игрока.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = Instance.new("Folder")
folder.Name = "DinoRemotes"

Net.Request = Instance.new("RemoteFunction")
Net.Request.Name = "Request"
Net.Request.Parent = folder

Net.Notify = Instance.new("RemoteEvent")
Net.Notify.Name = "Notify"
Net.Notify.Parent = folder

folder.Parent = ReplicatedStorage
Net.folder = folder

function Net.send(player: Player, kind: string, payload: any?)
	Net.Notify:FireClient(player, kind, payload)
end

function Net.all(kind: string, payload: any?)
	Net.Notify:FireAllClients(kind, payload)
end

-- маленькое сообщение внизу экрана
function Net.toast(player: Player, text: string)
	Net.send(player, "toast", text)
end

-- большая надпись посередине для всех
function Net.big(text: string, seconds: number?, voice: string?)
	Net.all("big", { text = text, seconds = seconds or 2.5 })
	if voice then
		Net.all("voice", voice)
	end
end

function Net.sound(player: Player?, name: string)
	if player then
		Net.send(player, "sound", name)
	else
		Net.all("sound", name)
	end
end

-- общие значения для табло: время, очки, карта
function Net.set(key: string, value: any)
	folder:SetAttribute(key, value)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">Progress</string>
          <string name="Source"><![CDATA[-- Монетки, яйца, питомцы, магазин, подарки, колесо удачи, коды и значки.
local Players = game:GetService("Players")
local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("DinoShared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Net = require(script.Parent.Net)

local Progress = {}
Progress.event = "none"
-- Main подставляет сюда функцию, которая заново надевает костюм и питомца
Progress.onLooksChanged = function(_player: Player) end

-- Если создашь настоящие значки Roblox (Creator Hub → Badges), впиши их номера сюда:
-- например first_egg = 1234567890. Без номеров значки всё равно работают внутри игры.
local ROBLOX_BADGE_IDS: { [string]: number } = {}

local DAY = 20 * 3600 -- подарок и колесо можно брать раз в 20 часов
local STREAK_BREAK = 48 * 3600

-- секретные коды; один код можно ввести один раз
local CODES = {}
local function code(names: { string }, reward)
	for _, n in ipairs(names) do
		CODES[n] = { id = names[1], reward = reward }
	end
end
code({ "DINO", "ДИНО", "Дино", "дино" }, { coins = 50 })
code({ "EGG", "ЯЙЦО", "Яйцо", "яйцо" }, { egg = "normal" })
code({ "RAINBOW", "РАДУГА", "Радуга", "радуга" }, { item = "trail_rainbow" })
code({ "ROAR", "РЫК", "Рык", "рык" }, { coins = 100 })
code({ "GOLD", "ЗОЛОТО", "Золото", "золото" }, { egg = "gold" })

local function pickWeighted(list: { any }, weightOf: (any) -> number)
	local total = 0
	for _, v in ipairs(list) do
		total += weightOf(v)
	end
	local r = math.random() * total
	for i, v in ipairs(list) do
		r -= weightOf(v)
		if r <= 0 then
			return v, i
		end
	end
	return list[#list], #list
end

function Progress.petKind(player: Player): string?
	local p = Data.get(player)
	if not p or p.equippedPet == 0 then
		return nil
	end
	for _, pet in ipairs(p.pets) do
		if pet.id == p.equippedPet then
			return pet.kind
		end
	end
	return nil
end

function Progress.view(player: Player)
	local p = Data.get(player)
	if not p then
		return nil
	end
	local now = os.time()
	local dailyReady = now - p.dailyLast >= DAY
	local nextStreak = (now - p.dailyLast < STREAK_BREAK) and p.dailyStreak + 1 or 1
	return {
		coins = p.coins,
		eggs = p.eggs,
		pets = p.pets,
		equippedPet = p.equippedPet,
		owned = p.owned,
		equipped = p.equipped,
		badges = p.badges,
		cups = p.cups,
		dailyReady = dailyReady,
		dailyDay = ((dailyReady and nextStreak or p.dailyStreak) - 1) % 7 + 1,
		dailyWait = math.max(0, DAY - (now - p.dailyLast)),
		wheelReady = now - p.wheelLast >= DAY,
		wheelWait = math.max(0, DAY - (now - p.wheelLast)),
		saving = Data.isSaving(player),
		event = Progress.event,
	}
end

function Progress.sync(player: Player)
	local view = Progress.view(player)
	if not view then
		return
	end
	Net.send(player, "data", view)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		local coins = stats:FindFirstChild("Монетки") :: IntValue?
		local cups = stats:FindFirstChild("Кубки") :: IntValue?
		if coins then
			coins.Value = view.coins
		end
		if cups then
			cups.Value = view.cups
		end
	end
end

-- boosted: монетки за игру (их удваивают золотой и радужный питомцы)
function Progress.addCoins(player: Player, amount: number, boosted: boolean?): number
	local p = Data.get(player)
	if not p then
		return 0
	end
	if boosted then
		local pet = Progress.petKind(player)
		if pet == "gold" or pet == "rainbow" then
			amount *= 2
		end
	end
	p.coins += amount
	Progress.sync(player)
	return amount
end

function Progress.badge(player: Player, id: string)
	local p = Data.get(player)
	local b = Config.badge(id)
	if not p or not b or p.badges[id] then
		return
	end
	p.badges[id] = true
	Net.send(player, "badge", b)
	Net.sound(player, "win")
	local robloxId = ROBLOX_BADGE_IDS[id]
	if robloxId then
		task.spawn(pcall, BadgeService.AwardBadge, BadgeService, player.UserId, robloxId)
	end
	Progress.sync(player)
end

function Progress.addEgg(player: Player, kind: string, count: number?)
	local p = Data.get(player)
	if not p then
		return
	end
	p.eggs[kind] = (p.eggs[kind] or 0) + (count or 1)
	Progress.sync(player)
end

local function giveItem(player: Player, itemId: string): boolean
	local p = Data.get(player)
	if p.owned[itemId] then
		return false
	end
	p.owned[itemId] = true
	local item = Config.shopItem(itemId)
	if item and p.equipped[item.slot] ~= nil then
		p.equipped[item.slot] = itemId
		Progress.onLooksChanged(player)
	end
	return true
end

-- вещь в подарок; если она уже есть — +50 монеток вместо неё
local function giveItemOrCoins(player: Player, itemId: string, dupMsg: string): string
	if giveItem(player, itemId) then
		return Config.shopItem(itemId).name .. "!"
	end
	Data.get(player).coins += 50
	return dupMsg
end

-- ---------- действия с экрана игрока ----------

local handlers = {}

function handlers.hatch(player: Player, eggKind: any)
	local p = Data.get(player)
	local egg = Config.EGGS[eggKind]
	if not egg or (p.eggs[eggKind] or 0) <= 0 then
		return { ok = false, msg = "Нет такого яйца. Унеси яйцо с поля!" }
	end
	if #p.pets >= Config.MAX_PETS then
		return { ok = false, msg = "Слишком много питомцев. Отпусти кого-нибудь." }
	end
	local kinds = {}
	for kind, weight in pairs(egg.odds) do
		table.insert(kinds, { kind = kind, weight = weight })
	end
	local pick = pickWeighted(kinds, function(v)
		return v.weight
	end)
	p.eggs[eggKind] -= 1
	local pet = { id = p.nextPetId, kind = pick.kind }
	p.nextPetId += 1
	table.insert(p.pets, pet)
	if p.equippedPet == 0 then
		p.equippedPet = pet.id
		Progress.onLooksChanged(player)
	end
	Progress.badge(player, "first_pet")
	if pick.kind == "gold" or pick.kind == "rainbow" then
		Progress.badge(player, "legendary_pet")
	end
	Progress.sync(player)
	return { ok = true, pet = pick.kind }
end

function handlers.equipPet(player: Player, id: any)
	local p = Data.get(player)
	if id == 0 or p.equippedPet == id then
		p.equippedPet = 0
	else
		for _, pet in ipairs(p.pets) do
			if pet.id == id then
				p.equippedPet = id
			end
		end
	end
	Progress.onLooksChanged(player)
	Progress.sync(player)
	return { ok = true }
end

function handlers.releasePet(player: Player, id: any)
	local p = Data.get(player)
	for i, pet in ipairs(p.pets) do
		if pet.id == id then
			table.remove(p.pets, i)
			if p.equippedPet == id then
				p.equippedPet = 0
				Progress.onLooksChanged(player)
			end
			local coins = Config.PETS[pet.kind].release
			Progress.addCoins(player, coins)
			return { ok = true, msg = "Пока-пока! +" .. coins .. " 🪙" }
		end
	end
	return { ok = false }
end

function handlers.buy(player: Player, itemId: any)
	local p = Data.get(player)
	local item = Config.shopItem(itemId)
	if not item then
		return { ok = false }
	end
	if item.event and item.event ~= Progress.event then
		return { ok = false, msg = "Эта вещь бывает только на праздник" }
	end
	if item.slot ~= "egg" and p.owned[item.id] then
		return { ok = false, msg = "У тебя это уже есть" }
	end
	if p.coins < item.price then
		return { ok = false, msg = "Не хватает монеток. Нужно " .. item.price .. " 🪙" }
	end
	p.coins -= item.price
	if item.slot == "egg" then
		Progress.addEgg(player, item.egg)
	else
		giveItem(player, item.id)
	end
	Net.sound(player, "coin")
	Progress.sync(player)
	return { ok = true, msg = "Куплено: " .. item.name }
end

function handlers.equip(player: Player, itemId: any)
	local p = Data.get(player)
	local item = Config.shopItem(itemId)
	if not item or not p.owned[item.id] or p.equipped[item.slot] == nil then
		return { ok = false }
	end
	p.equipped[item.slot] = (p.equipped[item.slot] == item.id) and "" or item.id
	Progress.onLooksChanged(player)
	Progress.sync(player)
	return { ok = true }
end

function handlers.daily(player: Player)
	local p = Data.get(player)
	local now = os.time()
	if now - p.dailyLast < DAY then
		return { ok = false, msg = "Подарок уже открыт. Приходи завтра!" }
	end
	p.dailyStreak = (now - p.dailyLast < STREAK_BREAK) and p.dailyStreak + 1 or 1
	p.dailyLast = now
	local day = (p.dailyStreak - 1) % 7 + 1
	local coins = Config.DAILY[day]
	p.coins += coins
	local msg = "+" .. coins .. " 🪙"
	if day == 7 then
		p.eggs.normal += 1
		msg ..= " и яйцо 🥚"
	end
	if p.dailyStreak >= 7 then
		Progress.badge(player, "streak7")
	end
	Net.sound(player, "coin")
	Progress.sync(player)
	return { ok = true, day = day, msg = msg }
end

function handlers.spin(player: Player)
	local p = Data.get(player)
	local now = os.time()
	if now - p.wheelLast < DAY then
		return { ok = false, msg = "Колесо уже крутили. Приходи завтра!" }
	end
	p.wheelLast = now
	local seg, index = pickWeighted(Config.WHEEL, function(v)
		return v.weight
	end)
	local msg
	if seg.kind == "coins" then
		p.coins += seg.amount
		msg = "+" .. seg.amount .. " 🪙"
	elseif seg.kind == "egg" then
		p.eggs[seg.egg] += 1
		msg = Config.EGGS[seg.egg].name .. " " .. Config.EGGS[seg.egg].icon
		if seg.egg == "rainbow" then
			Progress.badge(player, "rainbow_egg")
		end
	else
		msg = giveItemOrCoins(player, seg.item, "У тебя это уже есть, держи +50 🪙")
	end
	Progress.sync(player)
	return { ok = true, index = index, msg = msg }
end

function handlers.code(player: Player, text: any)
	if type(text) ~= "string" then
		return { ok = false, msg = "Введи код" }
	end
	text = text:gsub("%s", "")
	local entry = CODES[text] or CODES[text:upper()]
	if not entry then
		return { ok = false, msg = "Такого кода нет 🤔" }
	end
	local p = Data.get(player)
	if p.codes[entry.id] then
		return { ok = false, msg = "Этот код ты уже вводил" }
	end
	p.codes[entry.id] = true
	local r = entry.reward
	local msg
	if r.coins then
		p.coins += r.coins
		msg = "+" .. r.coins .. " 🪙"
	elseif r.egg then
		p.eggs[r.egg] += 1
		msg = Config.EGGS[r.egg].name .. " " .. Config.EGGS[r.egg].icon
	elseif r.item then
		msg = giveItemOrCoins(player, r.item, "+50 🪙")
	end
	Net.sound(player, "coin")
	Progress.sync(player)
	return { ok = true, msg = "Код сработал: " .. msg }
end

function handlers.getData(player: Player)
	return Progress.view(player)
end

function Progress.handle(player: Player, action: any, arg: any)
	local h = handlers[action]
	if not h or not Data.get(player) then
		return { ok = false }
	end
	return h(player, arg)
end

Players.PlayerRemoving:Connect(function(player)
	Data.release(player)
end)

return Progress
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="68">
      <Properties>
        <string name="Name">ServerPackages</string>
      </Properties>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source">--[[
MAD STUDIO (by loleris)

-[ProfileStore]---------------------------------------

	Periodic DataStore saving solution with session locking
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to store such tables will result in an error.
		! Do not create mixed tables (some values indexed by number and others by a string key)
			- only numerically indexed  data will be stored.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	Members:
	
		ProfileStore.IsClosing          [bool]
			-- Set to true after a game:BindToClose() trigger
			
		ProfileStore.IsCriticalState    [bool]
			-- Set to true when ProfileStore experiences too many consecutive errors
		
		ProfileStore.OnError            [Signal] (message, store_name, profile_key)
			-- Most ProfileStore errors will be caught and passed to this signal
			
		ProfileStore.OnOverwrite        [Signal] (store_name, profile_key)
			-- Triggered when a DataStore key was likely used to store data that wasn't
			a ProfileStore profile or the ProfileStore structure was invalidly manually
			altered for that DataStore key
			
		ProfileStore.OnCriticalToggle   [Signal] (is_critical)
			-- Triggered when ProfileStore experiences too many consecutive errors
		
		ProfileStore.DataStoreState     [string] ("NotReady", "NoInternet", "NoAccess", "Access")
			-- This value resembles ProfileStore's access to the DataStore; The value starts
			as "NotReady" and will eventually change to one of the other 3 possible values.
	
	Functions:
	
		ProfileStore.New(store_name, template?) --> [ProfileStore]
			store_name   [string] -- DataStore name
			template     [table] or nil -- Profiles will default to given table (hard-copy) when no data was saved previously
			
		ProfileStore.SetConstant(name, value)
			name    [string]
			value   [number]
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore]
			-- Reflection of ProfileStore methods, but the methods will now query a mock
			DataStore with no relation to the real DataStore
			
		ProfileStore.Name   [string]
		
	Methods [ProfileStore]:
	
		ProfileStore:StartSessionAsync(profile_key, params?) --> [Profile] or nil
			profile_key [string] -- DataStore key
			params      nil or [table]: -- Custom params; E.g. {Steal = true}
				{
					Steal = true, -- Pass this to disregard an existing session lock
					Cancel = fn() -> (boolean), -- Pass this to create a request cancel condition.
						-- If the cancel function returns true, ProfileStore will stop trying to
						-- start the session and return nil
				}
			
		ProfileStore:MessageAsync(profile_key, message) --> is_success [bool]
			profile_key [string] -- DataStore key
			message     [table] -- Data to be messaged to the profile
			
		ProfileStore:GetAsync(profile_key, version?) --> [Profile] or nil
			-- Reads a profile without starting a session - will not autosave
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:VersionQuery(profile_key, sort_direction?, min_date?, max_date?) --> [VersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:RemoveAsync(profile_key) --> is_success [bool]
			-- Completely removes profile data from the DataStore / mock DataStore with no way to recover it.

	Methods [VersionQuery]:

		VersionQuery:NextAsync() --> [Profile] or nil -- (Yields)
			-- Returned profile is similar to profiles returned by ProfileStore:GetAsync()
		
	Members [Profile]:
	
		Profile.Data               [table]
			-- When the profile is active changes to this table are guaranteed to be saved
		Profile.LastSavedData      [table] (Read-only)
			-- Last snapshot of "Profile.Data" that has been successfully saved to the DataStore;
			Useful for proper developer product purchase receipt handling
		
		Profile.FirstSessionTime   [number] (Read-only)
			-- os.time() timestamp of the first profile session
			
		Profile.SessionLoadCount   [number] (Read-only) -- Amount of times a session was started for this profile
			
		Profile.Session            [table] (Read-only) {PlaceId = number, JobId = string} / nil
			-- Set to a table if this profile is in use by a server; nil if released

		Profile.RobloxMetaData     [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds            [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo            [DataStoreKeyInfo] -- Changes before OnAfterSave signal
		
		Profile.OnSave             [Signal] ()
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			
		Profile.OnLastSave         [Signal] (reason [string]: "Manual", "External", "Shutdown")
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			for the last time; A reason is provided for the last save:
				- "Manual"   - Profile:EndSession() was called
				- "Shutdown" - The server that has ownership of this profile is shutting down
				- "External" - Another server has started a session for this profile
			Note that this event will not trigger for when a profile session is ended by
			another server trying to take ownership of the session - this is impossible to
			do without compromising on ProfileStore's speed.
			
		Profile.OnSessionEnd       [Signal] ()
			-- Triggered when the profile session is terminated on this server
		
		Profile.OnAfterSave        [Signal] (last_saved_data)
			-- Triggered after a successful save
			last_saved_data [table] -- Profile.LastSavedData
			
		Profile.ProfileStore       [ProfileStore] -- ProfileStore object this profile belongs to
		Profile.Key                [string] -- DataStore key
		
	Methods [Profile]:
	
		Profile:IsActive() --> [bool] -- If "true" is returned, changes to Profile.Data are guaranteed to save;
			This guarantee is only valid until code yields (e.g. task.wait() is used).
			
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
			from the "template" argument that was passed to "ProfileStore.New()"
			
		Profile:EndSession() -- Call after the server has finished working with this profile
			e.g., after the player leaves (Profile object will become inactive)

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)
			user_id   [number]
			
		Profile:MessageHandler(fn) -- Sets a message handler for this profile
			fn [function] (message [table], processed [function]())
			-- The handler function receives a message table and a callback function;
			The callback function is to be called when a message has been processed
			- this will discard the message from the profile message cache; If the
			callback function is not called, other message handlers will also be triggered
			with unprocessed message data.
			
		Profile:Save() -- If the profile session is still active makes an UpdateAsync call
			to the DataStore to immediately save profile data

		Profile:SetAsync() -- Forcefully saves changes to the profile; Only for profiles
			loaded with ProfileStore:GetAsync() or ProfileStore:VersionQuery()
		
--]]

local AUTO_SAVE_PERIOD = 300 -- (Seconds) Time between when changes to a profile are saved to the DataStore
local LOAD_REPEAT_PERIOD = 10 -- (Seconds) Time between successive profile reads when handling a session conflict
local FIRST_LOAD_REPEAT = 5 -- (Seconds) Time between first and second profile read when handling a session conflict
local SESSION_STEAL = 40 -- (Seconds) Time until a session conflict is resolved with the waiting server stealing the session
local ASSUME_DEAD = 630 -- (Seconds) If a profile hasn't had updates for this long, quickly assume an active session belongs to a crashed server
local START_SESSION_TIMEOUT = 120 -- (Seconds) If a session can't be started for a profile for this long, stop repeating calls to the DataStore

local CRITICAL_STATE_ERROR_COUNT = 5 -- Assume critical state if this many issues happen in a short amount of time
local CRITICAL_STATE_ERROR_EXPIRE = 120 -- (Seconds) Individual issue expiration
local CRITICAL_STATE_EXPIRE = 120 -- (Seconds) Critical state expiration

local MAX_MESSAGE_QUEUE = 1000 -- Max messages saved in a profile that were sent using "ProfileStore:MessageAsync()"

----- Dependencies -----

-- local Util = require(game.ReplicatedStorage.Shared.Util)
-- local Signal = Util.Signal

local Signal do

	local FreeRunnerThread

	--[[
		Yield-safe coroutine reusing by stravant;
		Sources:
		https://devforum.roblox.com/t/lua-signal-class-comparison-optimal-goodsignal-class/1387063
		https://gist.github.com/stravant/b75a322e0919d60dde8a0316d1f09d2f
	--]]

	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		-- The handler finished running, this runner thread is free again.
		FreeRunnerThread = acquired_runner_thread
	end

	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end

	local Connection = {}
	Connection.__index = Connection

	local SignalClass = {}
	SignalClass.__index = SignalClass

	function Connection:Disconnect()

		if self.is_connected == false then
			return
		end

		local signal = self.signal
		self.is_connected = false
		signal.listener_count -= 1

		if signal.head == self then
			signal.head = self.next
		else
			local prev = signal.head
			while prev ~= nil and prev.next ~= self do
				prev = prev.next
			end
			if prev ~= nil then
				prev.next = self.next
			end
		end

	end

	function SignalClass.New()

		local self = {
			head = nil,
			listener_count = 0,
		}
		setmetatable(self, SignalClass)

		return self

	end

	function SignalClass:Connect(listener: (...any) -> ())

		if type(listener) ~= "function" then
			error(`[{script.Name}]: \"listener\" must be a function; Received {typeof(listener)}`)
		end

		local connection = {
			listener = listener,
			signal = self,
			next = self.head,
			is_connected = true,
		}
		setmetatable(connection, Connection)

		self.head = connection
		self.listener_count += 1

		return connection

	end

	function SignalClass:GetListenerCount(): number
		return self.listener_count
	end

	function SignalClass:Fire(...)
		local item = self.head
		while item ~= nil do
			if item.is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item.listener, ...)
			end
			item = item.next
		end
	end

	function SignalClass:Wait()
		local co = coroutine.running()
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(co, ...)
		end)
		return coroutine.yield()
	end

	Signal = table.freeze({
		New = SignalClass.New,
	})

end

----- Private -----

local ActiveSessionCheck = {} -- {[session_token] = profile, ...}
local AutoSaveList = {} -- {profile, ...} -- Loaded profile table which will be circularly auto-saved
local IssueQueue = {} -- {issue_time, ...}

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access" = "NotReady"

local MockStore = {}
local UserMockStore = {}
local MockFlag = false

local OnError = Signal.New() -- (message, store_name, profile_key)
local OnOverwrite = Signal.New() -- (store_name, profile_key)

local UpdateQueue = { -- For stability sake, we won't do UpdateAsync calls for the same key until all previous calls finish
	--[[
		[session_token] = {
			coroutine, ...
		},
		...
	--]]
}

local function WaitInUpdateQueue(session_token) --> next_in_queue()

	local is_first = false

	if UpdateQueue[session_token] == nil then
		is_first = true
		UpdateQueue[session_token] = {}
	end

	local queue = UpdateQueue[session_token]

	if is_first == false then
		table.insert(queue, coroutine.running())
		coroutine.yield()
	end

	return function()
		local next_co = table.remove(queue, 1)
		if next_co ~= nil then
			coroutine.resume(next_co)
		else
			UpdateQueue[session_token] = nil
		end
	end

end

local function SessionToken(store_name, profile_key, is_mock)

	local session_token = "L_" -- Live

	if is_mock == true then
		session_token = "U_" -- User mock
	elseif DataStoreState ~= "Access" then
		session_token = "M_" -- Mock, cause no DataStore access
	end

	session_token ..= store_name .. "\0" .. profile_key

	return session_token

end

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

local function RegisterError(error_message, store_name, profile_key) -- Called when a DataStore API call errors
	warn(`[{script.Name}]: DataStore API error (STORE:{store_name}; KEY:{profile_key}) - {tostring(error_message)}`)
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	OnError:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterOverwrite(store_name, profile_key) -- Called when a corrupted profile is loaded
	warn(`[{script.Name}]: Invalid profile was overwritten (STORE:{store_name}; KEY:{profile_key})`)
	OnOverwrite:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)

	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16) .. "."
			.. string.rep("0", 10 - string.len(version_id_string)) .. version_id_string
			.. "." .. string.rep("0", 16) .. "." .. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}

end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --> loaded_data, key_info

	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = DeepCopyTable(transform)
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end

end

local function UpdateAsync(profile_store, profile_key, transform_params, is_user_mock, is_get_call, version) --> loaded_data, key_info
	--transform_params = {
	--	ExistingProfileHandle = function(latest_data),
	--	MissingProfileHandle = function(latest_data),
	--	EditProfile = function(latest_data),
	--}

	local loaded_data, key_info
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(profile_store.Name, profile_key, is_user_mock))

	local success = true

	local success, error_message = pcall(function()
		local transform_function = function(latest_data)

			local missing_profile = false
			local overwritten = false
			local global_updates = {0, {}}

			if latest_data == nil then

				missing_profile = true

			elseif type(latest_data) ~= "table" then

				missing_profile = true
				overwritten = true

			else

				if type(latest_data.Data) == "table" and type(latest_data.MetaData) == "table" and type(latest_data.GlobalUpdates) == "table" then

					-- Regular profile structure detected:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates

					if transform_params.ExistingProfileHandle ~= nil then
						transform_params.ExistingProfileHandle(latest_data)
					end

				elseif latest_data.Data == nil and latest_data.MetaData == nil and type(latest_data.GlobalUpdates) == "table" then

					-- Regular structure not detected, but GlobalUpdate data exists:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates or global_updates
					missing_profile = true

				else

					missing_profile = true
					overwritten = true

				end

			end

			-- Profile was not created or corrupted and no GlobalUpdate data exists:
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates,
				}
				if transform_params.MissingProfileHandle ~= nil then
					transform_params.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if transform_params.EditProfile ~= nil then
				transform_params.EditProfile(latest_data)
			end

			-- Invalid data handling (Silently override with empty profile)
			if overwritten == true then
				latest_data.WasOverwritten = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end

		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

			loaded_data, key_info = MockUpdateAsync(UserMockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		elseif DataStoreState ~= "Access" then -- Used when API access is disabled

			loaded_data, key_info = MockUpdateAsync(MockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		else

			if is_get_call == true then

				if version ~= nil then

					local success, error_message = pcall(function()
						loaded_data, key_info = profile_store.data_store:GetVersionAsync(profile_key, version)
					end)

					if success == false and type(error_message) == "string" and string.find(error_message, "not valid") ~= nil then
						warn(`[{script.Name}]: Passed version argument is not valid; Traceback:\n` .. debug.traceback())
					end

				else

					loaded_data, key_info = profile_store.data_store:GetAsync(profile_key)

				end

				loaded_data = transform_function(loaded_data)

			else

				loaded_data, key_info = profile_store.data_store:UpdateAsync(profile_key, transform_function)

			end

		end

	end)

	next_in_queue()

	if success == true and type(loaded_data) == "table" then
		-- Invalid data handling:
		if loaded_data.WasOverwritten == true and is_get_call ~= true then
			RegisterOverwrite(
				profile_store.Name,
				profile_key
			)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		-- Error handling:
		RegisterError(
			error_message or "Undefined error",
			profile_store.Name,
			profile_key
		)
		-- Return nothing:
		return nil
	end

end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

local function ReadMockFlag(): boolean
	local is_mock = MockFlag
	MockFlag = false
	return is_mock
end

local function WaitForStoreReady(profile_store)
	while profile_store.is_ready == false do
		task.wait()
	end
end

local function AddProfileToAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = profile

	-- Add at AutoSaveIndex and move AutoSaveIndex right:

	table.insert(AutoSaveList, AutoSaveIndex, profile)

	if #AutoSaveList > 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end

end

local function RemoveProfileFromAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = nil

	local auto_save_index = table.find(AutoSaveList, profile)

	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index &lt; AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end

end

local function SaveProfileAsync(profile, is_ending_session, is_overwriting, last_save_reason)

	if type(profile.Data) ~= "table" then
		error(`[{script.Name}]: Developer code likely set "Profile.Data" to a non-table value! (STORE:{profile.ProfileStore.Name}; KEY:{profile.Key})`)
	end

	profile.OnSave:Fire()
	if is_ending_session == true then
		profile.OnLastSave:Fire(last_save_reason or "Manual")
	end

	if is_ending_session == true and is_overwriting ~= true then
		if profile.roblox_message_subscription ~= nil then
			profile.roblox_message_subscription:Disconnect()
		end
		RemoveProfileFromAutoSave(profile)
		profile.OnSessionEnd:Fire()
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1

	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again

	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	local exp_backoff = 1

	while repeat_save_flag == true do

		if is_ending_session ~= true then
			repeat_save_flag = false
		end

		local loaded_data, key_info = UpdateAsync(
			profile.ProfileStore,
			profile.Key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)
					
					-- Check if this session still owns the profile:

					local session_owns_profile = false

					if is_overwriting ~= true then

						local active_session = latest_data.MetaData.ActiveSession
						local session_load_count = latest_data.MetaData.SessionLoadCount

						if type(active_session) == "table" then
							session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
						end

					else
						session_owns_profile = true
					end

					-- We may only edit the profile if this server has ownership of the profile:

					if session_owns_profile == true then

						-- Clear processed updates (messages):

						local locked_updates = profile.locked_global_updates -- [index] = true, ...
						local active_updates = latest_data.GlobalUpdates[2]
						-- ProfileService module format: {{update_id, version_id, update_locked, update_data}, ...}
						-- ProfileStore module format: {{update_id, update_data}, ...}

						if next(locked_updates) ~= nil then
							local i = 1
							while i &lt;= #active_updates do
								local update = active_updates[i]
								if locked_updates[update[1]] == true then
									table.remove(active_updates, i)
								else
									i += 1
								end
							end
						end

						-- Save profile data:

						latest_data.Data = profile.Data
						latest_data.RobloxMetaData = profile.RobloxMetaData
						latest_data.UserIds = profile.UserIds

						if is_overwriting ~= true then

							latest_data.MetaData.LastUpdate = os.time()

							if is_ending_session == true then
								latest_data.MetaData.ActiveSession = nil
							end

						else

							latest_data.MetaData.ActiveSession = nil
							latest_data.MetaData.ForceLoadSession = nil

						end

					end

				end,
			},
			profile.is_mock
		)

		if loaded_data ~= nil and key_info ~= nil then

			if is_overwriting == true then
				break
			end
			
			repeat_save_flag = false
			
			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false

			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
			end
			
			local force_load_session = loaded_data.MetaData.ForceLoadSession
			local force_load_pending = false
			if type(force_load_session) == "table" then
				force_load_pending = not IsThisSession(force_load_session)
			end
			
			local is_active = profile:IsActive()
			
			-- If another server is trying to start a session for this profile - end the session:

			if force_load_pending == true and session_owns_profile == true then
				if is_active == true then
					SaveProfileAsync(profile, true, false, "External")
				end
				break
			end
			
			-- Clearing processed update list / Detecting new updates:

			local locked_updates = profile.locked_global_updates -- [index] = true, ...
			local received_updates = profile.received_global_updates -- [index] = true, ...
			local active_updates = loaded_data.GlobalUpdates[2]

			local new_updates = {} -- {}, ...
			local still_pending = {} -- [index] = true, ...

			for _, update in ipairs(active_updates) do
				if locked_updates[update[1]] == true then
					still_pending[update[1]] = true
				elseif received_updates[update[1]] ~= true then
					received_updates[update[1]] = true
					table.insert(new_updates, update)
				end
			end

			for index in pairs(locked_updates) do
				if still_pending[index] ~= true then
					locked_updates[index] = nil
				end
			end

			-- Updating profile values:

			profile.KeyInfo = key_info
			profile.LastSavedData = loaded_data.Data
			profile.global_updates = loaded_data.GlobalUpdates and loaded_data.GlobalUpdates[2] or {}

			if session_owns_profile == true then
				if is_active == true and is_ending_session ~= true then

					-- Processing new global updates (messages):

					for _, update in ipairs(new_updates) do

						local index = update[1]
						local update_data = update[#update] -- Backwards compatibility with ProfileService

						for _, handler in ipairs(profile.message_handlers) do

							local is_processed = false
							local processed_callback = function()
								is_processed = true
								locked_updates[index] = true
							end
							
							local send_update_data = DeepCopyTable(update_data)

							task.spawn(handler, send_update_data, processed_callback)

							if is_processed == true then
								break
							end

						end

					end

				end
			else
				
				if profile.roblox_message_subscription ~= nil then
					profile.roblox_message_subscription:Disconnect()
				end

				if is_active == true then
					RemoveProfileFromAutoSave(profile)
					profile.OnSessionEnd:Fire()
				end

			end

			profile.OnAfterSave:Fire(profile.LastSavedData)

		elseif repeat_save_flag == true then
			
			-- DataStore call likely resulted in an error; Repeat the DataStore call shortly
			task.wait(exp_backoff)
			exp_backoff = math.min(if last_save_reason == "Shutdown" then 8 else 20, exp_backoff * 2)

		end

	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1

end

----- Public -----

--[[
	Saved profile structure:
	
	{
		Data = {},
		
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id, unique_session_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			LastUpdate = 0, -- os.time()
			MetaTags = {}, -- Backwards compatibility with ProfileService
		},
		
		RobloxMetaData = {},
		UserIds = {},
		
		GlobalUpdates = {
			update_index,
			{
				{update_index, data}, ...
			},
		},
	}

--]]

export type JSONAcceptable = { JSONAcceptable } | { [string]: JSONAcceptable } | number | string | boolean | buffer

export type Profile&lt;T> = {
	Data: T &amp; JSONAcceptable,
	LastSavedData: T &amp; JSONAcceptable,
	FirstSessionTime: number,
	SessionLoadCount: number,
	Session: {PlaceId: number, JobId: string}?,
	RobloxMetaData: JSONAcceptable,
	UserIds: {number},
	KeyInfo: DataStoreKeyInfo,
	OnSave: {Connect: (self: any, listener: () -> ()) -> ({Disconnect: (self: any) -> ()})},
	OnLastSave: {Connect: (self: any, listener: (reason: "Manual" | "External" | "Shutdown") -> ()) -> ({Disconnect: (self: any) -> ()})},
	OnSessionEnd: {Connect: (self: any, listener: () -> ()) -> ({Disconnect: (self: any) -> ()})},
	OnAfterSave: {Connect: (self: any, listener: (last_saved_data: T &amp; JSONAcceptable) -> ()) -> ({Disconnect: (self: any) -> ()})},
	ProfileStore: JSONAcceptable,
	Key: string,

	IsActive: (self: any) -> (boolean),
	Reconcile: (self: any) -> (),
	EndSession: (self: any) -> (),
	AddUserId: (self: any, user_id: number) -> (),
	RemoveUserId: (self: any, user_id: number) -> (),
	MessageHandler: (self: any, fn: (message: JSONAcceptable, processed: () -> ()) -> ()) -> (),
	Save: (self: any) -> (),
	SetAsync: (self: any) -> (),
}

export type VersionQuery&lt;T> = {
	NextAsync: (self: any) -> (Profile&lt;T>?),
}

type ProfileStoreStandard&lt;T> = {
	Name: string,
	StartSessionAsync: (self: any, profile_key: string, params: {Steal: boolean?}) -> (Profile&lt;T>?),
	MessageAsync: (self: any, profile_key: string, message: JSONAcceptable) -> (boolean),
	GetAsync: (self: any, profile_key: string, version: string?) -> (Profile&lt;T>?),
	VersionQuery: (self: any, profile_key: string, sort_direction: Enum.SortDirection?, min_date: DateTime | number | nil, max_date: DateTime | number | nil) -> (VersionQuery&lt;T>),
	RemoveAsync: (self: any, profile_key: string) -> (boolean),
}

export type ProfileStore&lt;T> = {
	Mock: ProfileStoreStandard&lt;T>,
} &amp; ProfileStoreStandard&lt;T>

type ConstantName = "AUTO_SAVE_PERIOD" | "LOAD_REPEAT_PERIOD" | "FIRST_LOAD_REPEAT" | "SESSION_STEAL"
| "ASSUME_DEAD" | "START_SESSION_TIMEOUT" | "CRITICAL_STATE_ERROR_COUNT" | "CRITICAL_STATE_ERROR_EXPIRE"
| "CRITICAL_STATE_EXPIRE" | "MAX_MESSAGE_QUEUE"

export type ProfileStoreModule = {
	IsClosing: boolean,
	IsCriticalState: boolean,
	OnError: {Connect: (self: any, listener: (message: string, store_name: string, profile_key: string) -> ()) -> ({Disconnect: (self: any) -> ()})},
	OnOverwrite: {Connect: (self: any, listener: (store_name: string, profile_key: string) -> ()) -> ({Disconnect: (self: any) -> ()})},
	OnCriticalToggle: {Connect: (self: any, listener: (is_critical: boolean) -> ()) -> ({Disconnect: (self: any) -> ()})},
	DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access",
	New: &lt;T>(store_name: string, template: (T &amp; JSONAcceptable)?) -> (ProfileStore&lt;T>),
	SetConstant: (name: ConstantName, value: number) -> ()
}

local Profile = {}
Profile.__index = Profile

function Profile.New(raw_data, key_info, profile_store, key, is_mock, session_token)

	local data = raw_data.Data or {}
	local session = raw_data.MetaData and raw_data.MetaData.ActiveSession or nil

	local global_updates = raw_data.GlobalUpdates and raw_data.GlobalUpdates[2] or {}
	local received_global_updates = {}

	for _, update in ipairs(global_updates) do
		received_global_updates[update[1]] = true
	end

	local self = {

		Data = data,
		LastSavedData = DeepCopyTable(data),

		FirstSessionTime = raw_data.MetaData and raw_data.MetaData.ProfileCreateTime or 0,
		SessionLoadCount = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		Session = session and {PlaceId = session[1], JobId = session[2]},

		RobloxMetaData = raw_data.RobloxMetaData or {},
		UserIds = raw_data.UserIds or {},
		KeyInfo = key_info,

		OnAfterSave = Signal.New(),
		OnSave = Signal.New(),
		OnLastSave = Signal.New(),
		OnSessionEnd = Signal.New(),

		ProfileStore = profile_store,
		Key = key,

		load_timestamp = os.clock(),
		is_mock = is_mock,
		session_token = session_token or "",
		load_index = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		locked_global_updates = {},
		received_global_updates = received_global_updates,
		message_handlers = {},
		global_updates = global_updates,

	}
	setmetatable(self, Profile)

	return self

end

function Profile:IsActive()
	return ActiveSessionCheck[self.session_token] == self
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self.ProfileStore.template)
end

function Profile:EndSession()
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true, nil, "Manual") -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :AddUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	if user_id &lt; 0 and self.is_mock ~= true and DataStoreState == "Access" then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end

end

function Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :RemoveUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end

end

function Profile:SetAsync() -- Saves the profile to the DataStore and removes the session lock

	if self.view_mode ~= true then
		error(`[{script.Name}]: :SetAsync() can only be used in view mode`)
	end

	SaveProfileAsync(self, nil, true)

end

function Profile:MessageHandler(fn)

	if type(fn) ~= "function" then
		error(`[{script.Name}]: fn argument is not a function`)
	end

	if self.view_mode ~= true and self:IsActive() ~= true then
		return -- Don't process messages if the profile session was ended
	end

	local locked_updates = self.locked_global_updates
	table.insert(self.message_handlers, fn)

	for _, update in ipairs(self.global_updates) do

		local index = update[1]
		local update_data = update[#update] -- Backwards compatibility with ProfileService

		if locked_updates[index] ~= true then

			local processed_callback = function()
				locked_updates[index] = true
			end
			
			local send_update_data = DeepCopyTable(update_data)

			task.spawn(fn, send_update_data, processed_callback)

		end

	end

end

function Profile:Save()
	
	if self.view_mode == true then
		error(`[{script.Name}]: Can't save profile in view mode; Should you be calling :SetAsync() instead?`)
	end
	
	if self:IsActive() == false then
		warn(`[{script.Name}]: Attempted saving an inactive profile (STORE:{self.ProfileStore.Name}; KEY:{self.Key});`
			.. ` Traceback:\n` .. debug.traceback())
		return
	end
	
	-- Move the profile right behind the auto save index to delay the next auto save for it:
	RemoveProfileFromAutoSave(self)
	AddProfileToAutoSave(self)
	
	-- Perform save in new thread:
	task.spawn(SaveProfileAsync, self)

end

local ProfileStore: ProfileStoreModule = {

	IsClosing = false,
	IsCriticalState = false,
	OnError = OnError, -- (message, store_name, profile_key)
	OnOverwrite = OnOverwrite, -- (store_name, profile_key)
	OnCriticalToggle = Signal.New(), -- (is_critical)
	DataStoreState = "NotReady", -- ("NotReady", "NoInternet", "NoAccess", "Access")

}
ProfileStore.__index = ProfileStore

function ProfileStore.SetConstant(name, value)

	if type(value) ~= "number" then
		error(`[{script.Name}]: Invalid value type`)
	end

	if name == "AUTO_SAVE_PERIOD" then
		AUTO_SAVE_PERIOD = value
	elseif name == "LOAD_REPEAT_PERIOD" then
		LOAD_REPEAT_PERIOD = value
	elseif name == "FIRST_LOAD_REPEAT" then
		FIRST_LOAD_REPEAT = value
	elseif name == "SESSION_STEAL" then
		SESSION_STEAL = value
	elseif name == "ASSUME_DEAD" then
		ASSUME_DEAD = value
	elseif name == "START_SESSION_TIMEOUT" then
		START_SESSION_TIMEOUT = value
	elseif name == "CRITICAL_STATE_ERROR_COUNT" then
		CRITICAL_STATE_ERROR_COUNT = value
	elseif name == "CRITICAL_STATE_ERROR_EXPIRE" then
		CRITICAL_STATE_ERROR_EXPIRE = value
	elseif name == "CRITICAL_STATE_EXPIRE" then
		CRITICAL_STATE_EXPIRE = value
	elseif name == "MAX_MESSAGE_QUEUE" then
		MAX_MESSAGE_QUEUE = value
	else
		error(`[{script.Name}]: Invalid constant name was provided`)
	end

end

function ProfileStore.Test()
	return {
		ActiveSessionCheck = ActiveSessionCheck,
		AutoSaveList = AutoSaveList,
		ActiveProfileLoadJobs = ActiveProfileLoadJobs,
		ActiveProfileSaveJobs = ActiveProfileSaveJobs,
		MockStore = MockStore,
		UserMockStore = UserMockStore,
		UpdateQueue = UpdateQueue,
	}
end

function ProfileStore.New(store_name, template)

	template = template or {}

	if type(store_name) ~= "string" then
		error(`[{script.Name}]: Invalid or missing "store_name"`)
	elseif string.len(store_name) == 0 then
		error(`[{script.Name}]: store_name cannot be an empty string`)
	elseif string.len(store_name) > 50 then
		error(`[{script.Name}]: store_name is too long`)
	end

	if type(template) ~= "table" then
		error(`[{script.Name}]: Invalid template argument`)
	end

	local self
	self = {

		Mock = {

			Name = store_name,

			StartSessionAsync = function(_, profile_key)
				MockFlag = true
				return self:StartSessionAsync(profile_key)
			end,
			MessageAsync = function(_, profile_key, message)
				MockFlag = true
				return self:MessageAsync(profile_key, message)
			end,
			GetAsync = function(_, profile_key, version)
				MockFlag = true
				return self:GetAsync(profile_key, version)
			end,
			VersionQuery = function(_, profile_key, sort_direction, min_date, max_date)
				MockFlag = true
				return self:VersionQuery(profile_key, sort_direction, min_date, max_date)
			end,
			RemoveAsync = function(_, profile_key)
				MockFlag = true
				return self:RemoveAsync(profile_key)
			end
		},

		Name = store_name,

		template = template,
		data_store = nil,
		load_jobs = {},
		mock_load_jobs = {},
		is_ready = true,

	}
	setmetatable(self, ProfileStore)

	local options = Instance.new("DataStoreOptions")
	options:SetExperimentalFeatures({v2 = true})

	if DataStoreState == "NotReady" then

		-- The module is not sure whether DataStores are accessible yet:

		self.is_ready = false

		task.spawn(function()

			repeat task.wait() until DataStoreState ~= "NotReady"

			if DataStoreState == "Access" then
				self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
			end

			self.is_ready = true

		end)

	elseif DataStoreState == "Access" then

		self.data_store = DataStoreService:GetDataStore(store_name, nil, options)

	end

	return self

end

local function RobloxMessageSubscription(profile, unique_session_id)

	local last_roblox_message = 0
	
	local roblox_message_subscription = MessagingService:SubscribeAsync("PS_" .. unique_session_id, function(message)
		if type(message.Data) == "table" and message.Data.LoadCount == profile.SessionLoadCount then
			-- High reaction rate, based on numPlayers × 10 DataStore budget as of writing
			if os.clock() - last_roblox_message > 6 then 
				last_roblox_message = os.clock()
				if profile:IsActive() == true then
					if message.Data.EndSession == true then
						SaveProfileAsync(profile, true, false, "External")
					else
						profile:Save()
					end
				end
			end
		end
	end)

	if profile:IsActive() == true then
		profile.roblox_message_subscription = roblox_message_subscription
	else
		roblox_message_subscription:Disconnect()
	end

end

function ProfileStore:StartSessionAsync(profile_key, params)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end
	
	if params ~= nil and type(params) ~= "table" then
		error(`[{script.Name}]: Invalid params`)
	end
	
	params = params or {}

	if ProfileStore.IsClosing == true then
		return nil
	end
	
	WaitForStoreReady(self)

	local session_token = SessionToken(self.Name, profile_key, is_mock)

	if ActiveSessionCheck[session_token] ~= nil then
		error(`[{script.Name}]: Profile (STORE:{self.Name}; KEY:{profile_key}) is already loaded in this session`)
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1
	
	local is_user_cancel = false
	
	local function cancel_condition()
		if is_user_cancel == false then
			if params.Cancel ~= nil then
				is_user_cancel = params.Cancel() == true
			end
			return is_user_cancel
		end
		return true
	end
	
	local user_steal = params.Steal == true

	local force_load_steps = 0 -- Session conflict handling values
	local request_force_load = true
	local steal_session = false

	local start = os.clock()
	local exp_backoff = 1

	while ProfileStore.IsClosing == false and cancel_condition() == false do

		-- Load profile:

		-- SPECIAL CASE - If StartSessionAsync is called for the same key again before another StartSessionAsync finishes,
		-- grab the DataStore return for the new call. The early call will return nil. This is supposed to retain
		-- expected and efficient behavior in cases where a player would quickly rejoin the same server.

		LoadIndex += 1
		local load_id = LoadIndex
		local profile_load_jobs = is_mock == true and self.mock_load_jobs or self.load_jobs
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}

		local loaded_data, key_info
		local unique_session_id = HttpService:GenerateGUID(false)

		if profile_load_job ~= nil then

			profile_load_job[1] = load_id -- Steal load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end

		else

			profile_load_job = {load_id, nil}
			profile_load_jobs[profile_key] = profile_load_job

			profile_load_job[2] = table.pack(UpdateAsync(
				self,
				profile_key,
				{
					ExistingProfileHandle = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						local force_load_session = latest_data.MetaData.ForceLoadSession

						if active_session == nil then
							latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
							latest_data.MetaData.ForceLoadSession = nil
						elseif type(active_session) == "table" then
							if IsThisSession(active_session) == false then
								local last_update = latest_data.MetaData.LastUpdate
								if last_update ~= nil then
									if os.time() - last_update > ASSUME_DEAD then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
										return
									end
								end
								if steal_session == true or user_steal == true then
									local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true
									if force_load_interrupted == false or user_steal == true then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
									end
								elseif request_force_load == true then
									latest_data.MetaData.ForceLoadSession = {PlaceId, JobId}
								end
							else
								latest_data.MetaData.ForceLoadSession = nil
							end
						end

					end,
					MissingProfileHandle = function(latest_data)
						
						local is_cancel = ProfileStore.IsClosing == true or cancel_condition() == true

						latest_data.Data = DeepCopyTable(self.template)
						latest_data.MetaData = {
							ProfileCreateTime = os.time(),
							SessionLoadCount = 0,
							ActiveSession = if is_cancel == false then {PlaceId, JobId, unique_session_id} else nil,
							ForceLoadSession = nil,
							MetaTags = {}, -- Backwards compatibility with ProfileService
						}

					end,
					EditProfile = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						if active_session ~= nil and IsThisSession(active_session) == true then
							latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
							latest_data.MetaData.LastUpdate = os.time()
						end

					end,
				},
				is_mock
				))
			if profile_load_job[1] == load_id then -- Load job hasn't been stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job stolen
			end
		end

		-- Handle load_data:

		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then

				if IsThisSession(active_session) == true then

					-- Profile is now taken by this session:

					local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock, session_token)
					AddProfileToAutoSave(profile)
					
					if is_mock ~= true and DataStoreState == "Access" then
						
						-- Use MessagingService to quickly detect session conflicts and resolve them quickly:
						task.spawn(RobloxMessageSubscription, profile, unique_session_id) -- Blocking prevention
						
					end

					if ProfileStore.IsClosing == true or cancel_condition() == true then
						-- The server has initiated a shutdown by the time this profile was loaded
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- Don't return the profile object
					end

					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile

				else
					
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					-- Profile is taken by some other session:

					local force_load_session = loaded_data.MetaData.ForceLoadSession
					local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true

					if force_load_interrupted == false then

						if request_force_load == false then
							force_load_steps = force_load_steps + 1
							if force_load_steps >= math.ceil(SESSION_STEAL / LOAD_REPEAT_PERIOD) then
								steal_session = true
							end
						end
						
						-- Request the remote server to end its session:
						if type(active_session[3]) == "string" then
							local session_load_count = loaded_data.MetaData.SessionLoadCount or 0
							task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count, EndSession = true})
						end
						
						-- Attempt to load the profile again after a delay
						local wait_until = os.clock() + if request_force_load == true then FIRST_LOAD_REPEAT else LOAD_REPEAT_PERIOD
						repeat task.wait() until os.clock() >= wait_until or ProfileStore.IsClosing == true

					else
						-- Another session tried to load this profile:
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					request_force_load = false -- Only request a force load once

				end

			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely that this server started shutting down
			end
		else
			
			-- A DataStore call has likely ended in an error:

			local default_timeout = false

			if params.Cancel == nil then
				default_timeout = os.clock() - start >= START_SESSION_TIMEOUT
			end
			
			if default_timeout == true or ProfileStore.IsClosing == true or cancel_condition() == true then
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
			
			task.wait(exp_backoff)  -- Repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
			
		end

	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- Game started shutting down or the request was cancelled - don't return the profile

end

function ProfileStore:MessageAsync(profile_key, message)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if type(message) ~= "table" then
		error(`[{script.Name}]: message must be a table`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Updating profile:

		local loaded_data = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)

					local global_updates = latest_data.GlobalUpdates
					local update_list = global_updates[2]
					--{
					--	update_index,
					--	{
					--		{update_index, data}, ...
					--	},
					--},

					global_updates[1] += 1
					table.insert(update_list, {global_updates[1], message})

					-- Clearing queue if above limit:

					while #update_list > MAX_MESSAGE_QUEUE do
						table.remove(update_list, 1)
					end

				end,
			},
			is_mock
		)

		if loaded_data ~= nil then
			
			local session_token = SessionToken(self.Name, profile_key, is_mock)
			
			local profile = ActiveSessionCheck[session_token]
			
			if profile ~= nil then
				
				-- The message was sent to a profile that is active in this server:
				profile:Save()
				
			else
				
				local meta_data = loaded_data.MetaData or {}
				local active_session = meta_data.ActiveSession
				local session_load_count = meta_data.SessionLoadCount or 0
				
				if type(active_session) == "table" and type(active_session[3]) == "string" then
					-- Request the remote server to auto-save sooner and receive the message:
					task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count})
				end
				
			end

			return true

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return false

end

function ProfileStore:GetAsync(profile_key, version)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	if version ~= nil and (is_mock or DataStoreState ~= "Access") then
		return nil -- No version support in mock mode
	end

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Load profile:

		local loaded_data, key_info = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)

					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}

				end,
				EditProfile = nil,
			},
			is_mock,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)

		-- Handle load_data:

		if loaded_data ~= nil then

			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end

			local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock)
			profile.view_mode = true

			return profile

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return nil -- Game started shutting down - don't return the profile

end

function ProfileStore:RemoveAsync(profile_key)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local wipe_status = false
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(self.Name, profile_key, is_mock))

	if is_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

		local mock_data_store = UserMockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				UserMockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	elseif DataStoreState ~= "Access" then -- Used when API access is disabled

		local mock_data_store = MockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				MockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	else -- Live DataStore

		wipe_status = pcall(function()
			self.data_store:RemoveAsync(profile_key)
		end)

	end
	
	next_in_queue()

	return wipe_status

end

local ProfileVersionQuery = {}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery.New(profile_store, profile_key, sort_direction, min_date, max_date, is_mock)

	local self = {
		profile_store = profile_store,
		profile_key = profile_key,
		sort_direction = sort_direction,
		min_date = min_date,
		max_date = max_date,

		query_pages = nil,
		query_index = 0,
		query_failure = false,

		is_query_yielded = false,
		query_queue = {},

		is_mock = is_mock,
	}
	setmetatable(self, ProfileVersionQuery)

	return self

end

function MoveVersionQueryQueue(self) -- Hidden ProfileVersionQuery method
	while #self.query_queue > 0 do

		local queue_entry = table.remove(self.query_queue, 1)

		task.spawn(queue_entry)

		if self.is_query_yielded == true then
			break
		end

	end
end

local VersionQueryNextAsyncStackingFlag = false
local WarnAboutVersionQueryOnce = false

function ProfileVersionQuery:NextAsync()

	local is_stacking = VersionQueryNextAsyncStackingFlag == true
	VersionQueryNextAsyncStackingFlag = false

	WaitForStoreReady(self.profile_store)

	if ProfileStore.IsClosing == true then
		return nil -- Silently fail :NextAsync() requests
	end

	if self.is_mock == true or DataStoreState ~= "Access" then
		if IsStudio == true and WarnAboutVersionQueryOnce == false then
			WarnAboutVersionQueryOnce = true
			warn(`[{script.Name}]: :VersionQuery() is not supported in mock mode!`)
		end
		return nil -- Silently fail :NextAsync() requests
	end

	local profile
	local is_finished = false

	local function query_job()

		if self.query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self.query_pages == nil then

			self.is_query_yielded = true

			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local list_success, error_message = pcall(function()
				self.query_pages = self.profile_store.data_store:ListVersionsAsync(
					self.profile_key,
					self.sort_direction,
					self.min_date,
					self.max_date
				)
				self.query_index = 0
			end)

			if list_success == false or self.query_pages == nil then
				warn(`[{script.Name}]: Version query fail - {tostring(error_message)}`)
				self.query_failure = true
			end

			self.is_query_yielded = false

			MoveVersionQueryQueue(self)

			return

		end

		local current_page = self.query_pages:GetCurrentPage()
		local next_item = current_page[self.query_index + 1]

		-- No more entries:

		if self.query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then

			self.is_query_yielded = true
			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local success, error_message = pcall(function()
				self.query_pages:AdvanceToNextPageAsync()
				self.query_index = 0
			end)

			if success == false or #self.query_pages:GetCurrentPage() == 0 then
				self.query_failure = true
			end

			self.is_query_yielded = false
			MoveVersionQueryQueue(self)

			return

		end

		-- Next page item:

		self.query_index += 1
		profile = self.profile_store:GetAsync(self.profile_key, next_item.Version)
		is_finished = true

	end

	if self.is_query_yielded == false then
		query_job()
	else
		if is_stacking == true then
			table.insert(self.query_queue, 1, query_job)
		else
			table.insert(self.query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile

end

function ProfileStore:VersionQuery(profile_key, sort_direction, min_date, max_date)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	-- Type check:

	if sort_direction ~= nil and (typeof(sort_direction) ~= "EnumItem"
		or sort_direction.EnumType ~= Enum.SortDirection) then
		error(`[{script.Name}]: Invalid sort_direction ({tostring(sort_direction)})`)
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error(`[{script.Name}]: Invalid min_date ({tostring(min_date)})`)
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error(`[{script.Name}]: Invalid max_date ({tostring(max_date)})`)
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	return ProfileVersionQuery.New(self, profile_key, sort_direction, min_date, max_date, is_mock)

end

-- DataStore API access check:

if IsStudio == true then

	task.spawn(function()

		local new_state = "NoAccess"

		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)

		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil

		if no_internet_access == true then
			warn(`[{script.Name}]: No internet access - check your network connection`)
		end

		if status == false and
			(string.find(message, "403", 1, true) ~= nil or -- Cannot write to DataStore from studio if API access is not enabled
				string.find(message, "must publish", 1, true) ~= nil or -- Game must be published to access live keys
				no_internet_access == true) then -- No internet access

			new_state = if no_internet_access == true then "NoInternet" else "NoAccess"
			print(`[{script.Name}]: Roblox API services unavailable - data will not be saved`)
		else
			new_state = "Access"
			print(`[{script.Name}]: Roblox API services available - data will be saved`)
		end

		DataStoreState = new_state
		ProfileStore.DataStoreState = new_state

	end)

else
	
	DataStoreState = "Access"
	ProfileStore.DataStoreState = "Access"
	
end

-- Update loop:

RunService.Heartbeat:Connect(function()

	-- Auto saving:

	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length > 0 then
		local auto_save_index_speed = AUTO_SAVE_PERIOD / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave > auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile.load_timestamp &lt; AUTO_SAVE_PERIOD / 2 then
				-- This profile is freshly loaded - auto saving immediately is not necessary:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex > auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile.load_timestamp >= AUTO_SAVE_PERIOD / 2 then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex > auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end

	-- Critical state handling:

	if ProfileStore.IsCriticalState == false then
		if #IssueQueue >= CRITICAL_STATE_ERROR_COUNT then
			ProfileStore.IsCriticalState = true
			ProfileStore.OnCriticalToggle:Fire(true)
			CriticalStateStart = os.clock()
			warn(`[{script.Name}]: Entered critical state`)
		end
	else
		if #IssueQueue >= CRITICAL_STATE_ERROR_COUNT then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart > CRITICAL_STATE_EXPIRE then
			ProfileStore.IsCriticalState = false
			ProfileStore.OnCriticalToggle:Fire(false)
			warn(`[{script.Name}]: Critical state ended`)
		end
	end

	-- Issue queue:

	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time > CRITICAL_STATE_ERROR_EXPIRE then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end

end)

-- Release all loaded profiles when the server is shutting down:

task.spawn(function()

	while DataStoreState == "NotReady" do
		task.wait()
	end

	if DataStoreState ~= "Access" then

		game:BindToClose(function()
			ProfileStore.IsClosing = true
			task.wait() -- Mock shutdown delay
		end)

		return -- Don't wait for profiles to properly save in mock mode so studio could end the simulation faster

	end

	game:BindToClose(function()

		ProfileStore.IsClosing = true

		-- Release all active profiles:
		-- (Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released)

		local on_close_save_job_count = 0
		local active_profiles = {}
		for index, profile in ipairs(AutoSaveList) do
			active_profiles[index] = profile
		end

		-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
		for _, profile in ipairs(active_profiles) do
			if profile:IsActive() == true then
				on_close_save_job_count = on_close_save_job_count + 1
				task.spawn(function() -- Save profile on new thread
					SaveProfileAsync(profile, true, nil, "Shutdown")
					on_close_save_job_count = on_close_save_job_count - 1
				end)
			end
		end

		-- Yield until all active profile jobs are finished:
		while on_close_save_job_count > 0 or ActiveProfileLoadJobs > 0 or ActiveProfileSaveJobs > 0 do
			task.wait()
		end

		return -- We're done!

	end)

end)

return ProfileStore</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="70">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="71">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="72">
        <Properties>
          <string name="Name">DinoClient</string>
        </Properties>
        <Item class="LocalScript" referent="73">
          <Properties>
            <string name="Name">Ambient</string>
            <string name="Source"><![CDATA[-- Оживляем картинку у игрока: динозавры шагают, виляют хвостом, моргают и открывают рот,
-- яйца покачиваются, летают бабочки, идёт снег, пепел, листья или светлячки.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local remotes = ReplicatedStorage:WaitForChild("DinoRemotes")
local camera = Workspace.CurrentCamera

-- ---------- анимация динозавров ----------

local rigs: { [Model]: any } = {}

local function setupRig(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local motors = {}
	local lids = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") then
			motors[d.Name] = d
		elseif d:IsA("BasePart") and d.Name == "Eyelid" then
			table.insert(lids, d)
		end
	end
	local root = model.PrimaryPart
	if not root then
		return
	end
	local scale = model:GetAttribute("Scale") or 1
	local dust = Instance.new("ParticleEmitter")
	dust.Color = ColorSequence.new(Color3.fromRGB(200, 180, 150))
	dust.Size = NumberSequence.new(0.6 * scale, 2 * scale)
	dust.Transparency = NumberSequence.new(0.4, 1)
	dust.Lifetime = NumberRange.new(0.5, 0.9)
	dust.Speed = NumberRange.new(1, 3)
	dust.SpreadAngle = Vector2.new(60, 60)
	dust.Rate = 18
	dust.Enabled = false
	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, -4.5 * scale, 0)
	att.Parent = root
	dust.Parent = att
	rigs[model] = {
		root = root,
		motors = motors,
		lids = lids,
		scale = scale,
		last = root.Position,
		speed = 0,
		phase = math.random() * 6,
		seed = math.random() * 100,
		nextBlink = os.clock() + math.random() * 4,
		blinkUntil = 0,
		dust = dust,
	}
end

CollectionService:GetInstanceAddedSignal("DinoRig"):Connect(setupRig)
CollectionService:GetInstanceRemovedSignal("DinoRig"):Connect(function(model)
	rigs[model :: Model] = nil
end)
for _, m in ipairs(CollectionService:GetTagged("DinoRig")) do
	setupRig(m)
end

local function setT(motors, name: string, cf: CFrame)
	local m = motors[name]
	if m then
		m.Transform = cf
	end
end

local function animateRigs(dt: number)
	local camPos = camera.CFrame.Position
	local now = os.clock()
	for model, r in pairs(rigs) do
		if not model.Parent then
			rigs[model] = nil
			continue
		end
		local pos = r.root.Position
		local v = (pos - r.last) / math.max(dt, 1 / 240)
		r.last = pos
		if (pos - camPos).Magnitude > 260 then
			continue -- далеко — не тратим силы
		end
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude / r.scale
		if speed > 200 then
			speed = 0 -- телепорт, а не бег
		end
		r.speed += (speed - r.speed) * math.min(1, dt * 8)
		local run = math.clamp(r.speed / 12, 0, 1)
		r.phase += dt * (3 + r.speed * 0.45)
		local swing = math.sin(r.phase) * 0.75 * run
		local t = now + r.seed
		local chasing = model:GetAttribute("Chasing") == true

		setT(r.motors, "HipFL", CFrame.Angles(swing, 0, 0))
		setT(r.motors, "HipBR", CFrame.Angles(swing, 0, 0))
		setT(r.motors, "HipFR", CFrame.Angles(-swing, 0, 0))
		setT(r.motors, "HipBL", CFrame.Angles(-swing, 0, 0))
		local wag = chasing and 6 or 2.5
		setT(r.motors, "TailA", CFrame.Angles(0, math.sin(t * wag) * 0.22, 0))
		setT(r.motors, "TailB", CFrame.Angles(0, math.sin(t * wag - 0.7) * 0.3, 0))
		setT(r.motors, "TailC", CFrame.Angles(math.sin(t * 1.3) * 0.08, math.sin(t * wag - 1.4) * 0.38, 0))
		setT(r.motors, "Neck", CFrame.Angles(math.sin(t * 2) * 0.06 + math.abs(math.sin(r.phase)) * 0.08 * run, math.sin(t * 0.6) * 0.18 * (1 - run), 0))
		local jaw = chasing and (0.25 + math.abs(math.sin(t * 9)) * 0.3) or math.max(0, math.sin(t * 0.8) - 0.95) * 6
		setT(r.motors, "Jaw", CFrame.Angles(jaw, 0, 0))
		local arm = math.sin(t * (chasing and 14 or 3)) * (chasing and 0.6 or 0.15)
		setT(r.motors, "ArmL", CFrame.Angles(arm, 0, 0))
		setT(r.motors, "ArmR", CFrame.Angles(-arm, 0, 0))

		-- моргание
		if now > r.nextBlink then
			r.nextBlink = now + 2 + math.random() * 4
			r.blinkUntil = now + 0.13
		end
		local closed = now < r.blinkUntil
		for _, lid in ipairs(r.lids) do
			lid.Transparency = closed and 0 or 1
		end
		r.dust.Enabled = r.speed > 8
	end
end

-- ---------- яйца покачиваются ----------

local homes: { [BasePart]: CFrame } = {}
local wobbling: { [BasePart]: number } = {}
local nextWobble = 0

local function wobbleEggs(now: number)
	if now >= nextWobble then
		nextWobble = now + 0.4
		local eggs = CollectionService:GetTagged("Egg")
		if #eggs > 0 then
			local egg = eggs[math.random(#eggs)] :: BasePart
			if egg.Anchored and egg.Transparency < 1 and not wobbling[egg] then
				homes[egg] = egg.CFrame
				wobbling[egg] = now
			end
		end
	end
	for egg, start in pairs(wobbling) do
		local k = now - start
		local home = homes[egg]
		if not egg.Parent or k > 0.9 then
			if egg.Parent and home then
				egg.CFrame = home
			end
			wobbling[egg] = nil
			homes[egg] = nil
		elseif home then
			egg.CFrame = home * CFrame.Angles(0, 0, math.sin(k * 25) * 0.25 * (1 - k / 0.9))
		end
	end
end

-- ---------- бабочки ----------

local localFolder = Instance.new("Folder")
localFolder.Name = "DinoLocalFX"
localFolder.Parent = Workspace

local WING_COLORS = { Color3.fromRGB(255, 150, 60), Color3.fromRGB(120, 180, 255), Color3.fromRGB(255, 120, 200), Color3.fromRGB(255, 230, 90), Color3.fromRGB(180, 130, 255) }
local butterflies = {}
local function newPart(size: Vector3, color: Color3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Parent = localFolder
	return p
end
local HOMES = {
	Vector3.new(0, 4, 210), Vector3.new(-30, 4, 200), Vector3.new(30, 4, 230), Vector3.new(-50, 4, 240),
	Vector3.new(50, 4, 180), Vector3.new(0, 4, 100), Vector3.new(-100, 4, 110), Vector3.new(100, 4, 110),
	Vector3.new(-120, 4, -100), Vector3.new(120, 4, -100), Vector3.new(0, 4, -110), Vector3.new(-60, 4, 0),
}
for i, home in ipairs(HOMES) do
	local c = WING_COLORS[(i - 1) % #WING_COLORS + 1]
	table.insert(butterflies, {
		home = home,
		body = newPart(Vector3.new(0.12, 0.12, 0.5), Color3.fromRGB(40, 30, 30)),
		left = newPart(Vector3.new(0.7, 0.05, 0.6), c),
		right = newPart(Vector3.new(0.7, 0.05, 0.6), c),
		seed = math.random() * 50,
	})
end

local function flyButterflies(now: number)
	local hidden = remotes:GetAttribute("Theme") == "ice" or remotes:GetAttribute("Theme") == "volcano"
	for _, b in ipairs(butterflies) do
		local t = now * 0.6 + b.seed
		local pos = b.home + Vector3.new(math.sin(t) * 8 + math.sin(t * 2.3) * 3, math.sin(t * 1.7) * 1.5 + 1, math.cos(t * 0.8) * 8)
		local ahead = b.home + Vector3.new(math.sin(t + 0.05) * 8 + math.sin((t + 0.05) * 2.3) * 3, math.sin((t + 0.05) * 1.7) * 1.5 + 1, math.cos((t + 0.05) * 0.8) * 8)
		local cf = CFrame.lookAt(pos, ahead)
		local flap = math.sin(now * 22 + b.seed) * 0.9
		b.body.CFrame = cf
		b.left.CFrame = cf * CFrame.Angles(0, 0, flap) * CFrame.new(-0.38, 0, 0)
		b.right.CFrame = cf * CFrame.Angles(0, 0, -flap) * CFrame.new(0.38, 0, 0)
		local tr = hidden and 1 or 0
		b.body.Transparency, b.left.Transparency, b.right.Transparency = tr, tr, tr
	end
end

-- ---------- погода вокруг камеры ----------

local sky = newPart(Vector3.new(90, 1, 90), Color3.new(1, 1, 1))
sky.Transparency = 1
local weather = Instance.new("ParticleEmitter")
weather.EmissionDirection = Enum.NormalId.Bottom
weather.Enabled = false
weather.Parent = sky
local currentWeather = ""

local function setWeather(kind: string)
	if kind == currentWeather then
		return
	end
	currentWeather = kind
	weather.Enabled = kind ~= "none" and kind ~= ""
	weather.LightEmission = 0
	weather.Acceleration = Vector3.zero
	weather.RotSpeed = NumberRange.new(0)
	if kind == "snow" then
		weather.Color = ColorSequence.new(Color3.new(1, 1, 1))
		weather.Size = NumberSequence.new(0.35)
		weather.Rate = 220
		weather.Lifetime = NumberRange.new(6, 8)
		weather.Speed = NumberRange.new(5, 8)
		weather.SpreadAngle = Vector2.new(15, 15)
	elseif kind == "ash" then
		weather.Color = ColorSequence.new(Color3.fromRGB(255, 140, 60), Color3.fromRGB(80, 80, 80))
		weather.LightEmission = 0.6
		weather.Size = NumberSequence.new(0.25)
		weather.Rate = 120
		weather.Lifetime = NumberRange.new(6, 9)
		weather.Speed = NumberRange.new(2, 4)
		weather.SpreadAngle = Vector2.new(40, 40)
	elseif kind == "leaves" then
		weather.Color = ColorSequence.new(Color3.fromRGB(90, 170, 60), Color3.fromRGB(200, 170, 60))
		weather.Size = NumberSequence.new(0.5)
		weather.Rate = 30
		weather.Lifetime = NumberRange.new(8, 10)
		weather.Speed = NumberRange.new(2, 4)
		weather.SpreadAngle = Vector2.new(50, 50)
		weather.RotSpeed = NumberRange.new(-120, 120)
	elseif kind == "pollen" then
		weather.Color = ColorSequence.new(Color3.fromRGB(255, 250, 200))
		weather.LightEmission = 1
		weather.Size = NumberSequence.new(0.18)
		weather.Rate = 40
		weather.Lifetime = NumberRange.new(8, 12)
		weather.Speed = NumberRange.new(0.5, 1.5)
		weather.SpreadAngle = Vector2.new(80, 80)
	elseif kind == "fireflies" then
		weather.Color = ColorSequence.new(Color3.fromRGB(255, 240, 120))
		weather.LightEmission = 1
		weather.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0) })
		weather.Rate = 40
		weather.Lifetime = NumberRange.new(4, 6)
		weather.Speed = NumberRange.new(0.5, 1.5)
		weather.SpreadAngle = Vector2.new(90, 90)
		weather.Acceleration = Vector3.new(0, 0.4, 0)
	end
end

-- ---------- каждый кадр ----------

RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	animateRigs(dt)
	wobbleEggs(now)
	flyButterflies(now)
	setWeather(remotes:GetAttribute("Weather") or "none")
	local high = (currentWeather == "pollen" or currentWeather == "fireflies") and 12 or 30
	sky.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, high, 0))
end)

Players.LocalPlayer.CharacterAdded:Connect(function()
	camera = Workspace.CurrentCamera
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="74">
          <Properties>
            <string name="Name">DinoClient</string>
            <string name="Source"><![CDATA[-- Связка экрана с Roblox: кнопки в верхней панели (TopbarPlus), музыка, звуки, голос,
-- шалости в Динопарке, лёд, тряска. Сам экран — UI/App.luau (Vide).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("DinoShared"):WaitForChild("Config"))
local Icon = require(ReplicatedStorage:WaitForChild("Packages"):WaitForChild("TopbarPlus"))
local App = require(script.Parent:WaitForChild("UI"):WaitForChild("App"))
local Logic = require(script.Parent.UI:WaitForChild("Logic"))
local remotes = ReplicatedStorage:WaitForChild("DinoRemotes")
local Request = remotes:WaitForChild("Request") :: RemoteFunction
local Notify = remotes:WaitForChild("Notify") :: RemoteEvent

local playJingle: () -> ()
local musicOn = true

local function playSound(name: string)
	if name == "win" then
		playJingle()
		return
	end
	local def = Config.SOUNDS[name]
	if not def then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = def.id
	s.PlaybackSpeed = def.speed or 1
	s.Volume = 0.6
	s.Parent = SoundService
	s:Play()
	task.delay(6, function()
		s:Destroy()
	end)
end

local function ask(action: string, arg: any?): any
	local ok, res = pcall(Request.InvokeServer, Request, action, arg)
	if ok and type(res) == "table" then
		return res
	end
	return { ok = false }
end

-- Голос: Roblox Text-to-Speech. Если не поддерживается — молча пропускаем, надписи всё равно есть.
local function speak(line: string)
	if not Config.VOICE_ENABLED then
		return
	end
	task.spawn(function()
		local tts, out
		local ok = pcall(function()
			tts = Instance.new("AudioTextToSpeech")
			tts.Text = line
			out = Instance.new("AudioDeviceOutput")
			local wire = Instance.new("Wire")
			tts.Parent = SoundService
			out.Parent = SoundService
			wire.SourceInstance = tts
			wire.TargetInstance = out
			wire.Parent = tts
			tts:Play()
		end)
		task.wait(ok and 8 or 0)
		if tts then
			tts:Destroy()
		end
		if out then
			out:Destroy()
		end
	end)
end

local function playEmote(emote)
	if emote.id == "tongue" or emote.id == "fart" then
		ask(emote.id)
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not (hum and animator) then
		return
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = emote.anim
	local ok, track = pcall(animator.LoadAnimation, animator, anim)
	if not ok then
		return
	end
	track.Priority = Enum.AnimationPriority.Action
	track.Looped = emote.id == "dance"
	track:Play()
	task.spawn(function()
		local start = os.clock()
		task.wait(0.3)
		while track.IsPlaying and os.clock() - start < 6 do
			if hum.MoveDirection.Magnitude > 0.1 then
				break
			end
			task.wait(0.1)
		end
		track:Stop()
	end)
end

-- ---------- экран ----------

local currentInput = "keyboard"

-- первая кнопка в окне: на приставке её сразу выделяем, дальше выбирают крестовиной
local function selectFirstButton(frame: Instance)
	if currentInput ~= "gamepad" then
		return
	end
	task.defer(function()
		local content = frame:FindFirstChild("Content", true)
		for _, d in ipairs((content or frame):GetDescendants()) do
			if d:IsA("GuiButton") and d.Visible then
				GuiService.SelectedObject = d
				return
			end
		end
	end)
end

local app = App.new({
	ask = ask,
	sound = playSound,
	speak = speak,
	emote = playEmote,
	-- значок кнопки как на геймпаде игрока: △ на PlayStation, Y на Xbox
	glyph = function(keyName: string)
		local ok, image = pcall(UserInputService.GetImageForKeyCode, UserInputService, (Enum.KeyCode :: any)[keyName])
		return ok and image or ""
	end,
	onPanelOpened = selectFirstButton,
})
app.gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets -- не под вырезом iPhone и не за краем телевизора
app.gui.Parent = player:WaitForChild("PlayerGui")

-- на чём играют: телефон, приставка или компьютер (геймпад можно подключить посреди игры)
local function updateInput()
	currentInput = Logic.inputKind(UserInputService:GetLastInputType().Name)
	app.setInput(currentInput)
end
UserInputService.LastInputTypeChanged:Connect(updateInput)
updateInput()
app.setTenFoot(GuiService:IsTenFootInterface())

-- размер экрана: на телефоне экран компактнее (и при повороте тоже)
local function updateViewport()
	local size = workspace.CurrentCamera.ViewportSize
	app.setViewport(size.X, size.Y)
end
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateViewport)
updateViewport()

-- ---------- кнопки в верхней панели Roblox (TopbarPlus) ----------

local icons = {}
local function menuIcon(panelName: string, label: string, order: number)
	local icon = Icon.new()
	icon:setLabel(label)
	icon:setOrder(order)
	icon:oneClick(true)
	icon:bindEvent("selected", function()
		app.open(panelName)
	end)
	icons[panelName] = icon
	return icon
end
menuIcon("pets", "🐣 Питомцы", 1)
menuIcon("shop", "🛒 Магазин", 2)
menuIcon("daily", "🎁 Подарок", 3)
menuIcon("wheel", "🎡 Колесо", 4)
menuIcon("badges", "🏅 Значки", 5)
menuIcon("codes", "🔑 Коды", 6)
menuIcon("emotes", "😀 Эмоции", 7)
local musicIcon = Icon.new()
musicIcon:setLabel("🎵")
musicIcon:align("Right")
musicIcon:oneClick(true)
musicIcon:bindEvent("selected", function()
	musicOn = not musicOn
	musicIcon:setLabel(musicOn and "🎵" or "🔇")
	app.toast(musicOn and "🎵 Музыка включена" or "🔇 Музыка выключена")
end)

-- красные точки: подарок, колесо, яйца
local shownDots = {}
local function updateDots(view)
	for name, on in pairs(Logic.dots(view)) do
		if on ~= shownDots[name] then
			shownDots[name] = on
			if on then
				icons[name]:notify()
			else
				icons[name]:clearNotices()
			end
		end
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	local key = input.KeyCode
	-- ○ / B закрывает окно, даже когда в окне выделена кнопка (тогда Roblox помечает нажатие как обработанное)
	if key == Enum.KeyCode.ButtonB and app.state.panel() then
		app.close()
		GuiService.SelectedObject = nil
		return
	end
	if processed then
		return
	end
	if key == Enum.KeyCode.Q or key == Enum.KeyCode[Logic.DINO_KEYS.roar.gamepad] then
		app.dinoAction("roar")
	elseif key == Enum.KeyCode.F or key == Enum.KeyCode[Logic.DINO_KEYS.dash.gamepad] then
		app.dinoAction("dash")
	end
end)

-- ---------- музыка ----------
-- Мелодии играются нотами из встроенного звука Roblox, поэтому чужие аудио не нужны.

local NOTE_INDEX = { C = 0, D = 2, E = 4, F = 5, G = 7, A = 9, B = 11 }
local function parseLine(line: string): { number | boolean }
	local out = {}
	for tok in line:gmatch("%S+") do
		if tok == "-" then
			table.insert(out, false)
		else
			local letter, acc, octave = tok:match("^(%a)([#b]?)(%d)$")
			local n = 12 * (tonumber(octave) :: number + 1) + NOTE_INDEX[letter] + (acc == "#" and 1 or acc == "b" and -1 or 0)
			table.insert(out, n)
		end
	end
	return out
end

local SONGS = {
	-- весёлая прыгучая для Динопарка
	lobby = {
		bpm = 132,
		melody = parseLine("C5 - E5 G5 C6 - G5 E5 F5 - A5 F5 G5 - - - E5 - G5 E5 D5 - C5 D5 E5 - D5 B4 C5 - - -"),
		bass = parseLine("C3 - G3 - C3 - G3 - F3 - C4 - G3 - D3 - C3 - G3 - A3 - E3 - F3 - G3 - C3 - G3 -"),
	},
	-- быстрая приключенческая для игры
	round = {
		bpm = 152,
		melody = parseLine("A4 C5 E5 A5 G5 E5 C5 E5 F5 A5 C6 A5 G5 E5 D5 E5 A4 C5 E5 A5 B5 A5 G5 E5 F5 E5 D5 B4 A4 - - -"),
		bass = parseLine("A2 - A3 - A2 - A3 - F2 - F3 - F2 - F3 - C3 - C4 - G2 - G3 - E2 - E3 - A2 - A2 -"),
	},
	-- тревожная, когда приходит Ти-Рекс
	boss = {
		bpm = 176,
		melody = parseLine("E5 - E5 F5 E5 - D#5 - E5 - G5 - F5 - D#5 -"),
		bass = parseLine("E2 E3 E2 E3 E2 E3 F2 F3 E2 E3 E2 E3 G2 G3 F2 F3"),
	},
}
local JINGLE = parseLine("C5 E5 G5 C6 - G5 C6 C6")

local notePool = {}
for i = 1, 12 do
	local snd = Instance.new("Sound")
	snd.SoundId = Config.SOUNDS.note.id
	snd.Parent = SoundService
	notePool[i] = snd
end
local poolIndex = 0
local function playNote(midi: number, volume: number)
	poolIndex = poolIndex % #notePool + 1
	local snd = notePool[poolIndex]
	snd.PlaybackSpeed = 2 ^ ((midi - 72) / 12)
	snd.Volume = volume
	snd.TimePosition = 0
	snd:Play()
end

local jinglePlaying = false
playJingle = function()
	if jinglePlaying then
		return
	end
	jinglePlaying = true
	task.spawn(function()
		for _, n in ipairs(JINGLE) do
			if n then
				playNote(n :: number, Config.MUSIC_VOLUME * 1.6)
			end
			task.wait(0.15)
		end
		task.wait(0.4)
		jinglePlaying = false
	end)
end

local function songName(): string
	if remotes:GetAttribute("Boss") then
		return "boss"
	end
	return (remotes:GetAttribute("TimeLeft") or -1) >= 0 and "round" or "lobby"
end

task.spawn(function()
	local playing: string? = nil
	local custom: Sound? = nil
	local step = 0
	local nextT = os.clock()
	while true do
		local name = musicOn and songName() or nil
		if name ~= playing then
			playing = name
			step = 0
			if custom then
				custom:Destroy()
				custom = nil
			end
			local id = name and Config.MUSIC[name] or ""
			if id ~= "" then
				local snd = Instance.new("Sound")
				snd.SoundId = id
				snd.Looped = true
				snd.Volume = Config.MUSIC_VOLUME
				snd.Parent = SoundService
				snd:Play()
				custom = snd
			end
		end
		local song = name and SONGS[name]
		if song and not custom and not jinglePlaying then
			step += 1
			local m = song.melody[(step - 1) % #song.melody + 1]
			local b = song.bass[(step - 1) % #song.bass + 1]
			if m then
				playNote(m :: number, Config.MUSIC_VOLUME)
			end
			if b then
				playNote(b :: number, Config.MUSIC_VOLUME * 0.8)
			end
		end
		nextT += song and 60 / song.bpm / 2 or 0.25
		local wait = nextT - os.clock()
		if wait < -0.5 then
			nextT = os.clock()
			wait = 0
		end
		task.wait(math.max(0, wait))
	end
end)

-- ---------- шалости в Динопарке: батуты, бананы, горка, пукалки, грибы ----------

local BOUNCE_WORDS = { "Уиии! 🤸", "Выше неба! ☁️", "Я птица! 🐦", "Йу-ху! 🚀" }
local cool = { bounce = 0, slip = 0, fart = 0, mushroom = 0, slide = 0 }
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function near(root: BasePart, p: BasePart, radius: number, height: number): boolean
	local d = Vector3.new(root.Position.X - p.Position.X, 0, root.Position.Z - p.Position.Z).Magnitude
	return d < radius and math.abs(root.Position.Y - p.Position.Y) < height
end

local function slip(hum: Humanoid, root: BasePart)
	cool.slip = os.clock() + 3
	playSound("slip")
	app.toast("Ой! Банан! 🍌😂")
	hum.PlatformStand = true
	root.AssemblyLinearVelocity = root.CFrame.LookVector * 25 + Vector3.new(0, 18, 0)
	root.AssemblyAngularVelocity = root.CFrame.RightVector * 10
	task.delay(1.3, function()
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end)
end

RunService.Heartbeat:Connect(function()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not (char and hum and root) or hum.Health <= 0 then
		return
	end
	local now = os.clock()
	for _, p in ipairs(CollectionService:GetTagged("Trampoline")) do
		if now > cool.bounce and near(root, p, 3.4, 5) then
			cool.bounce = now + 0.5
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, 95, v.Z)
			playSound("boing")
			if math.random() < 0.3 then
				app.toast(BOUNCE_WORDS[math.random(#BOUNCE_WORDS)])
			end
		end
	end
	for _, p in ipairs(CollectionService:GetTagged("Banana")) do
		if now > cool.slip and near(root, p, 1.8, 4) then
			slip(hum, root)
		end
	end
	for _, p in ipairs(CollectionService:GetTagged("Fart")) do
		if now > cool.fart and near(root, p, 2.4, 4) then
			cool.fart = now + 2.5
			task.spawn(ask, "fart")
		end
	end
	for _, p in ipairs(CollectionService:GetTagged("Mushroom")) do
		if now > cool.mushroom and near(root, p, 3, 5) then
			cool.mushroom = now + 5
			task.spawn(ask, "mushroom", p:GetAttribute("Kind"))
		end
	end
	rayParams.FilterDescendantsInstances = { char }
	local hit = workspace:Raycast(root.Position, Vector3.new(0, -5, 0), rayParams)
	if hit and CollectionService:HasTag(hit.Instance, "Slide") then
		local dir = hit.Instance:GetAttribute("Dir")
		if typeof(dir) == "Vector3" then
			root.AssemblyLinearVelocity = dir * 55
		end
		if now > cool.slide then
			cool.slide = now + 3
			app.toast("Уииии! 🛝")
			playSound("swoosh")
		end
	end
end)

-- ---------- данные и события с сервера ----------

local shakeUntil = 0
Notify.OnClientEvent:Connect(function(kind: string, payload: any)
	if kind == "data" then
		app.setData(payload)
		updateDots(payload)
	elseif kind == "toast" then
		app.toast(payload)
	elseif kind == "big" then
		app.big(payload.text, payload.seconds or 2.5)
	elseif kind == "voice" then
		speak(payload)
	elseif kind == "sound" then
		playSound(payload)
	elseif kind == "badge" then
		app.big("🏅 Новый значок: " .. payload.icon .. " " .. payload.name, 3)
	elseif kind == "panel" then
		app.open(payload)
	elseif kind == "role" then
		app.setDino(payload.dino)
	elseif kind == "shake" then
		shakeUntil = os.clock() + 0.6 * (payload or 1)
	end
end)

task.spawn(function()
	local view = ask("getData")
	if view and view.coins then
		app.setData(view)
		updateDots(view)
	end
end)

-- ---------- табло, время экрана, лёд, тряска ----------

task.spawn(function()
	while true do
		app.setHud({
			humans = remotes:GetAttribute("Humans") or 0,
			dinos = remotes:GetAttribute("Dinos") or 0,
			timeLeft = remotes:GetAttribute("TimeLeft") or -1,
			status = remotes:GetAttribute("Status") or "",
			map = remotes:GetAttribute("Map") or "",
			dinoPlayer = remotes:GetAttribute("DinoPlayer") or "",
			boss = remotes:GetAttribute("Boss") == true,
		})
		task.wait(0.2)
	end
end)

local slide = Vector3.zero
RunService.RenderStepped:Connect(function(dt)
	app.tick(os.clock())
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not (hum and root) then
		return
	end

	-- на льду скользишь
	if remotes:GetAttribute("Theme") == "ice" and hum.FloorMaterial == Enum.Material.Ice then
		local want = hum.MoveDirection * hum.WalkSpeed
		slide = slide:Lerp(want, math.min(1, dt * 2.2))
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(slide.X, v.Y, slide.Z)
	else
		local v = root.AssemblyLinearVelocity
		slide = Vector3.new(v.X, 0, v.Z)
	end

	-- тряска экрана от Ти-Рекса и рыка
	if os.clock() < shakeUntil then
		hum.CameraOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * 0.8
	elseif hum.CameraOffset.Magnitude > 0 then
		hum.CameraOffset = Vector3.zero
	end
end)

]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="75">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">App</string>
              <string name="Source"><![CDATA[-- Весь экран игрока на Vide (https://github.com/centau/vide): табло, сообщения, окна,
-- вылупление, колесо, кнопки динозавра. Работает от «источников» (source): поменял данные —
-- экран обновился сам. Без Roblox-сервисов: всё внешнее приходит в deps, поэтому экран
-- можно тестировать в Lune (tests/roblox/ui.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local vide = require(ReplicatedStorage:WaitForChild("Packages"):WaitForChild("vide"))
local Config = require(ReplicatedStorage:WaitForChild("DinoShared"):WaitForChild("Config"))
local Logic = require(script.Parent.Logic)

local create, source, derive, show, switch, indexes, spring, changed, root =
	vide.create, vide.source, vide.derive, vide.show, vide.switch, vide.indexes, vide.spring, vide.changed, vide.root

local C = {
	cream = Color3.fromRGB(247, 243, 227),
	paper = Color3.fromRGB(235, 228, 205),
	ink = Color3.fromRGB(31, 42, 23),
	blue = Color3.fromRGB(47, 111, 216),
	red = Color3.fromRGB(216, 69, 47),
	gold = Color3.fromRGB(242, 184, 34),
	green = Color3.fromRGB(88, 170, 60),
	purple = Color3.fromRGB(150, 90, 230),
	grey = Color3.fromRGB(160, 160, 150),
	muted = Color3.fromRGB(90, 95, 80),
}
local FONT = Enum.Font.FredokaOne
local PET_COLORS = {
	green = Config.DINOS.green.color,
	red = Config.DINOS.red.color,
	gold = Config.DINOS.gold.color,
	rainbow = Color3.fromRGB(230, 90, 200),
}
local TITLES = {
	pets = "🐣 Питомцы",
	shop = "🛒 Магазин",
	daily = "🎁 Подарок каждый день",
	wheel = "🎡 Колесо удачи",
	badges = "🏅 Значки",
	codes = "🔑 Секретные коды",
	emotes = "😀 Эмоции",
}

-- плавное «выпрыгивание» с лёгким перелётом (t от 0 до 1)
local function popOut(t: number): number
	t = math.clamp(t, 0, 1) - 1
	return 1 + 2.70158 * t ^ 3 + 1.70158 * t ^ 2
end

-- склеить свойства: строки из обоих, дети (числа) — сначала base, потом extra
local function merge(base, extra)
	local out = {}
	for k, v in pairs(base) do
		if type(k) == "string" then
			out[k] = v
		end
	end
	for k, v in pairs(extra or {}) do
		if type(k) == "string" then
			out[k] = v
		end
	end
	for _, v in ipairs(base) do
		table.insert(out, v)
	end
	for _, v in ipairs(extra or {}) do
		table.insert(out, v)
	end
	return out
end

local function Corner(r: UDim?)
	return create "UICorner" { CornerRadius = r or UDim.new(0, 12) }
end

local function Stroke(thickness: number?, color: Color3?)
	return create "UIStroke" { Thickness = thickness or 3, Color = color or C.ink, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }
end

local function Pad(x: number, y: number?)
	return create "UIPadding" {
		PaddingLeft = UDim.new(0, x),
		PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, y or x),
		PaddingBottom = UDim.new(0, y or x),
	}
end

local function Label(props)
	return create "TextLabel"(merge({ BackgroundTransparency = 1, Font = FONT, TextScaled = true, TextColor3 = C.ink }, props))
end

local App = {}

function App.new(deps)
	deps = deps or {}
	local ask = deps.ask or function()
		return { ok = false }
	end
	local sound = deps.sound or function() end
	local speak = deps.speak or function() end
	local emote = deps.emote or function() end
	local delay = deps.delay or function(seconds, fn)
		task.delay(seconds, fn)
	end

	-- ---------- состояние экрана ----------
	local now = source(0)
	local data = source(nil :: any)
	local hud = source({ humans = 0, dinos = 0, timeLeft = -1, status = "", map = "", dinoPlayer = "", boss = false })
	local panel = source(nil :: string?)
	local toasts = source({})
	local big = source(nil :: any)
	local isDino = source(false)
	local cooldowns = source({ roar = 0, dash = 0 })
	local hatching = source(nil :: any)
	local spin = source(nil :: any)
	local codeText = source("")
	-- телефон: экран низкий или узкий — всё компактнее и подальше от джойстика и прыжка
	local viewport = source({ w = 1280, h = 720 })
	local function compact()
		local v = viewport()
		return v.h < 500 or v.w < 700
	end
	-- на чём играют: "touch" — телефон, "gamepad" — PlayStation/Xbox, "keyboard" — компьютер
	local input = source("keyboard")
	-- телевизор (приставка): смотрят издалека — всё крупнее и подальше от краёв
	local tenFoot = source(false)
	local function k(): number
		return tenFoot() and 1.25 or 1
	end
	local glyph = deps.glyph or function()
		return ""
	end

	local api = {}

	-- кнопка, которая пружинит при нажатии
	local function Button(props)
		local pressed = source(false)
		local onClick = props.onClick
		local p = table.clone(props)
		p.onClick = nil
		local round = p.round
		p.round = nil
		return create "TextButton"(merge({
			Font = FONT,
			TextScaled = true,
			TextColor3 = C.ink,
			BackgroundColor3 = C.gold,
			AutoButtonColor = false,
			Activated = function()
				sound("pickup")
				onClick()
			end,
			MouseButton1Down = function()
				pressed(true)
			end,
			MouseButton1Up = function()
				pressed(false)
			end,
			MouseLeave = function()
				pressed(false)
			end,
			Corner(round and UDim.new(1, 0) or nil),
			Stroke(2),
			Pad(6, 4),
			create "UIScale" {
				Scale = spring(function()
					return pressed() and 0.88 or 1
				end, 0.25, 0.45),
			},
		}, p))
	end

	local function Heading(text)
		return Label { Size = UDim2.new(1, 0, 0, 30), Text = text, TextXAlignment = Enum.TextXAlignment.Left }
	end

	local function Note(text)
		return Label { Size = UDim2.new(1, 0, 0, 22), Text = text, TextColor3 = C.muted, TextXAlignment = Enum.TextXAlignment.Left }
	end

	local function Row(height: number, children)
		return create "Frame"(merge({
			Size = UDim2.new(1, -8, 0, height),
			BackgroundColor3 = C.paper,
			Corner(),
			create "UIListLayout" {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Pad(8, 0),
		}, children))
	end

	local function Column(children)
		return create "Frame"(merge({
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			create "UIListLayout" { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder },
		}, children))
	end

	local function Grid(cell: UDim2, children)
		return create "Frame"(merge({
			Size = UDim2.new(1, -8, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			create "UIGridLayout" {
				CellSize = cell,
				CellPadding = UDim2.new(0, 8, 0, 8),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
		}, children))
	end

	-- ---------- действия ----------

	function api.toast(text: string)
		local list = table.clone(toasts())
		table.insert(list, { text = text, untilT = now() + 3.5 })
		while #list > (compact() and 2 or 4) do
			table.remove(list, 1)
		end
		toasts(list)
	end

	function api.big(text: string, seconds: number?)
		big({ text = text, started = now(), untilT = now() + (seconds or 2.5) })
	end

	function api.open(name: string)
		panel(name)
	end

	function api.close()
		panel(nil)
	end

	function api.setData(view)
		local first = data() == nil
		data(view)
		if first and view.dailyReady then
			api.toast("🎁 Тебя ждёт подарок! Нажми «Подарок»")
		end
	end

	function api.setViewport(w: number, h: number)
		viewport({ w = w, h = h })
	end

	function api.setInput(kind: string)
		input(kind)
	end

	function api.setTenFoot(on: boolean)
		tenFoot(on)
	end

	function api.setHud(h)
		hud(h)
	end

	function api.setDino(on: boolean)
		isDino(on)
	end

	function api.dinoAction(action: string)
		if not isDino() or now() < cooldowns()[action] then
			return
		end
		local res = ask(action)
		local cd = table.clone(cooldowns())
		if res.ok then
			cd[action] = now() + (res.cooldown or 5)
		elseif res.wait then
			cd[action] = now() + res.wait
		end
		cooldowns(cd)
	end

	function api.hatch(eggKind: string)
		if hatching() then
			return
		end
		local res = ask("hatch", eggKind)
		if not res.ok then
			api.toast(res.msg or "Не получилось")
			return
		end
		hatching({ egg = eggKind, pet = res.pet, started = now(), cracks = 0 })
	end

	function api.spin()
		local s = spin()
		local d = data()
		if (s and not s.done) or not (d and d.wheelReady) then
			return
		end
		local res = ask("spin")
		if not res.ok then
			api.toast(res.msg or "Не получилось")
			return
		end
		spin({ index = res.index, final = Logic.wheelFinal(res.index, #Config.WHEEL), started = now(), msg = res.msg })
	end

	-- время идёт: убираем старые сообщения, двигаем вылупление и колесо
	function api.tick(t: number)
		now(t)
		local list = toasts()
		if #list > 0 and list[1].untilT < t then
			local keep = {}
			for _, item in ipairs(list) do
				if item.untilT >= t then
					table.insert(keep, item)
				end
			end
			toasts(keep)
		end
		local b = big()
		if b and t > b.untilT then
			big(nil)
		end
		local h = hatching()
		if h then
			local age = t - h.started
			local cracks = age >= 1.2 and 2 or (age >= 0.6 and 1 or 0)
			for _ = h.cracks + 1, cracks do
				sound("crack") -- даже если кадр подвис, каждая трещина звучит
			end
			h.cracks = math.max(h.cracks, cracks)
			if age >= 1.5 and not h.revealed then
				h.revealed = true
				sound("win")
				speak("Ура! Новый питомец!")
			end
		end
		local s = spin()
		if s and not s.done and t - s.started >= 4 then
			local done = table.clone(s)
			done.done = true
			spin(done)
			sound("win")
			api.big("🎡 " .. s.msg, 3)
		end
	end

	-- ---------- окна ----------

	local Panels = {}

	function Panels.pets()
		local eggRows = derive(function()
			return Logic.eggRows(data(), Config)
		end)
		local petRows = derive(function()
			return Logic.petRows(data(), Config)
		end)
		return Column {
			Heading "Яйца",
			indexes(eggRows, function(row)
				return Row(52, {
					Label { Size = UDim2.new(0, 40, 0, 40), Text = function()
						return row().icon
					end },
					Label { Size = UDim2.new(1, -220, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, Text = function()
						return row().text
					end },
					Button {
						Size = UDim2.new(0, 150, 0, 40),
						Text = "Вылупить",
						BackgroundColor3 = function()
							return row().canHatch and C.green or C.grey
						end,
						onClick = function()
							if row().canHatch then
								api.hatch(row().kind)
							else
								api.toast("Унеси яйцо с поля или купи в магазине 🛒")
							end
						end,
					},
				})
			end),
			Note "Яйца приносишь с поля 🥚 или покупаешь в магазине 🛒",
			Heading(function()
				return "Мои питомцы (" .. #data().pets .. "/" .. Config.MAX_PETS .. ")"
			end),
			show(function()
				return #data().pets == 0
			end, function()
				return Note "Пока никого нет. Вылупи яйцо!"
			end),
			indexes(petRows, function(row)
				local sure = source(false)
				return Row(60, {
					create "Frame" {
						Size = UDim2.new(0, 44, 0, 44),
						BackgroundColor3 = function()
							return PET_COLORS[row().kind]
						end,
						Corner(UDim.new(1, 0)),
						Label { Size = UDim2.fromScale(1, 1), Text = "🦖" },
					},
					create "Frame" {
						Size = UDim2.new(1, -330, 1, -8),
						BackgroundTransparency = 1,
						Label { Size = UDim2.new(1, 0, 0.55, 0), TextXAlignment = Enum.TextXAlignment.Left, Text = function()
							return row().name
						end },
						Label {
							Position = UDim2.fromScale(0, 0.55),
							Size = UDim2.new(1, 0, 0.45, 0),
							TextXAlignment = Enum.TextXAlignment.Left,
							Text = function()
								return row().info
							end,
							TextColor3 = function()
								return Config.RARITY_COLORS[row().rarity]
							end,
						},
					},
					Button {
						Size = UDim2.new(0, 120, 0, 42),
						Text = function()
							return row().worn and "Снять" or "Взять"
						end,
						BackgroundColor3 = function()
							return row().worn and C.blue or C.gold
						end,
						TextColor3 = function()
							return row().worn and C.cream or C.ink
						end,
						onClick = function()
							ask("equipPet", row().id)
						end,
					},
					Button {
						Size = UDim2.new(0, 120, 0, 42),
						Text = function()
							return sure() and "Точно? 🥺" or ("Отпустить +" .. row().release .. "🪙")
						end,
						BackgroundColor3 = function()
							return sure() and C.red or C.paper
						end,
						onClick = function()
							if not sure() then
								sure(true)
								delay(3, function()
									sure(false)
								end)
								return
							end
							local res = ask("releasePet", row().id)
							if res.msg then
								api.toast(res.msg)
							end
						end,
					},
				})
			end),
		}
	end

	function Panels.shop()
		local rows = derive(function()
			return Logic.shopRows(data(), Config)
		end)
		local colors = { wearing = C.blue, owned = C.green, price = C.gold }
		return Column {
			Note "Монетки дают за яйца, победы, спасение друзей и обби",
			indexes(rows, function(row)
				return Row(56, {
					Label { Size = UDim2.new(0, 42, 0, 42), Text = function()
						return row().icon
					end },
					Label { Size = UDim2.new(1, -230, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, Text = function()
						return row().name
					end },
					Button {
						Size = UDim2.new(0, 160, 0, 42),
						Text = function()
							return row().button
						end,
						BackgroundColor3 = function()
							return colors[row().state]
						end,
						TextColor3 = function()
							return row().state == "wearing" and C.cream or C.ink
						end,
						onClick = function()
							local res = ask(row().action, row().id)
							if res.msg then
								api.toast(res.msg)
							end
						end,
					},
				})
			end),
		}
	end

	function Panels.daily()
		local boxes = derive(function()
			return Logic.dailyBoxes(data(), Config)
		end)
		local colors = { today = C.gold, claimed = C.green, later = C.paper }
		return Column {
			Note "Заходи каждый день подряд: подарок становится больше!",
			Grid(UDim2.new(0, 74, 0, 82), {
				indexes(boxes, function(box)
					return create "Frame" {
						BackgroundColor3 = function()
							return colors[box().state]
						end,
						Corner(),
						Label { Size = UDim2.new(1, 0, 0.3, 0), Text = function()
							return "День " .. box().day
						end },
						Label { Position = UDim2.fromScale(0, 0.3), Size = UDim2.new(1, 0, 0.4, 0), Text = function()
							return box().icon
						end },
						Label { Position = UDim2.fromScale(0, 0.7), Size = UDim2.new(1, 0, 0.3, 0), Text = function()
							return tostring(box().coins)
						end },
					}
				end),
			}),
			show(function()
				return data().dailyReady
			end, function()
				return Button {
					Size = UDim2.new(1, -16, 0, 52),
					Text = "Открыть подарок 🎁",
					onClick = function()
						local res = ask("daily")
						if res.ok then
							api.big("🎁 " .. res.msg, 3)
							sound("win")
						elseif res.msg then
							api.toast(res.msg)
						end
					end,
				}
			end, function()
				return Note(function()
					return "Следующий подарок через " .. Logic.formatWait(data().dailyWait)
				end)
			end),
		}
	end

	function Panels.wheel()
		local n = #Config.WHEEL
		local colors = { C.gold, C.blue, C.green, C.red, C.purple, C.gold, C.blue, C.green }
		local angle = derive(function()
			local s = spin()
			if not s then
				return 0
			end
			return Logic.wheelAngle(s.final, (now() - s.started) / 4)
		end)
		local chips = {}
		for i, seg in ipairs(Config.WHEEL) do
			table.insert(chips, create "Frame" {
				Name = "Chip" .. i,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.new(0, 66, 0, 66),
				BackgroundColor3 = colors[(i - 1) % #colors + 1],
				Position = function()
					local x, y = Logic.wheelChip(i, n, angle())
					return UDim2.fromScale(x, y)
				end,
				Corner(UDim.new(1, 0)),
				Stroke(2),
				Label { Size = UDim2.new(1, 0, 0.55, 0), Text = seg.icon },
				Label { Position = UDim2.fromScale(0.1, 0.55), Size = UDim2.new(0.8, 0, 0.32, 0), Text = seg.label, TextColor3 = C.cream },
			})
		end
		return Column {
			Note "Крути раз в день!",
			create "Frame" {
				Size = UDim2.new(1, 0, 0, 280),
				BackgroundTransparency = 1,
				Label { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0, 40, 0, 34), Text = "🔻", ZIndex = 3 },
				create "Frame"(merge({
					Name = "Wheel",
					AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.new(0.5, 0, 0, 24),
					Size = UDim2.new(0, 250, 0, 250),
					BackgroundColor3 = C.paper,
					Corner(UDim.new(1, 0)),
					Stroke(4),
				}, chips)),
			},
			Button {
				Size = UDim2.new(1, -16, 0, 52),
				Text = function()
					local s = spin()
					if s and not s.done then
						return "Крутится… 🎡"
					end
					return data().wheelReady and "Крутить! 🎡" or ("Приходи через " .. Logic.formatWait(data().wheelWait))
				end,
				BackgroundColor3 = function()
					return data().wheelReady and C.gold or C.grey
				end,
				onClick = api.spin,
			},
		}
	end

	function Panels.badges()
		local rows = derive(function()
			local out = {}
			for _, b in ipairs(Config.BADGES) do
				table.insert(out, { icon = b.icon, name = b.name, text = b.text, has = data().badges[b.id] == true })
			end
			return out
		end)
		return Grid(UDim2.new(0, 120, 0, 112), {
			indexes(rows, function(b)
				return create "Frame" {
					BackgroundColor3 = function()
						return b().has and C.gold or C.paper
					end,
					Corner(),
					Label { Size = UDim2.new(1, 0, 0.45, 0), Text = function()
						return b().has and b().icon or "🔒"
					end },
					Label { Position = UDim2.new(0.05, 0, 0.45, 0), Size = UDim2.new(0.9, 0, 0.22, 0), Text = function()
						return b().name
					end },
					Label { Position = UDim2.new(0.05, 0, 0.68, 0), Size = UDim2.new(0.9, 0, 0.28, 0), TextColor3 = C.muted, Text = function()
						return b().text
					end },
				}
			end),
		})
	end

	function Panels.codes()
		local box = create "TextBox" {
			Name = "CodeBox",
			Size = UDim2.new(1, -170, 0, 44),
			BackgroundColor3 = C.cream,
			Font = FONT,
			TextScaled = true,
			TextColor3 = C.ink,
			PlaceholderText = "Код",
			Text = codeText(),
			ClearTextOnFocus = false,
			changed("Text", codeText),
			Corner(),
			Stroke(2),
		}
		return Column {
			Note "Знаешь секретное слово? Напиши его здесь!",
			Row(60, {
				box,
				Button {
					Size = UDim2.new(0, 150, 0, 44),
					BackgroundColor3 = C.green,
					Text = "Проверить",
					onClick = function()
						local res = ask("code", codeText())
						if res.ok then
							api.big("🔑 " .. res.msg, 3)
							box.Text = ""
						elseif res.msg then
							api.toast(res.msg)
						end
					end,
				},
			}),
		}
	end

	function Panels.emotes()
		local buttons = {}
		for _, e in ipairs(Config.EMOTES) do
			table.insert(buttons, Button {
				BackgroundColor3 = C.paper,
				Text = e.icon .. "\n" .. e.name,
				onClick = function()
					api.close()
					emote(e)
				end,
			})
		end
		return Grid(UDim2.new(0, 120, 0, 120), buttons)
	end

	-- ---------- части экрана ----------

	local function Hud()
		local function chip(name, width, bg, fg, text)
			return Label {
				Name = name,
				Size = UDim2.new(width, -6, 1, -8),
				BackgroundColor3 = bg or C.cream,
				BackgroundTransparency = bg and 0 or 1,
				TextColor3 = fg,
				Text = text,
				Corner(UDim.new(1, 0)),
			}
		end
		return {
			create "Frame" {
				Name = "Hud",
				AnchorPoint = Vector2.new(0.5, 0),
				Position = function()
					return UDim2.new(0.5, 0, 0, compact() and 2 or 6)
				end,
				Size = function()
					return compact() and UDim2.new(0.55, 0, 0, 30) or UDim2.new(0.7, 0, 0, 46 * k())
				end,
				BackgroundColor3 = C.cream,
				Corner(),
				Stroke(),
				create "UISizeConstraint" {
					MaxSize = function()
						return Vector2.new(560 * k(), 46 * k())
					end,
					MinSize = Vector2.new(260, 0),
				},
				create "UIListLayout" {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					Padding = UDim.new(0, 6),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				chip("Humans", 0.28, C.blue, C.cream, function()
					return "👫 Люди " .. hud().humans
				end),
				chip("Time", 0.18, nil, C.ink, function()
					local h = hud()
					return h.timeLeft >= 0 and Logic.formatTime(h.timeLeft) or "⏳"
				end),
				chip("Dinos", 0.28, C.red, C.cream, function()
					return "🦖 Дино " .. hud().dinos
				end),
				chip("Coins", 0.22, C.gold, C.ink, function()
					local d = data()
					return "🪙 " .. (d and d.coins or 0)
				end),
			},
			Label {
				Name = "Status",
				AnchorPoint = Vector2.new(0.5, 0),
				Position = function()
					return UDim2.new(0.5, 0, 0, compact() and 34 or (10 + 46 * k()))
				end,
				Size = function()
					return compact() and UDim2.new(0.45, 0, 0, 14) or UDim2.new(0.6, 0, 0, 24 * k())
				end,
				TextColor3 = C.cream,
				TextStrokeTransparency = 0,
				Text = function()
					return Logic.statusLine(hud())
				end,
			},
			show(isDino, function()
				return Label {
					Name = "DinoBanner",
					AnchorPoint = Vector2.new(0.5, 0),
					Position = function()
						return UDim2.new(0.5, 0, 0, compact() and 50 or (14 + 70 * k()))
					end,
					Size = function()
						return compact() and UDim2.new(0.3, 0, 0, 18) or UDim2.new(0.5, 0, 0, 30 * k())
					end,
					BackgroundColor3 = C.red,
					BackgroundTransparency = 0,
					TextColor3 = C.cream,
					Text = "🦖 Ты динозавр! Лови людей!",
					Corner(UDim.new(1, 0)),
				}
			end),
		}
	end

	local function BigText()
		return show(big, function()
			return Label {
				Name = "Big",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0.3, 0),
				Size = function()
					return compact() and UDim2.new(0.6, 0, 0, 40) or UDim2.new(0.8, 0, 0, 64 * k())
				end,
				TextColor3 = C.cream,
				TextStrokeTransparency = 0,
				ZIndex = 5,
				Text = function()
					local b = big()
					return b and b.text or ""
				end,
				create "UIScale" {
					Scale = function()
						local b = big()
						return b and math.max(0.05, popOut((now() - b.started) / 0.35)) or 1
					end,
				},
			}
		end)
	end

	local function Toasts()
		return create "Frame" {
			Name = "Toasts",
			-- на телефоне внизу джойстик и прыжок, поэтому сообщения наверху, под табло
			AnchorPoint = function()
				return compact() and Vector2.new(0.5, 0) or Vector2.new(0.5, 1)
			end,
			Position = function()
				if compact() then
					return UDim2.new(0.5, 0, 0, 72)
				end
				-- на телевизоре край экрана бывает обрезан
				return tenFoot() and UDim2.new(0.5, 0, 0.94, 0) or UDim2.new(0.5, 0, 1, -16)
			end,
			Size = function()
				return compact() and UDim2.new(0.4, 0, 0, 54) or UDim2.new(0.7, 0, 0, 200)
			end,
			BackgroundTransparency = 1,
			ZIndex = 4,
			create "UIListLayout" {
				VerticalAlignment = function()
					return compact() and Enum.VerticalAlignment.Top or Enum.VerticalAlignment.Bottom
				end,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			indexes(toasts, function(item, i)
				return Label {
					Name = "Toast",
					LayoutOrder = i,
					Size = function()
						return UDim2.new(1, 0, 0, compact() and 24 or 34 * k())
					end,
					BackgroundColor3 = C.ink,
					BackgroundTransparency = 0.2,
					TextColor3 = C.cream,
					Text = function()
						return item().text
					end,
					Corner(),
					Pad(10, 4),
				}
			end),
		}
	end

	local function PanelWindow()
		return show(panel, function()
			local opened = source(0)
			local slide = spring(opened, 0.35, 0.6)
			opened(1)
			local frame = create "Frame" {
				Name = "Panel",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = C.ink,
				BackgroundTransparency = 0.45,
				ZIndex = 10,
				create "Frame" {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = function()
						return UDim2.fromScale(0.5, 0.62 - 0.12 * slide())
					end,
					Size = UDim2.fromScale(0.92, 0.86),
					BackgroundColor3 = C.cream,
					Corner(UDim.new(0, 18)),
					Stroke(4),
					create "UISizeConstraint" { MaxSize = Vector2.new(580, 440) },
					Label {
						Name = "PanelTitle",
						Position = UDim2.new(0, 16, 0, 10),
						Size = UDim2.new(1, -80, 0, 40),
						TextXAlignment = Enum.TextXAlignment.Left,
						Text = function()
							local name = panel()
							local d = data()
							if name == "badges" and d then
								return TITLES.badges .. " " .. Logic.badgeCount(d, Config) .. "/" .. #Config.BADGES
							end
							return name and TITLES[name] or ""
						end,
					},
					Button {
						Name = "Close",
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, -12, 0, 10),
						Size = UDim2.new(0, 44, 0, 44),
						BackgroundColor3 = C.red,
						TextColor3 = C.cream,
						Text = "✕",
						onClick = api.close,
					},
					create "ScrollingFrame" {
						Name = "Content",
						Position = UDim2.new(0, 12, 0, 58),
						Size = UDim2.new(1, -24, 1, -70),
						BackgroundTransparency = 1,
						CanvasSize = UDim2.new(),
						AutomaticCanvasSize = Enum.AutomaticSize.Y,
						ScrollBarThickness = 8,
						create "UIListLayout" { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder },
						show(data, function()
							return Column {
								switch(panel)(Panels),
								show(function()
									return not data().saving
								end, function()
									return Note "ℹ️ Прогресс сейчас не сохраняется (так бывает при тесте в Studio)"
								end),
							}
						end, function()
							return Note "Загрузка…"
						end),
					},
				},
			}
			-- на приставке связка сразу выделит кнопку в окне, чтобы выбирать геймпадом
			if deps.onPanelOpened then
				deps.onPanelOpened(frame)
			end
			return frame
		end)
	end

	local function HatchLayer()
		return show(hatching, function()
			local age = function()
				local h = hatching()
				return h and now() - h.started or 0
			end
			local function pet()
				local h = hatching()
				return Config.PETS[h and h.pet or "green"]
			end
			return create "Frame" {
				Name = "Hatch",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = C.ink,
				BackgroundTransparency = 0.25,
				ZIndex = 30,
				show(function()
					return age() < 1.5
				end, function()
					return Label {
						Name = "HatchEgg",
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromScale(0.5, 0.42),
						Size = UDim2.new(0, 180, 0, 180),
						Text = function()
							local h = hatching()
							return age() < 1.2 and Config.EGGS[h and h.egg or "normal"].icon or "💥"
						end,
						Rotation = function()
							local t = age()
							return t < 1.2 and math.sin(t * 45) * 18 * (1 - t / 1.2) or 0
						end,
					}
				end),
				show(function()
					return age() >= 1.5
				end, function()
					return create "Frame" {
						Name = "HatchCard",
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromScale(0.5, 0.5),
						Size = UDim2.new(0, 300, 0, 300),
						BackgroundColor3 = C.cream,
						Corner(UDim.new(0, 20)),
						Stroke(4),
						create "UIScale" {
							Scale = function()
								return math.max(0.05, popOut((age() - 1.5) / 0.4))
							end,
						},
						create "Frame" {
							AnchorPoint = Vector2.new(0.5, 0),
							Position = UDim2.new(0.5, 0, 0, 16),
							Size = UDim2.new(0, 110, 0, 110),
							BackgroundColor3 = function()
								local h = hatching()
								return PET_COLORS[h and h.pet or "green"]
							end,
							Corner(UDim.new(1, 0)),
							Label { Size = UDim2.fromScale(1, 1), Text = "🦖" },
						},
						Label { Name = "PetName", Position = UDim2.new(0, 10, 0, 134), Size = UDim2.new(1, -20, 0, 34), Text = function()
							return pet().name
						end },
						Label {
							Name = "PetRarity",
							Position = UDim2.new(0, 10, 0, 170),
							Size = UDim2.new(1, -20, 0, 26),
							Text = function()
								return pet().rarity
							end,
							TextColor3 = function()
								return Config.RARITY_COLORS[pet().rarity]
							end,
						},
						Label { Position = UDim2.new(0, 10, 0, 198), Size = UDim2.new(1, -20, 0, 22), TextColor3 = C.muted, Text = function()
							return pet().power
						end },
						Button {
							AnchorPoint = Vector2.new(0.5, 1),
							Position = UDim2.new(0.5, 0, 1, -14),
							Size = UDim2.new(0, 160, 0, 50),
							BackgroundColor3 = C.green,
							Text = "Ура!",
							onClick = function()
								hatching(nil)
							end,
						},
					}
				end),
			}
		end)
	end

	-- приставка: на экран не нажать, показываем, какую кнопку геймпада жать (значок PlayStation или Xbox)
	local function DinoHints()
		return show(function()
			return isDino() and input() == "gamepad"
		end, function()
			local function hint(action)
				local key = Logic.DINO_KEYS[action]
				return create "Frame" {
					Name = action,
					Size = UDim2.new(0, 130, 1, 0),
					BackgroundColor3 = C.ink,
					BackgroundTransparency = function()
						return now() < cooldowns()[action] and 0.6 or 0.25
					end,
					Corner(UDim.new(1, 0)),
					create "UIListLayout" {
						FillDirection = Enum.FillDirection.Horizontal,
						VerticalAlignment = Enum.VerticalAlignment.Center,
						Padding = UDim.new(0, 6),
					},
					Pad(6, 4),
					create "ImageLabel" {
						Size = UDim2.new(0, 40, 0, 40),
						BackgroundTransparency = 1,
						Image = glyph(key.gamepad),
					},
					Label {
						Size = UDim2.new(1, -46, 0.7, 0),
						TextColor3 = C.cream,
						Text = function()
							local left = cooldowns()[action] - now()
							return left > 0 and tostring(math.ceil(left)) or key.name
						end,
					},
				}
			end
			return create "Frame" {
				Name = "DinoHints",
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.fromScale(0.93, 0.93),
				Size = function()
					return UDim2.new(0, 270 * k(), 0, 52 * k())
				end,
				BackgroundTransparency = 1,
				create "UIListLayout" {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Right,
					Padding = UDim.new(0, 10),
				},
				hint("roar"),
				hint("dash"),
			}
		end)
	end

	local function DinoPad()
		return show(function()
			return isDino() and input() ~= "gamepad"
		end, function()
			local function dinoButton(action, icon, color)
				return Button {
					Name = action,
					Size = function()
						local px = compact() and 62 or 100
						return UDim2.new(0, px, 0, px)
					end,
					BackgroundColor3 = color,
					BackgroundTransparency = function()
						return now() < cooldowns()[action] and 0.4 or 0
					end,
					Text = "",
					round = true,
					onClick = function()
						api.dinoAction(action)
					end,
					Label { Size = UDim2.new(1, 0, 0.6, 0), Text = icon },
					Label {
						Position = UDim2.fromScale(0, 0.6),
						Size = UDim2.new(1, 0, 0.3, 0),
						TextColor3 = C.cream,
						TextStrokeTransparency = 0.3,
						Text = function()
							local left = cooldowns()[action] - now()
							return left > 0 and tostring(math.ceil(left)) or Logic.actionCaption(action, input())
						end,
					},
				}
			end
			return create "Frame" {
				Name = "DinoPad",
				AnchorPoint = Vector2.new(1, 1),
				-- на телефоне — левее кнопки прыжка Roblox, а не над ней
				Position = function()
					return compact() and UDim2.new(1, -150, 1, -12) or UDim2.new(1, -16, 1, -190)
				end,
				Size = function()
					return compact() and UDim2.new(0, 136, 0, 62) or UDim2.new(0, 230, 0, 100)
				end,
				BackgroundTransparency = 1,
				create "UIListLayout" {
					FillDirection = Enum.FillDirection.Horizontal,
					Padding = UDim.new(0, 12),
					HorizontalAlignment = Enum.HorizontalAlignment.Right,
				},
				dinoButton("roar", "🦖", C.red),
				dinoButton("dash", "💨", C.blue),
			}
		end)
	end

	local destroy, gui = root(function()
		return create "ScreenGui" {
			Name = "DinoUI",
			ResetOnSpawn = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			Hud(),
			Toasts(),
			BigText(),
			DinoPad(),
			DinoHints(),
			PanelWindow(),
			HatchLayer(),
		}
	end)

	api.gui = gui
	api.destroy = destroy
	api.state = { data = data, panel = panel, hatching = hatching, spin = spin, isDino = isDino, now = now }
	return api
end

return App
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Logic</string>
              <string name="Source"><![CDATA[-- Правила экрана без самого экрана: что показать в магазине, питомцах, подарках, колесе.
-- Чистые функции — их проверяют юнит-тесты (tests/roblox/run.luau).
local Logic = {}

function Logic.formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Logic.formatWait(seconds: number): string
	local h = math.floor(seconds / 3600)
	local m = math.floor(seconds % 3600 / 60)
	if h > 0 then
		return h .. " ч " .. m .. " мин"
	end
	return m .. " мин"
end

-- строка над табло: карта, кто динозавр, Ти-Рекс; между таймами — отсчёт
function Logic.statusLine(hud): string
	if hud.timeLeft < 0 then
		return hud.status or ""
	end
	local line = "🗺 " .. (hud.map or "")
	if hud.dinoPlayer and hud.dinoPlayer ~= "" then
		line ..= "   🦖 " .. hud.dinoPlayer
	end
	if hud.boss then
		line ..= "   ⚠️ Ти-Рекс!"
	end
	return line
end

-- яйца в рюкзаке
function Logic.eggRows(data, Config)
	local rows = {}
	for _, kind in ipairs(Config.EGG_ORDER) do
		local egg = Config.EGGS[kind]
		local count = data.eggs[kind] or 0
		table.insert(rows, { kind = kind, icon = egg.icon, text = egg.name .. "  ×" .. count, canHatch = count > 0 })
	end
	return rows
end

-- питомцы: сначала самые редкие, надетый подсвечен
function Logic.petRows(data, Config)
	local rank = {}
	for i, k in ipairs(Config.PET_ORDER) do
		rank[k] = i
	end
	local list = table.clone(data.pets)
	table.sort(list, function(a, b)
		if rank[a.kind] ~= rank[b.kind] then
			return rank[a.kind] < rank[b.kind]
		end
		return a.id < b.id
	end)
	local rows = {}
	for _, pet in ipairs(list) do
		local def = Config.PETS[pet.kind]
		table.insert(rows, {
			id = pet.id,
			kind = pet.kind,
			name = def.name,
			info = def.rarity .. " · " .. def.power,
			rarity = def.rarity,
			worn = data.equippedPet == pet.id,
			release = def.release,
		})
	end
	return rows
end

-- магазин: что на кнопке и что она делает
function Logic.shopRows(data, Config)
	local rows = {}
	for _, item in ipairs(Config.SHOP) do
		if not item.event or item.event == data.event then
			local owned = item.slot ~= "egg" and data.owned[item.id] == true
			local wearing = owned and data.equipped[item.slot] == item.id
			table.insert(rows, {
				id = item.id,
				icon = item.icon,
				name = item.name .. (item.event and " (праздник!)" or ""),
				action = owned and "equip" or "buy",
				button = owned and (wearing and "Снять" or "Надеть") or ("🪙 " .. item.price),
				state = wearing and "wearing" or (owned and "owned" or "price"),
			})
		end
	end
	return rows
end

-- 7 коробок подарков: забрано / сегодня / потом
function Logic.dailyBoxes(data, Config)
	local boxes = {}
	for day, coins in ipairs(Config.DAILY) do
		local claimed = day < data.dailyDay or (day == data.dailyDay and not data.dailyReady)
		local today = day == data.dailyDay and data.dailyReady
		table.insert(boxes, {
			day = day,
			coins = coins,
			state = today and "today" or (claimed and "claimed" or "later"),
			icon = claimed and "✔" or (day == 7 and "🥚🪙" or "🪙"),
		})
	end
	return boxes
end

-- колесо: на сколько повернуть, чтобы сектор index оказался под стрелкой (5 полных оборотов)
function Logic.wheelFinal(index: number, count: number): number
	return 360 * 5 - (index - 1) * (360 / count)
end

-- плавное замедление колеса: t от 0 до 1
function Logic.wheelAngle(final: number, t: number): number
	t = math.clamp(t, 0, 1)
	return final * (1 - (1 - t) ^ 3)
end

-- положение фишки колеса (доли от размера колеса)
function Logic.wheelChip(i: number, count: number, angle: number): (number, number)
	local a = math.rad((i - 1) * (360 / count) + angle)
	return 0.5 + 0.36 * math.sin(a), 0.5 - 0.36 * math.cos(a)
end

function Logic.badgeCount(data, Config): number
	local got = 0
	for _, b in ipairs(Config.BADGES) do
		if data.badges[b.id] then
			got += 1
		end
	end
	return got
end

-- красные точки на кнопках: есть подарок, можно крутить, есть яйца
function Logic.dots(data)
	local eggs = 0
	for _, n in pairs(data.eggs) do
		eggs += n
	end
	return { daily = data.dailyReady == true, wheel = data.wheelReady == true, pets = eggs > 0 }
end

-- на чём играют: "touch" (телефон, планшет), "gamepad" (PlayStation, Xbox), "keyboard" (компьютер).
-- lastInputType — имя Enum.UserInputType (UserInputService:GetLastInputType().Name)
function Logic.inputKind(lastInputType: string): string
	if lastInputType == "Touch" then
		return "touch"
	elseif string.sub(lastInputType, 1, 7) == "Gamepad" then
		return "gamepad"
	end
	return "keyboard"
end

-- кнопки динозавра на клавиатуре и геймпаде (на PlayStation ButtonY — △, ButtonR1 — R1)
Logic.DINO_KEYS = {
	roar = { keyboard = "Q", gamepad = "ButtonY", name = "РЫК" },
	dash = { keyboard = "F", gamepad = "ButtonR1", name = "РЫВОК" },
}

-- подпись на кнопке: клавишу показываем только тем, у кого есть клавиатура
function Logic.actionCaption(action: string, input: string): string
	local key = Logic.DINO_KEYS[action]
	if input == "keyboard" then
		return key.name .. " (" .. key.keyboard .. ")"
	end
	return key.name
end

return Logic
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="78">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
    <Item class="Terrain" referent="79">
      <Properties>
        <string name="Name">Terrain</string>
        <bool name="Decoration">true</bool>
      </Properties>
    </Item>
  </Item>
