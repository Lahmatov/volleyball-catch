	clearNotices: typeof(
		--[[
			
		]]
		function(self: Icon): Icon
			return nil :: any
		end
	),
	disableOverlay: typeof(
		--[[
			When set to &lt;code>true&lt;/code>, disables the shade effect which appears when the icon is pressed and released.
